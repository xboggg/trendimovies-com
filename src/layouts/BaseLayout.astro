---
import '../styles/global.css';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'video.movie' | 'video.tv_show';
  noIndex?: boolean;
}

const {
  title,
  description = 'Stream and download movies & TV series for free. High quality 720p and 1080p downloads available.',
  image = '/images/og-default.jpg',
  type = 'website',
  noIndex = false
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://trendimovies.com');
// og:url should reflect query string so cache-bust params (?v=N) actually work as a cache bust
const ogUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.site || 'https://trendimovies.com');
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <title>{title} | TrendiMovies</title>

  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />

  <meta name="theme-color" content="#e50914" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="TrendiMovies" />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image.startsWith("http") ? image : `https://trendimovies.com${image}`} />
  <meta property="og:image:secure_url" content={image.startsWith("http") ? image : `https://trendimovies.com${image}`} />
  <meta property="og:image:type" content={(image.includes(".png") && !image.includes("type=digital") && !image.includes("type=list") && !image.includes("type=review")) ? "image/png" : "image/jpeg"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content="TrendiMovies" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image.startsWith("http") ? image : `https://trendimovies.com${image}`} />

  <!-- Preconnect to external resources -->
  <link rel="preconnect" href="https://image.tmdb.org" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Theme script (prevent flash) -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else if (theme === 'dark' || !theme) {
        document.documentElement.classList.add('dark');
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

  <style is:inline>
    /* Background image with dark overlay */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/images/bg-cinema.webp');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      z-index: -2;
    }
    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.88) 50%, rgba(0,0,0,0.93) 100%);
      z-index: -1;
    }

    /* Compact, non-intrusive floating install card (bottom-right on desktop,
       a slim floating card with margins on mobile — never a full-width bar,
       so it doesn't cover the hero or the gold accent line). */
    #pwa-install-banner {
      position: fixed;
      bottom: 16px;
      right: 16px;
      left: auto;
      width: 320px;
      max-width: calc(100vw - 32px);
      background: rgba(20, 20, 22, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 9999;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
      gap: 10px;
      animation: pwa-slide-in 0.4s ease-out;
    }
    @keyframes pwa-slide-in {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    #pwa-install-banner .pwa-info {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 0;
    }
    #pwa-install-banner img {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      flex-shrink: 0;
    }
    #pwa-install-banner .pwa-text {
      min-width: 0;
    }
    #pwa-install-banner .pwa-title {
      font-weight: 700;
      color: white;
      font-size: 13px;
    }
    #pwa-install-banner .pwa-desc {
      font-size: 11px;
      color: rgba(255,255,255,0.65);
    }
    #pwa-install-banner .pwa-buttons {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }
    #pwa-install-banner .btn-install {
      padding: 7px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      border: none;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #000;
      font-weight: 700;
    }
    /* Dismiss is a small unobtrusive × */
    #pwa-install-banner .btn-later {
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border-radius: 50%;
      cursor: pointer;
      font-size: 16px;
      line-height: 1;
      background: rgba(255,255,255,0.08);
      border: none;
      color: rgba(255,255,255,0.7);
    }
    #pwa-install-banner .btn-later:hover {
      background: rgba(255,255,255,0.18);
      color: #fff;
    }
    @media (max-width: 480px) {
      #pwa-install-banner {
        left: 12px;
        right: 12px;
        width: auto;
        max-width: none;
        bottom: 12px;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <Header client:load pathname={Astro.url.pathname} />

  <main class="flex-1">
    <slot />
  </main>

  <Footer />

  <!-- Back to top — appears after scrolling down; works on every page (series, movies, genres, etc.) -->
  <button id="back-to-top" aria-label="Back to top" title="Back to top">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
  </button>
  <style>
    #back-to-top {
      position: fixed;
      right: 18px;
      bottom: 84px; /* sits above the mobile bottom-nav / player bars */
      z-index: 60;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      border: 1px solid var(--border, #2a2a2a);
      background: var(--accent, #e50914);
      color: #fff;
      box-shadow: 0 6px 20px rgba(0,0,0,0.35);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition: opacity .25s ease, transform .25s ease, visibility .25s;
    }
    #back-to-top.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    #back-to-top:hover { filter: brightness(1.1); }
    #back-to-top:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    @media (min-width: 768px) {
      #back-to-top { right: 28px; bottom: 28px; width: 48px; height: 48px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #back-to-top { transition: opacity .2s ease, visibility .2s; transform: none; }
      #back-to-top.show { transform: none; }
    }
  </style>
  <script is:inline>
    (function () {
      var btn = document.getElementById('back-to-top');
      if (!btn) return;
      var ticking = false;
      function update() {
        if ((window.scrollY || document.documentElement.scrollTop) > 500) btn.classList.add('show');
        else btn.classList.remove('show');
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      btn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
      update();
    })();
  </script>

  <!-- Analytics Tracking -->
  <script is:inline>
    (function() {
      var sessionId = sessionStorage.getItem('tm_session_id');
      if (!sessionId) {
        sessionId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
          var r = Math.random() * 16 | 0;
          return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
        sessionStorage.setItem('tm_session_id', sessionId);
      }

      var path = window.location.pathname;
      if (path.startsWith('/admin') || path.startsWith('/api/')) {
        return;
      }

      var payload = JSON.stringify({
        page_path: path,
        referrer: document.referrer || '',
        session_id: sessionId
      });

      // sendBeacon (not fetch): a plain fetch gets aborted mid-request when
      // the user navigates away right after firing it -- common on a
      // browse-heavy site -- and the aborted body was surfacing as
      // "Response body object should not be disturbed or locked" errors
      // server-side. sendBeacon survives page unload. Fixed 2026-09-02.
      // IMPORTANT: pass the payload as a plain string, not a Blob -- a
      // Blob body was confirmed (via server-side diagnostic logging) to
      // arrive as Content-Length: 0 on ordinary desktop Chrome, a known
      // sendBeacon+Blob reliability quirk. A string payload is the
      // well-tested reliable form. Fixed 2026-09-02.
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/analytics/track', payload);
      } else {
        fetch('/api/analytics/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true
        }).catch(function() {});
      }
    })();
  </script>

  <!-- PWA Install Prompt & Service Worker -->
  <script is:inline>
    var deferredPrompt = null;

    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      deferredPrompt = e;
      setTimeout(function() {
        if (deferredPrompt && !localStorage.getItem('pwa-dismissed')) {
          showInstallBanner();
        }
      }, 3000);
    });

    function showInstallBanner() {
      if (document.getElementById('pwa-install-banner')) return;
      var banner = document.createElement('div');
      banner.id = 'pwa-install-banner';
      banner.innerHTML = '<div class="pwa-info"><img src="/icons/icon-72x72.png" alt="TrendiMovies"><div class="pwa-text"><div class="pwa-title">Install TrendiMovies</div><div class="pwa-desc">Quick access from your home screen</div></div></div><div class="pwa-buttons"><button class="btn-install" onclick="installPWA()">Install</button><button class="btn-later" onclick="dismissInstall()" aria-label="Dismiss">&times;</button></div>';
      document.body.appendChild(banner);
    }

    window.installPWA = function() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(function(result) {
          deferredPrompt = null;
          var el = document.getElementById('pwa-install-banner');
          if (el) el.remove();
        });
      }
    };

    window.dismissInstall = function() {
      localStorage.setItem('pwa-dismissed', 'true');
      var el = document.getElementById('pwa-install-banner');
      if (el) el.remove();
    };

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').then(function(reg) {
          // Always check for an updated service worker on load.
          reg.update();
        }).catch(function() {});
      });
      // When a new service worker takes control, reload once so the fresh
      // CSS/JS is applied immediately (prevents stale styles sticking around).
      var swReloaded = false;
      navigator.serviceWorker.addEventListener('controllerchange', function() {
        if (swReloaded) return;
        swReloaded = true;
        window.location.reload();
      });
    }
  </script>

  <!-- "Jump Back In" is now recorded by the VideoPlayer component on mount
       (real intent to watch + captures episode), not on every detail-page visit. -->

  <!-- Adsterra Social Bar -- skipped on /admin and /api so ads never show in the
       admin panel or leak into API responses. -->
  {!Astro.url.pathname.startsWith('/admin') && !Astro.url.pathname.startsWith('/api') && (
    <script is:inline src="https://pl21735685.effectivecpmnetwork.com/52/ac/e9/52ace93d1cfd04911005b777950ab266.js"></script>
  )}

</body>
</html>
