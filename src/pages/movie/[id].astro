---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieJsonLd from '../../components/MovieJsonLd.astro';
import Ratings from '../../components/Ratings.svelte';
import StreamSheet from '../../components/StreamSheet.svelte';
import TrailerSheet from '../../components/TrailerSheet.svelte';
import { lookupSpecs } from '../../lib/file-specs';
import DownloadSheet from '../../components/DownloadSheet.svelte';
import Comments from '../../components/Comments.svelte';
import ContentRow from '../../components/ContentRow.svelte';
import MovieActions from '../../components/MovieActions.svelte';
import { getMovieDetails, transformMovieData } from '../../lib/tmdb';
import { supabase } from '../../lib/supabase';
import { Star, Clock, Calendar, Globe, Play } from 'lucide-svelte';

const { id } = Astro.params;
let tmdbId = parseInt(id || '0');

if (!tmdbId) {
  // Not a numeric TMDB id -- likely someone shared/typed the slug URL
  // (e.g. /movie/savage-house-2026-1245859) instead of the canonical
  // /movie/{tmdb_id} one. Movie pages are id-only, unlike reviews/blog
  // which ARE slug-based, so this mix-up is an easy mistake. Resolve the
  // slug and redirect to the canonical id URL instead of 404ing -- a 404
  // has no OG tags, which is why WhatsApp/social previews silently failed
  // for links shared this way. Fixed 2026-09-02.
  const { data: bySlug } = await supabase
    .from('movies')
    .select('tmdb_id')
    .eq('slug', id)
    .single();
  if (bySlug?.tmdb_id) {
    return Astro.redirect(`/movie/${bySlug.tmdb_id}`, 301);
  }
  return Astro.redirect('/404');
}

// Fetch movie from TMDB
const tmdbData = await getMovieDetails(tmdbId);

// ADDITIVE FALLBACK (2026-07-18): some films aren't on TMDB at all (regional
// titles like Kamal Sridevi). Previously those 404'd. When TMDB has nothing,
// build the movie object from OUR DB row instead so it still renders. This code
// path ONLY runs when tmdbData is null — every TMDB-backed movie is unchanged.
let movie: any;
if (tmdbData) {
  movie = transformMovieData(tmdbData);
} else {
  const { data: dbOnly } = await supabase
    .from('movies')
    .select('tmdb_id, title, slug, overview, year, release_date, runtime, poster_path, backdrop_path, vote_average, original_language')
    .eq('tmdb_id', tmdbId)
    .single();
  if (!dbOnly) {
    return Astro.redirect('/404');
  }
  movie = {
    tmdb_id: dbOnly.tmdb_id,
    imdb_id: null,
    title: dbOnly.title,
    slug: dbOnly.slug,
    original_title: dbOnly.title,
    overview: dbOnly.overview || '',
    tagline: null,
    release_date: dbOnly.release_date || null,
    year: dbOnly.year || null,
    runtime: dbOnly.runtime || null,
    budget: null, revenue: null, popularity: 0,
    vote_average: dbOnly.vote_average || 0,
    vote_count: 0,
    poster_path: dbOnly.poster_path || null,
    backdrop_path: dbOnly.backdrop_path || null,
    trailer_key: null,
    original_language: dbOnly.original_language || 'en',
    spoken_languages: [], production_countries: [], production_companies: [],
    genres: [], cast_data: [], crew_data: [], keywords: [],
    watch_providers: {}, status: 'released',
  };
}

// Look up internal DB ID for this movie (cron stores content_id = movies.id, not tmdb_id)
const { data: dbMovie } = await supabase
  .from('movies')
  .select('id, title, original_title, poster_path, backdrop_path, year, release_date')
  .eq('tmdb_id', tmdbId)
  .single();

// TMDB has no English translation for some regional titles (returns the
// native-script title as-is, e.g. "冒牌监护人之寻宝闹翻天" for "Fake
// Guardians" 2017) -- no text-matching fix on the assign side can ever
// find these from an English release filename, since there's no English
// text to match against. Narrow, deliberate override: only when TMDB's
// title has ZERO Latin characters (genuinely untranslated) and our DB has
// an admin-set Latin title, prefer the DB one for display. Doesn't touch
// the vast majority of titles where DB and TMDB agree or DB is just a
// stale copy of an older TMDB title -- this only fires for the specific
// "TMDB never translated it" case. Fixed 2026-08-31.
const _tmdbTitleHasLatin = /[a-zA-Z]/.test(movie.title || '');
const _dbTitleHasLatin = /[a-zA-Z]/.test(dbMovie?.title || '');
if (!_tmdbTitleHasLatin && _dbTitleHasLatin && dbMovie?.title) {
  movie.original_title = movie.title;
  movie.title = dbMovie.title;
}

// Explicit admin override for the "Original title" display (added
// 2026-09-08). TMDB's own original_title is sometimes technically correct
// but awkward to show/search against -- e.g. "Sk+te'kmuje'katik" (special
// characters TMDB uses for an Indigenous-language title) vs the plainer
// "Sk.tekmujuekatik" that release filenames actually use. Only fires when
// an admin has explicitly set movies.original_title in our own DB; every
// other movie (the vast majority, where this column is null) is unchanged.
if (dbMovie?.original_title) {
  movie.original_title = dbMovie.original_title;
}

// Fallback: if TMDB has no poster/backdrop, use DB cached version
// Use DB poster if manually overridden (different from TMDB)
if (dbMovie?.poster_path && dbMovie.poster_path !== movie.poster_path) {
  movie.poster_path = dbMovie.poster_path;
} else if (!movie.poster_path && dbMovie?.poster_path) {
  movie.poster_path = dbMovie.poster_path;
}
if (!movie.backdrop_path && dbMovie?.backdrop_path) {
  movie.backdrop_path = dbMovie.backdrop_path;
}

// DB year/release_date override: TMDB sometimes has a wrong/early date (e.g. a
// festival premiere) while our DB holds the correct release year. If the DB year
// differs from TMDB's, trust the DB (it was set/corrected deliberately).
if (dbMovie?.year && dbMovie.year !== movie.year) {
  movie.year = dbMovie.year;
  if (dbMovie.release_date) movie.release_date = dbMovie.release_date;
}

const internalId = dbMovie?.id;

// Is there a published review for this movie? (drives the Read Review banner)
let movieReview = null;
try {
  const { data: rvRows } = await supabase
    .from('movie_reviews')
    .select('slug, headline, deck, accent, rt_score, box_office, verdict')
    .eq('tmdb_id', tmdbId)
    .eq('status', 'published')
    .limit(1);
  movieReview = (rvRows && rvRows.length) ? rvRows[0] : null;
} catch (e) { movieReview = null; }

// Is there a published blog post centered on this movie? (drives the Related Read banner)
let relatedPost = null;
try {
  const { data: blRows } = await supabase
    .from('blog_posts')
    .select('slug, title, deck, accent, tags')
    .eq('related_tmdb_id', tmdbId)
    .eq('related_type', 'movie')
    .eq('status', 'published')
    .limit(1);
  relatedPost = (blRows && blRows.length) ? blRows[0] : null;
} catch (e) { relatedPost = null; }

// Fetch download links using internal DB ID
const { data: rawLinks } = internalId ? await supabase
  .from('download_links')
  .select('*')
  .eq('content_type', 'movie')
  .eq('content_id', internalId)
  .eq('is_active', true) : { data: [] };

const downloadLinks = (rawLinks || []).map((link: any) => ({
  ...link,
  type: link.source === 'torrent' ? 'torrent' as const : 'ddl' as const,
  source: link.source === 'telegram' ? 1 : link.source === 'cinematika' ? 2 : undefined,
}));

// File details (WEBRip / BluRay, x265, audio ...) for the Download pop-up,
// read from the real file names. Fails quietly to "no details".
const _specIds = downloadLinks.map((l: any) => {
  const m = String(l.url || '').match(/\/tgstream\/stream\/(\d+)/);
  return m ? parseInt(m[1], 10) : 0;
});
const _specs = lookupSpecs(_specIds);
const downloadLinksWithSpecs = downloadLinks.map((l: any, i: number) => ({ ...l, spec: _specs.get(_specIds[i]) || null }));

// Fetch subtitle links
const { data: subtitleLinks } = internalId ? await supabase
  .from('subtitle_links')
  .select('id, file_name, file_size, telegram_file_id')
  .eq('content_type', 'movie')
  .eq('content_id', internalId)
  .eq('is_active', true) : { data: [] };

// Helper functions
function getPosterUrl(path: string | null): string {
  if (!path) return '/images/no-poster.svg';
    if (path.startsWith('/images/')) return path;
    return `https://image.tmdb.org/t/p/w500${path}`;
}

function getBackdropUrl(path: string | null): string {
  if (!path) return '/images/no-backdrop.svg';
  if (path.startsWith('/images/')) return path;
  return `https://image.tmdb.org/t/p/w1280${path}`;
}

function getProfileUrl(path: string | null): string {
  if (!path) return '/images/no-profile.svg';
  return `https://image.tmdb.org/t/p/w185${path}`;
}

function formatRuntime(minutes: number | null): string {
  if (!minutes) return 'N/A';
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatMoney(amount: number | null): string {
  if (!amount) return 'N/A';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(amount);
}

function formatShortMoney(amount: number | null): string {
  if (!amount) return '';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1 }).format(amount);
}

function shortParts(n: number): { v: string; s: string } {
  if (n >= 1e9) return { v: (n / 1e9).toFixed(1), s: 'B' };
  if (n >= 1e6) return { v: (n / 1e6).toFixed(1), s: 'M' };
  if (n >= 1e3) return { v: (n / 1e3).toFixed(1), s: 'K' };
  return { v: String(n), s: '' };
}

const LANGUAGES: Record<string, string> = {
  en: 'English', es: 'Spanish', fr: 'French', de: 'German', it: 'Italian',
  pt: 'Portuguese', ru: 'Russian', ja: 'Japanese', ko: 'Korean', zh: 'Chinese',
  hi: 'Hindi', ar: 'Arabic', tr: 'Turkish', th: 'Thai'
};

function getLanguageName(code: string): string {
  return LANGUAGES[code] || code.toUpperCase();
}

// Get directors and writers
const directors = (movie.crew_data || []).filter((c: any) => c.job === 'Director');
const writers = (movie.crew_data || []).filter((c: any) => ['Writer', 'Screenplay'].includes(c.job));

// Transform similar movies for ContentRow
const similar = (tmdbData?.similar?.results || []).slice(0, 12).map((m: any) => ({
  id: m.id,
  tmdb_id: m.id,
  title: m.title,
  poster_path: m.poster_path,
  overview: m.overview,
  vote_average: m.vote_average,
  year: m.release_date ? new Date(m.release_date).getFullYear() : null,
  type: 'movie' as const
}));

// Build OG description for WhatsApp/social sharing - Title (Year) and Synopsis only
const ogYear = movie.year ? `(${movie.year})` : '';
const ogSynopsis = movie.overview || `Watch ${movie.title} online for free in HD quality.`;

// Only synopsis - no rating or genres
const ogDescription = ogSynopsis;

// Prefer a local social/backdrop image when supplied; it can match the
// 1200x630 Open Graph dimensions without replacing the portrait poster.
const ogImage = movie.backdrop_path?.startsWith('/images/')
  ? movie.backdrop_path
  : movie.poster_path
  ? (movie.poster_path.startsWith("/images/") ? movie.poster_path : `https://image.tmdb.org/t/p/w780${movie.poster_path}`)
  : '/images/og-default.jpg';

const ogTitle = `${movie.title} ${ogYear}`.trim();
---


<BaseLayout
  title={ogTitle}
  description={ogDescription}
  image={ogImage}
  type="video.movie"
>
  <MovieJsonLd movie={movie} tmdbId={tmdbId} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=JetBrains+Mono:wght@500&display=swap" />

  <!-- Cinema page (redesign, Nov 2026). The data code above is unchanged: same
       title, description, JSON-LD and share image as the old page. Every
       section of the old page is still here, now inside five tabs. All five
       tab panels are in the HTML (the script below only shows one at a time),
       so search engines still read the whole page. -->
  <div class="cinema force-dark" id="cinema">
    <script is:inline>document.getElementById("cinema").classList.add("anim")</script>
    <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
    <section class="top">
      <div class="bdw">
      {movie.backdrop_path ? (
        <img class="bd" src={getBackdropUrl(movie.backdrop_path)} alt="" width="1280" height="720" fetchpriority="high" />
      ) : (
        <img class="bd bd-poster" src={getPosterUrl(movie.poster_path)} alt="" width="500" height="750" />
      )}
      </div>
      {movie.trailer_key && (
        <div class="vid" id="vid" data-key={movie.trailer_key} aria-hidden="true"><div class="vframe"></div></div>
      )}
      <div class="l warm"></div>
      <div class="l vig"></div>
      <div class="l grain"></div>
      <div class="l fade"></div>

      {movie.trailer_key && (
        <button type="button" class="vmute" id="vmute" aria-label="Turn the trailer sound on" aria-pressed="false">
          <svg class="i-off" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m22 9-6 6M16 9l6 6"/></svg>
          <svg class="i-on" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
        </button>
      )}
      <div class={`wrap layout${movie.trailer_key ? ' has-vid' : ''}`}>
        <div class="head">
          <img class="pst" src={getPosterUrl(movie.poster_path)} alt={`${movie.title} poster`} width="500" height="750" />
          <div class="info">
            <h1 class="t">
              {movie.title}
              {movie.year && <span class="yr">({movie.year})</span>}
            </h1>
            {movie.original_title && movie.original_title.trim().toLowerCase() !== movie.title.trim().toLowerCase() && (
              <p class="orig">Original title: <span>{movie.original_title}</span></p>
            )}
            {movie.tagline && <p class="tag">"{movie.tagline}"</p>}
            <div class="meta">
              <span class="star"><Star size={14} fill="currentColor" /> {movie.vote_average.toFixed(1)} <small>({movie.vote_count})</small></span>
              {movie.runtime && <span>{formatRuntime(movie.runtime)}</span>}
              {movie.release_date && <span>{formatDate(movie.release_date)}</span>}
              <span>{getLanguageName(movie.original_language)}</span>
            </div>
            {movie.genres && movie.genres.length > 0 && (
              <div class="chips">
                {movie.genres.map((genre: any) => (
                  <a href={`/genre/${genre.name.toLowerCase().replace(/\s+/g, '-')}`} class="chip">{genre.name}</a>
                ))}
              </div>
            )}
          </div>
        </div>

        <div class="side">
          <img class="pst-big" src={getPosterUrl(movie.poster_path)} alt="" width="500" height="750" loading="lazy" />
          <div class="cta">
            <button type="button" class="btn amber" data-go="download">Download</button>
            <button type="button" class="btn mint" data-go="stream">Stream</button>
            {movie.trailer_key && (
              <button type="button" class="btn ghost" data-go="trailer">&#9654; Trailer</button>
            )}
          </div>
          {subtitleLinks && subtitleLinks.length > 0 && (
            <button type="button" class="subrow" data-go="download">
              <span>Subtitles <small>({subtitleLinks.length} {subtitleLinks.length === 1 ? 'file' : 'files'})</small></span>
              <span aria-hidden="true">›</span>
            </button>
          )}
          <MovieActions
            client:load
            contentType="movie"
            tmdbId={movie.tmdb_id}
            title={movie.title}
            posterPath={movie.poster_path}
          />
        </div>

        <div class="main">
          <div class="tabsbar" id="tabsbar">
            <div class="tabs" role="tablist" aria-label="Movie sections">
              <button type="button" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" data-tab="overview">Overview</button>
              {movie.cast_data && movie.cast_data.length > 0 && (
                <button type="button" role="tab" id="tab-cast" aria-controls="panel-cast" aria-selected="false" tabindex="-1" data-tab="cast">Cast</button>
              )}
            </div>
            <button type="button" class="minidl" id="minidl" data-go="download" tabindex="-1" aria-hidden="true">Download</button>
          </div>

          <div class="panels" id="panels">
            <!-- Overview -->
            <div class="panel" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" data-panel="overview">
              <section class="blk reveal" style="--d:0">
                <h2 class="sec">The story</h2>
                <p class="story" id="story">{movie.overview || 'No synopsis available.'}</p>
                <button type="button" class="more" id="storymore" aria-expanded="false" hidden>Read more</button>
              </section>

              <section class="blk reveal" style="--d:1">
                <h2 class="sec">How it&apos;s rated</h2>
                <Ratings
                  client:visible
                  tmdbScore={movie.vote_average}
                  tmdbVotes={movie.vote_count}
                  imdbId={movie.imdb_id}
                  rtFallback={movieReview?.rt_score && isFinite(parseInt(movieReview.rt_score)) ? parseInt(movieReview.rt_score) : null}
                />
              </section>

              <section class="facts reveal" style="--d:1">
                <div class="fcards">
                  {directors.length > 0 && (<div class="fc"><span>Director</span><b>{directors.map((d: any) => d.name).join(', ')}</b></div>)}
                  {writers.length > 0 && (<div class="fc"><span>Writers</span><b>{writers.slice(0, 3).map((w: any) => w.name).join(', ')}</b></div>)}
                  {movie.release_date && (<div class="fc"><span>Released</span><b>{formatDate(movie.release_date)}</b></div>)}
                  {movie.runtime && (<div class="fc"><span>Runtime</span><b>{formatRuntime(movie.runtime)}</b></div>)}
                  <div class="fc"><span>Language</span><b>{getLanguageName(movie.original_language)}</b></div>
                  <div class="fc"><span>Status</span><b>{movie.status}</b></div>
                </div>
              </section>

              {(movie.budget > 0 || movie.revenue > 0) && (
                <section class="money reveal" style="--d:2">
                  <h2 class="sec">Box office</h2>
                  {movie.budget > 0 && (
                    <div class="bar"><div class="bl"><span>Budget</span><b data-count={shortParts(movie.budget).v} data-dec="1" data-pre="$" data-suf={shortParts(movie.budget).s}>{formatShortMoney(movie.budget)}</b></div>
                      <div class="track"><i class="fill b" style={`--w:${Math.max(4, Math.round(movie.budget / Math.max(movie.budget, movie.revenue || 0) * 100))}%`}></i></div></div>
                  )}
                  {movie.revenue > 0 && (
                    <div class="bar"><div class="bl"><span>Revenue</span><b data-count={shortParts(movie.revenue).v} data-dec="1" data-pre="$" data-suf={shortParts(movie.revenue).s}>{formatShortMoney(movie.revenue)}</b></div>
                      <div class="track"><i class="fill r" style={`--w:${Math.max(4, Math.round(movie.revenue / Math.max(movie.budget || 0, movie.revenue) * 100))}%`}></i></div></div>
                  )}
                  {movie.budget > 0 && movie.revenue > 0 && (movie.revenue >= movie.budget ? (
                      <p class="ret"><span data-count={(movie.revenue / movie.budget).toFixed(1)} data-dec="1" data-pre="Earned " data-suf="&times; its budget">Earned {(movie.revenue / movie.budget).toFixed(1)}&times; its budget</span></p>
                    ) : (
                      <p class="ret">Earned {Math.round(movie.revenue / movie.budget * 100)}% of its budget</p>
                    ))}
                </section>
              )}

              {movie.production_companies && movie.production_companies.length > 0 && (
                <section class="blk reveal" style="--d:2">
                  <h2 class="sec">Made by</h2>
                  <div class="pchips">
                    {movie.production_companies.slice(0, 4).map((c: any) => (<span class="pc">{c.name}</span>))}
                  </div>
                </section>
              )}

              {movie.cast_data && movie.cast_data.length > 0 && (
                <section class="blk reveal" style="--d:2">
                  <div class="rowhd"><h2 class="sec">Top cast</h2><button type="button" class="seeall" data-go="cast">See all</button></div>
                  <div class="strip">
                    {movie.cast_data.slice(0, 8).map((actor: any) => (
                      <a href={`/person/${actor.id}`} class="sc">
                        <img src={getProfileUrl(actor.profile_path)} alt={actor.name} loading="lazy" width="64" height="64" />
                        <span class="cn">{actor.name}</span>
                        <span class="cc">{actor.character}</span>
                      </a>
                    ))}
                  </div>
                </section>
              )}

              {movieReview && (
                <a href={`/review/${movieReview.slug}`} class="ban reveal" style={`--a:${movieReview.accent || '#ff6a55'};--d:3`}>
                  <div class="ban-tag">⭐ TrendiMovies Review</div>
                  <div class="ban-h">{movieReview.headline}</div>
                  {movieReview.deck && <div class="ban-dk">{movieReview.deck}</div>}
                  <div class="ban-row">
                    {movieReview.rt_score && <span class="ban-chip rt">🍅 {movieReview.rt_score}</span>}
                    {movieReview.box_office && <span class="ban-chip mo">{movieReview.box_office}</span>}
                    {movieReview.verdict && <span class="ban-vd">“{movieReview.verdict}”</span>}
                  </div>
                  <span class="ban-go">Read the full review <i aria-hidden="true">→</i></span>
                </a>
              )}

              {relatedPost && (
                <a href={`/blog/${relatedPost.slug}`} class="ban reveal" style={`--a:${relatedPost.accent || '#f6b93b'};--d:4`}>
                  <div class="ban-tag">📝 TrendiMovies Blog</div>
                  <div class="ban-h">{relatedPost.title}</div>
                  {relatedPost.deck && <div class="ban-dk">{relatedPost.deck}</div>}
                  <span class="ban-go">Read the post <i aria-hidden="true">→</i></span>
                </a>
              )}
            </div>

            <!-- Cast -->
            {movie.cast_data && movie.cast_data.length > 0 && (
              <div class="panel" id="panel-cast" role="tabpanel" aria-labelledby="tab-cast" data-panel="cast" hidden>
                <h2 class="sec">Starring</h2>
                <div class="cast">
                  {movie.cast_data.slice(0, 12).map((actor: any) => (
                    <a href={`/person/${actor.id}`} class="cm">
                      <img src={getProfileUrl(actor.profile_path)} alt={actor.name} loading="lazy" width="96" height="96" />
                      <span class="cn">{actor.name}</span>
                      <span class="cc">{actor.character}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      </div>
    </section>

    <DownloadSheet
      client:load
      links={downloadLinksWithSpecs}
      subtitles={subtitleLinks || []}
      originalTitle={movie.original_title && movie.original_title.trim().toLowerCase() !== movie.title.trim().toLowerCase() ? movie.original_title : ''}
    />

    <StreamSheet
      client:load
      tmdbId={movie.tmdb_id}
      imdbId={movie.imdb_id}
      releaseDate={movie.release_date}
      title={movie.title}
    />
    {movie.trailer_key && (
