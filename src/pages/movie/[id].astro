---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieJsonLd from '../../components/MovieJsonLd.astro';
import VideoPlayer from '../../components/VideoPlayer.svelte';
import DownloadSection from '../../components/DownloadSection.svelte';
import Comments from '../../components/Comments.svelte';
import ContentRow from '../../components/ContentRow.svelte';
import UserActions from '../../components/UserActions.svelte';
import { getMovieDetails, transformMovieData } from '../../lib/tmdb';
import { supabase } from '../../lib/supabase';
import { Star, Clock, Calendar, Globe, Play } from 'lucide-svelte';

const { id } = Astro.params;
const tmdbId = parseInt(id || '0');

if (!tmdbId) {
  return Astro.redirect('/404');
}

// Fetch movie from TMDB
const tmdbData = await getMovieDetails(tmdbId);

// ADDITIVE FALLBACK (2026-07-18): some films aren't on TMDB at all (regional
// titles like Kamal Sridevi). Previously those 404'd. When TMDB has nothing,
// build the movie object from OUR DB row instead so it still renders. This code
// path ONLY runs when tmdbData is null — every TMDB-backed movie is unchanged.
let movie: any;
if (tmdbData) {
  movie = transformMovieData(tmdbData);
} else {
  const { data: dbOnly } = await supabase
    .from('movies')
    .select('tmdb_id, title, slug, overview, year, release_date, runtime, poster_path, backdrop_path, vote_average, original_language')
    .eq('tmdb_id', tmdbId)
    .single();
  if (!dbOnly) {
    return Astro.redirect('/404');
  }
  movie = {
    tmdb_id: dbOnly.tmdb_id,
    imdb_id: null,
    title: dbOnly.title,
    slug: dbOnly.slug,
    original_title: dbOnly.title,
    overview: dbOnly.overview || '',
    tagline: null,
    release_date: dbOnly.release_date || null,
    year: dbOnly.year || null,
    runtime: dbOnly.runtime || null,
    budget: null, revenue: null, popularity: 0,
    vote_average: dbOnly.vote_average || 0,
    vote_count: 0,
    poster_path: dbOnly.poster_path || null,
    backdrop_path: dbOnly.backdrop_path || null,
    trailer_key: null,
    original_language: dbOnly.original_language || 'en',
    spoken_languages: [], production_countries: [], production_companies: [],
    genres: [], cast_data: [], crew_data: [], keywords: [],
    watch_providers: {}, status: 'released',
  };
}

// Look up internal DB ID for this movie (cron stores content_id = movies.id, not tmdb_id)
const { data: dbMovie } = await supabase
  .from('movies')
  .select('id, title, poster_path, backdrop_path, year, release_date')
  .eq('tmdb_id', tmdbId)
  .single();

// TMDB has no English translation for some regional titles (returns the
// native-script title as-is, e.g. "冒牌监护人之寻宝闹翻天" for "Fake
// Guardians" 2017) -- no text-matching fix on the assign side can ever
// find these from an English release filename, since there's no English
// text to match against. Narrow, deliberate override: only when TMDB's
// title has ZERO Latin characters (genuinely untranslated) and our DB has
// an admin-set Latin title, prefer the DB one for display. Doesn't touch
// the vast majority of titles where DB and TMDB agree or DB is just a
// stale copy of an older TMDB title -- this only fires for the specific
// "TMDB never translated it" case. Fixed 2026-08-31.
const _tmdbTitleHasLatin = /[a-zA-Z]/.test(movie.title || '');
const _dbTitleHasLatin = /[a-zA-Z]/.test(dbMovie?.title || '');
if (!_tmdbTitleHasLatin && _dbTitleHasLatin && dbMovie?.title) {
  movie.original_title = movie.title;
  movie.title = dbMovie.title;
}

// Fallback: if TMDB has no poster/backdrop, use DB cached version
// Use DB poster if manually overridden (different from TMDB)
if (dbMovie?.poster_path && dbMovie.poster_path !== movie.poster_path) {
  movie.poster_path = dbMovie.poster_path;
} else if (!movie.poster_path && dbMovie?.poster_path) {
  movie.poster_path = dbMovie.poster_path;
}
if (!movie.backdrop_path && dbMovie?.backdrop_path) {
  movie.backdrop_path = dbMovie.backdrop_path;
}

// DB year/release_date override: TMDB sometimes has a wrong/early date (e.g. a
// festival premiere) while our DB holds the correct release year. If the DB year
// differs from TMDB's, trust the DB (it was set/corrected deliberately).
if (dbMovie?.year && dbMovie.year !== movie.year) {
  movie.year = dbMovie.year;
  if (dbMovie.release_date) movie.release_date = dbMovie.release_date;
}

const internalId = dbMovie?.id;

// Is there a published review for this movie? (drives the Read Review banner)
let movieReview = null;
try {
  const { data: rvRows } = await supabase
    .from('movie_reviews')
    .select('slug, headline, deck, accent, rt_score, box_office, verdict')
    .eq('tmdb_id', tmdbId)
    .eq('status', 'published')
    .limit(1);
  movieReview = (rvRows && rvRows.length) ? rvRows[0] : null;
} catch (e) { movieReview = null; }

// Is there a published blog post centered on this movie? (drives the Related Read banner)
let relatedPost = null;
try {
  const { data: blRows } = await supabase
    .from('blog_posts')
    .select('slug, title, deck, accent, tags')
    .eq('related_tmdb_id', tmdbId)
    .eq('related_type', 'movie')
    .eq('status', 'published')
    .limit(1);
  relatedPost = (blRows && blRows.length) ? blRows[0] : null;
} catch (e) { relatedPost = null; }

// Fetch download links using internal DB ID
const { data: rawLinks } = internalId ? await supabase
  .from('download_links')
  .select('*')
  .eq('content_type', 'movie')
  .eq('content_id', internalId)
  .eq('is_active', true) : { data: [] };

const downloadLinks = (rawLinks || []).map((link: any) => ({
  ...link,
  type: link.source === 'torrent' ? 'torrent' as const : 'ddl' as const,
  source: link.source === 'telegram' ? 1 : link.source === 'cinematika' ? 2 : undefined,
}));

// Fetch subtitle links
const { data: subtitleLinks } = internalId ? await supabase
  .from('subtitle_links')
  .select('id, file_name, file_size, telegram_file_id')
  .eq('content_type', 'movie')
  .eq('content_id', internalId)
  .eq('is_active', true) : { data: [] };

// Helper functions
function getPosterUrl(path: string | null): string {
  if (!path) return '/images/no-poster.svg';
    if (path.startsWith('/images/')) return path;
    return `https://image.tmdb.org/t/p/w500${path}`;
}

function getBackdropUrl(path: string | null): string {
  if (!path) return '/images/no-backdrop.svg';
  if (path.startsWith('/images/')) return path;
  return `https://image.tmdb.org/t/p/w1280${path}`;
}

function getProfileUrl(path: string | null): string {
  if (!path) return '/images/no-profile.svg';
  return `https://image.tmdb.org/t/p/w185${path}`;
}

function formatRuntime(minutes: number | null): string {
  if (!minutes) return 'N/A';
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatMoney(amount: number | null): string {
  if (!amount) return 'N/A';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(amount);
}

const LANGUAGES: Record<string, string> = {
  en: 'English', es: 'Spanish', fr: 'French', de: 'German', it: 'Italian',
  pt: 'Portuguese', ru: 'Russian', ja: 'Japanese', ko: 'Korean', zh: 'Chinese',
  hi: 'Hindi', ar: 'Arabic', tr: 'Turkish', th: 'Thai'
};

function getLanguageName(code: string): string {
  return LANGUAGES[code] || code.toUpperCase();
}

// Get directors and writers
const directors = (movie.crew_data || []).filter((c: any) => c.job === 'Director');
const writers = (movie.crew_data || []).filter((c: any) => ['Writer', 'Screenplay'].includes(c.job));

// Transform similar movies for ContentRow
const similar = (tmdbData?.similar?.results || []).slice(0, 12).map((m: any) => ({
  id: m.id,
  tmdb_id: m.id,
  title: m.title,
  poster_path: m.poster_path,
  overview: m.overview,
  vote_average: m.vote_average,
  year: m.release_date ? new Date(m.release_date).getFullYear() : null,
  type: 'movie' as const
}));

// Build OG description for WhatsApp/social sharing - Title (Year) and Synopsis only
const ogYear = movie.year ? `(${movie.year})` : '';
const ogSynopsis = movie.overview || `Watch ${movie.title} online for free in HD quality.`;

// Only synopsis - no rating or genres
const ogDescription = ogSynopsis;

// Prefer a local social/backdrop image when supplied; it can match the
// 1200x630 Open Graph dimensions without replacing the portrait poster.
const ogImage = movie.backdrop_path?.startsWith('/images/')
  ? movie.backdrop_path
  : movie.poster_path
  ? (movie.poster_path.startsWith("/images/") ? movie.poster_path : `https://image.tmdb.org/t/p/w780${movie.poster_path}`)
  : '/images/og-default.jpg';

const ogTitle = `${movie.title} ${ogYear}`.trim();
---

<BaseLayout
  title={ogTitle}
  description={ogDescription}
  image={ogImage}
  type="video.movie"
>
  <MovieJsonLd movie={movie} tmdbId={tmdbId} />
  <!-- Backdrop Header -->
  <section class="relative">
    <div class="absolute inset-0 h-[300px] md:h-[500px]">
      <img
        src={getBackdropUrl(movie.backdrop_path)}
        alt={movie.title}
        width="1280"
        height="720"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-[var(--bg-primary)]/80 to-transparent"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-8 md:pb-12">
      <div class="flex flex-col md:flex-row gap-5 md:gap-8">
        <div class="flex-shrink-0 w-48 md:w-64 mx-auto md:mx-0">
          <img
            src={getPosterUrl(movie.poster_path)}
            alt={movie.title}
            width="500"
            height="750"
            class="w-full rounded-lg shadow-2xl"
          />
        </div>

        <div class="flex-1">
          <h1 class="text-2xl md:text-4xl lg:text-5xl font-bold mb-2 md:mb-4" style="color: var(--text-primary);">
            {movie.title}
            {movie.year && <span class="text-xl md:text-2xl font-normal" style="color: var(--text-secondary);"> ({movie.year})</span>}
          </h1>

          {movie.original_title && movie.original_title.trim().toLowerCase() !== movie.title.trim().toLowerCase() && (
            <p class="-mt-1 mb-3 md:mb-4 text-sm md:text-base" style="color: var(--text-secondary);">
              Original title: <span style="color: var(--text-primary);">{movie.original_title}</span>
            </p>
          )}

          {movie.tagline && (
            <p class="text-base md:text-lg italic mb-3 md:mb-4" style="color: var(--text-secondary);">
              "{movie.tagline}"
            </p>
          )}

          <div class="flex flex-wrap items-center gap-3 md:gap-4 mb-4 md:mb-6 text-sm" style="color: var(--text-secondary);">
            <div class="flex items-center gap-1">
              <Star size={16} class="text-yellow-400" fill="currentColor" />
              <span class="font-semibold" style="color: var(--text-primary);">{movie.vote_average.toFixed(1)}</span>
              <span class="text-xs md:text-sm">({movie.vote_count} votes)</span>
            </div>
            {movie.runtime && (
              <div class="flex items-center gap-1">
                <Clock size={16} />
                <span>{formatRuntime(movie.runtime)}</span>
              </div>
            )}
            {movie.release_date && (
              <div class="flex items-center gap-1">
                <Calendar size={16} />
                <span>{formatDate(movie.release_date)}</span>
              </div>
            )}
            <div class="flex items-center gap-1">
              <Globe size={16} />
              <span>{getLanguageName(movie.original_language)}</span>
            </div>
          </div>

          {movie.genres && movie.genres.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4 md:mb-6">
              {movie.genres.map((genre: any) => (
                <a
                  href={`/genre/${genre.name.toLowerCase().replace(/\s+/g, '-')}`}
                  class="genre-chip"
                >
                  {genre.name}
                </a>
              ))}
            </div>
          )}

          <!-- User Actions -->
          <UserActions
            client:load
            contentType="movie"
            tmdbId={movie.tmdb_id}
            title={movie.title}
            posterPath={movie.poster_path}
          />
          <div class="mb-4 md:mb-6">
            <h3 class="font-semibold mb-1.5 md:mb-2" style="color: var(--text-primary);">Synopsis</h3>
            <p class="leading-relaxed text-sm md:text-base" style="color: var(--text-primary); opacity: 0.85;">
              {movie.overview || 'No synopsis available.'}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 md:gap-4">
            {directors.length > 0 && (
              <div>
                <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Director</h4>
                <p style="color: var(--text-primary);">{directors.map((d: any) => d.name).join(', ')}</p>
              </div>
            )}
            {writers.length > 0 && (
              <div>
                <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Writers</h4>
                <p style="color: var(--text-primary);">{writers.slice(0, 3).map((w: any) => w.name).join(', ')}</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Player -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2" style="color: var(--text-primary);">
      <Play size={24} />
      Watch Now
    </h2>
    <VideoPlayer
      client:load
      tmdbId={movie.tmdb_id}
      imdbId={movie.imdb_id}
      type="movie"
      releaseDate={movie.release_date}
    />
  </section>

  <!-- Adsterra Banner 320x50 -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex justify-center">
    <script is:inline>
      atOptions = {
        'key' : '72e8a3ac047110fa65f71d101343d2fd',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/72e8a3ac047110fa65f71d101343d2fd/invoke.js"></script>
  </div>

  <!-- Downloads Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <DownloadSection
      client:load
      links={downloadLinks || []}
      subtitles={subtitleLinks || []}
      contentId={tmdbId}
      contentType="movie"
      title={movie.title}
      originalTitle={movie.original_title || ''}
    />
  </section>

  {movieReview && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
      <a href={`/review/${movieReview.slug}`} class="rv-banner" style={`--a:${movieReview.accent || '#dc2626'}`}>
        <div class="rv-banner-left">
          <div class="rv-banner-tag">⭐ TrendiMovies Review</div>
          <div class="rv-banner-h">{movieReview.headline}</div>
          {movieReview.deck && <div class="rv-banner-deck">{movieReview.deck}</div>}
          <div class="rv-banner-meta">
            {movieReview.rt_score && <span class="rv-banner-chip rt">🍅 {movieReview.rt_score}</span>}
            {movieReview.box_office && <span class="rv-banner-chip mo">{movieReview.box_office}</span>}
            {movieReview.verdict && <span class="rv-banner-verdict">“{movieReview.verdict}”</span>}
          </div>
        </div>
        <span class="rv-banner-cta">Read the full review →</span>
      </a>
    </section>
  )}

  {relatedPost && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
      <a href={`/blog/${relatedPost.slug}`} class="rv-banner" style={`--a:${relatedPost.accent || '#f59e0b'}`}>
        <div class="rv-banner-left">
          <div class="rv-banner-tag">📝 TrendiMovies Blog</div>
          <div class="rv-banner-h">{relatedPost.title}</div>
          {relatedPost.deck && <div class="rv-banner-deck">{relatedPost.deck}</div>}
        </div>
        <span class="rv-banner-cta">Read the post →</span>
      </a>
    </section>
  )}

  <!-- Cast -->
  {movie.cast_data && movie.cast_data.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <h2 class="text-2xl font-bold mb-4" style="color: var(--text-primary);">Cast</h2>
      <div class="flex gap-4 overflow-x-auto hide-scrollbar pb-4">
        {movie.cast_data.slice(0, 12).map((actor: any) => (
          <a href={`/person/${actor.id}`} class="flex-shrink-0 w-32 text-center group">
            <img
              src={getProfileUrl(actor.profile_path)}
              alt={actor.name}
              class="w-24 h-24 rounded-full mx-auto object-cover mb-2 transition-transform group-hover:scale-105"
            />
            <p class="font-medium text-sm line-clamp-1 group-hover:underline" style="color: var(--text-primary);">{actor.name}</p>
            <p class="text-xs line-clamp-1" style="color: var(--text-secondary);">{actor.character}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Trailer -->
  {movie.trailer_key && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <h2 class="text-2xl font-bold mb-4" style="color: var(--text-primary);">Trailer</h2>
      <div class="video-container rounded-lg overflow-hidden">
        <iframe
          src={`https://www.youtube.com/embed/${movie.trailer_key}`}
          allowfullscreen
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          title="Trailer"
        ></iframe>
      </div>
    </section>
  )}

  <!-- Details -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h2 class="text-2xl font-bold mb-4" style="color: var(--text-primary);">Details</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 rounded-lg" style="background-color: var(--bg-card);">
      <div>
        <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Original Title</h4>
        <p style="color: var(--text-primary);">{movie.original_title || movie.title}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Status</h4>
        <p style="color: var(--text-primary);">{movie.status}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Budget</h4>
        <p style="color: var(--text-primary);">{formatMoney(movie.budget)}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Revenue</h4>
        <p style="color: var(--text-primary);">{formatMoney(movie.revenue)}</p>
      </div>
      {movie.production_companies && movie.production_companies.length > 0 && (
        <div class="col-span-2">
          <h4 class="text-sm font-semibold" style="color: var(--text-muted);">Production</h4>
          <p style="color: var(--text-primary);">{movie.production_companies.slice(0, 3).map((c: any) => c.name).join(', ')}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Similar Movies -->
  {similar.length > 0 && (
    <ContentRow
      client:visible
      title="You May Also Like"
      items={similar}
    />
  )}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Comments client:visible contentType="movie" contentId={tmdbId} />
  </section>
</BaseLayout>

<style>
  .rv-banner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;
    background:linear-gradient(135deg,color-mix(in srgb,var(--a) 16%,transparent),rgba(255,255,255,.02));
    border:1px solid color-mix(in srgb,var(--a) 30%,rgba(255,255,255,.08));border-radius:20px;padding:24px 28px;
    text-decoration:none;transition:transform .2s,border-color .2s;box-shadow:0 16px 40px rgba(0,0,0,.3)}
  .rv-banner:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--a) 60%,transparent)}
  .rv-banner-left{min-width:0}
  .rv-banner-tag{color:var(--a);font-weight:800;letter-spacing:2px;font-size:12px;text-transform:uppercase;margin-bottom:8px}
  .rv-banner-h{font-size:24px;font-weight:800;color:#fff;line-height:1.15;margin-bottom:6px}
  .rv-banner-deck{color:#c3c0cc;font-size:15px;line-height:1.5;margin-bottom:12px;max-width:60ch}
  .rv-banner-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .rv-banner-chip{font-weight:700;font-size:13px;padding:5px 12px;border-radius:100px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12)}
  .rv-banner-chip.rt{color:#22c55e}.rv-banner-chip.mo{color:#f59e0b}
  .rv-banner-verdict{font-style:italic;color:#e9e7ee;font-size:14px}
  .rv-banner-cta{color:var(--a);font-weight:800;font-size:16px;white-space:nowrap;flex:none}
  @media(max-width:640px){.rv-banner{flex-direction:column;align-items:flex-start}.rv-banner-h{font-size:20px}}
</style>
