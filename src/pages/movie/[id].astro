<script>
  // Tabs: show one panel at a time. Plain script, no framework, so nothing
  // here can disagree with the server-rendered HTML.
  const root = document.getElementById('cinema');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const bar = document.getElementById('tabsbar');
    const mini = document.getElementById('minidl');
    const names = tabs.map(t => t.dataset.tab as string);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const headerH = () => (window.innerWidth >= 1024 ? 80 : 64);

    function show(name: string, scroll: boolean) {
      if (name === 'download') { window.dispatchEvent(new CustomEvent('tm:downloads')); return; }
      if (name === 'stream' || name === 'trailer') { window.dispatchEvent(new CustomEvent('tm:' + name)); return; }
      if (!names.includes(name)) name = 'overview';
      tabs.forEach(t => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach(p => { p.hidden = p.dataset.panel !== name; });
      try { history.replaceState(null, '', name === 'overview' ? location.pathname + location.search : '#' + name); } catch (e) {}
      if (scroll && bar) {
        const y = bar.getBoundingClientRect().top + window.scrollY - headerH();
        if (y < window.scrollY || window.innerWidth < 900) window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
      }
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab as string, true));
      t.addEventListener('keydown', e => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        show(next.dataset.tab as string, false);
      });
    });
    root.querySelectorAll<HTMLElement>('[data-go]').forEach(b => b.addEventListener('click', () => show(b.dataset.go as string, true)));


    // The small Download button appears in the tab bar once the top is scrolled away.
    const top = root.querySelector('.top .head');
    if (top && mini && 'IntersectionObserver' in window) {
      new IntersectionObserver(([en]) => {
        const out = !en.isIntersecting && en.boundingClientRect.top < 0;
        mini.classList.toggle('on', out);
        mini.tabIndex = out ? 0 : -1;
        mini.setAttribute('aria-hidden', out ? 'false' : 'true');
      }, { rootMargin: '-80px 0px 0px 0px' }).observe(top);
    }


    // Trailer video in the top. Starts muted a moment after the page has
    // loaded; skipped on Data Saver, on 2G, and for people who asked their
    // phone for less motion. If YouTube does not start playing within 9
    // seconds the video is removed and the backdrop picture stays.
    const vid = document.getElementById('vid');
    const vmute = document.getElementById('vmute') as HTMLButtonElement | null;
    const vkey = vid?.dataset.key;
    const conn: any = (navigator as any).connection;
    const saver = !!conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''));
    if (vid && vkey && !saver && !reduce) {
      const mountVideo = () => {
        const holder = vid.querySelector('.vframe');
        if (!holder) return;
        const f = document.createElement('iframe');
        f.src = 'https://www.youtube.com/embed/' + vkey + '?autoplay=1&mute=1&controls=0&loop=1&playlist=' + vkey +
          '&playsinline=1&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&enablejsapi=1&origin=' + encodeURIComponent(location.origin);
        f.title = 'Trailer preview';
        f.allow = 'autoplay; encrypted-media';
        f.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation');
        f.setAttribute('aria-hidden', 'true');
        f.tabIndex = -1;
        holder.appendChild(f);
        const send = (obj: object) => { try { f.contentWindow?.postMessage(JSON.stringify(obj), '*'); } catch (e) {} };
        const cmd = (func: string) => send({ event: 'command', func, args: [] });
        // The Stream and Trailer pop-ups have their own sound: pause this one.
        window.addEventListener('tm:stream', () => cmd('pauseVideo'));
        window.addEventListener('tm:trailer', () => cmd('pauseVideo'));
        f.addEventListener('load', () => send({ event: 'listening', id: 1 }));
        let playing = false;
        window.addEventListener('message', ev => {
          if (ev.source !== f.contentWindow) return;
          let d: any = ev.data;
          if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { return; } }
          if (d && d.event === 'onError') { f.remove(); return; } // this trailer cannot be embedded: keep the backdrop picture
          const st = d && d.info && typeof d.info === 'object' ? d.info.playerState : d && d.event === 'onStateChange' ? d.info : undefined;
          if (st === 1 && !playing) {
            playing = true;
            vid.classList.add('on');
            vmute?.classList.add('on');
          }
        });
        setTimeout(() => { if (!playing) { f.remove(); } }, 9000);
        let muted = true;
        vmute?.addEventListener('click', () => {
          muted = !muted;
          cmd(muted ? 'mute' : 'unMute');
          vmute.setAttribute('aria-pressed', muted ? 'false' : 'true');
          vmute.setAttribute('aria-label', muted ? 'Turn the trailer sound on' : 'Turn the trailer sound off');
          vmute.classList.toggle('sound', !muted);
        });
        // Pause the picture when the top is scrolled out of view.
        const hero = root.querySelector('.top');
        if (hero && 'IntersectionObserver' in window) {
          new IntersectionObserver(([en]) => { if (playing) cmd(en.isIntersecting ? 'playVideo' : 'pauseVideo'); }, { threshold: 0.15 }).observe(hero);
        }
        document.addEventListener('visibilitychange', () => { if (playing) cmd(document.hidden ? 'pauseVideo' : 'playVideo'); });
      };
      const kick = () => setTimeout(mountVideo, 1200);
      if (document.readyState === 'complete') kick(); else window.addEventListener('load', kick, { once: true });
    }


    // Overview: sections rise in as they scroll into view, numbers count up,
    // a long story folds to a few lines with a Read more button. All of it is
    // decoration: the full text is already in the page, and if this script
    // ever fails the safety timer shows everything.
    const items = Array.from(root.querySelectorAll<HTMLElement>('.reveal'));
    const count = (el: HTMLElement) => {
      el.querySelectorAll<HTMLElement>('[data-count]').forEach(n => {
        const to = parseFloat(n.dataset.count || '0'), dec = parseInt(n.dataset.dec || '0', 10);
        if (reduce || !isFinite(to)) return;
        const t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 900);
          n.textContent = (n.dataset.pre || '') + (to * (1 - Math.pow(1 - k, 3))).toFixed(dec) + (n.dataset.suf || '');
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };
    const reveal = (el: HTMLElement) => { if (!el.classList.contains('in')) { el.classList.add('in'); count(el); } };
    if (reduce || !('IntersectionObserver' in window)) items.forEach(reveal);
    else {
      const io = new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { reveal(en.target as HTMLElement); io.unobserve(en.target); } }), { threshold: 0.12 });
      items.forEach(i => io.observe(i));
      setTimeout(() => items.forEach(reveal), 4000);
    }
    const story = document.getElementById('story');
    const more = document.getElementById('storymore') as HTMLButtonElement | null;
    if (story && more) {
      story.classList.add('clamp');
      if (story.scrollHeight > story.clientHeight + 4) {
        more.hidden = false;
        more.addEventListener('click', () => {
          const open = story.classList.toggle('clamp') === false;
          more.textContent = open ? 'Show less' : 'Read more';
          more.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      } else story.classList.remove('clamp');
    }

    const start = location.hash.replace('#', '');
    if (start && names.includes(start)) show(start, false);
  }
</script>

<style>
