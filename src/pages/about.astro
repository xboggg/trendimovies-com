---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="Learn more about TrendiMovies">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold mb-8" style="color: var(--text-primary);">About TrendiMovies</h1>

    <div class="space-y-6" style="color: var(--text-secondary);">
      <p>
        Welcome to TrendiMovies, your guide to movies and TV series. We help you decide what to watch: ratings, trailers, cast, hand-made guides and where to watch each title.
      </p>

      <h2 class="text-xl font-semibold mt-8 mb-4" style="color: var(--text-primary);">Our Mission</h2>
      <p>
        Our mission is to help people everywhere find great films and series, from Hollywood and Nollywood to Bollywood, K-drama, anime and world cinema, and to show them where they can watch them.
      </p>

      <h2 class="text-xl font-semibold mt-8 mb-4" style="color: var(--text-primary);">Features</h2>
      <ul class="list-disc list-inside space-y-2 ml-4">
        <li>Ratings, trailers, cast and box office for thousands of titles</li>
        <li>Hand-made guides and lists: what to watch next</li>
        <li>Where to watch: streaming, rent and buy options</li>
        <li>Regularly updated with the latest releases</li>
        <li>User-friendly interface with dark/light mode</li>
        <li>Mobile-friendly design</li>
        <li>No registration required</li>
      </ul>

      <h2 class="text-xl font-semibold mt-8 mb-4" style="color: var(--text-primary);">Disclaimer</h2>
      <p>
        TrendiMovies is an information service. We do not host, stream or distribute any films or series. Film information and images come from TMDB, and streaming availability comes from JustWatch. All trademarks and images belong to their owners.
      </p>

      <h2 class="text-xl font-semibold mt-8 mb-4" style="color: var(--text-primary);">Connect With Us</h2>
      <div class="flex gap-4">
        <a
          href="https://tiktok.com/@trendimovies"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          TikTok
        </a>
        <a
          href="https://facebook.com/trendimovies"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg"
          style="background-color: #1877f2; color: white;"
        >
          Facebook
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
