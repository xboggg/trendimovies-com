// Fetch collection details from TMDB
async function getCollectionDetails(collectionId: number) {
  try {
    return await fetchFromTMDB(`/collection/${collectionId}`);
  } catch (e) {
    console.error(`Failed to fetch collection ${collectionId}:`, e);
    return null;
  }
}

// Fetch collections in BATCHES (8 at a time) instead of all 78 at once — firing
// 78 simultaneous TMDB calls hit the rate limit and randomly dropped a franchise
// (e.g. Scary Movie) each build. Batching + caching makes every franchise appear.
async function fetchOne([slug, info]: [string, any]) {
  const data = await getCollectionDetails(info.collectionId);
  if (!data) return null;
  return {
    slug, name: info.name, color: info.color,
    backdrop_path: data.backdrop_path, poster_path: data.poster_path,
    overview: data.overview,
    movies: (data.parts || []).sort((a: any, b: any) => {
      const dateA = a.release_date ? new Date(a.release_date).getTime() : 0;
      const dateB = b.release_date ? new Date(b.release_date).getTime() : 0;
      return dateA - dateB;
    }),
    totalMovies: data.parts?.length || 0,
  };
}
const entries = Object.entries(franchiseCollections);
const collectionsData: any[] = [];
for (let i = 0; i < entries.length; i += 8) {
  const batch = entries.slice(i, i + 8);
  const results = await Promise.all(batch.map(fetchOne));
  collectionsData.push(...results);
}
const franchises = collectionsData.filter((f): f is NonNullable<typeof f> => f !== null);

// Sort by total movies
franchises.sort((a, b) => b.totalMovies - a.totalMovies);

function getPosterUrl(path: string | null): string {
  if (!path) return '/images/no-poster.svg';
  return `https://image.tmdb.org/t/p/w342${path}`;
}

function getBackdropUrl(path: string | null): string {
  if (!path) return '/images/no-backdrop.svg';
  return `https://image.tmdb.org/t/p/w1280${path}`;
}
---

<BaseLayout
  title="Movie Franchises — Complete Collections | TrendiMovies"
  description="Binge entire movie sagas in order — Marvel, DC, Star Wars, Harry Potter, Fast & Furious, James Bond and more. Every film in each franchise, ready to stream or download in HD."
  image={`/api/og.png?type=digital&posters=${encodeURIComponent(franchises.filter((f: any) => f.poster_path).slice(0, 5).map((f: any) => f.poster_path).join('|'))}&accent=${encodeURIComponent('#e50914')}&eyebrow=${encodeURIComponent('COMPLETE COLLECTIONS')}&eyebrowEmoji=${encodeURIComponent('🎬')}&headline=${encodeURIComponent('Movie Franchises')}&subtitle=${encodeURIComponent('Marvel, DC, Star Wars, Harry Potter & more — every film in order')}&ogurl=${encodeURIComponent('trendimovies.com/franchises')}`}
>
  <!-- Header -->
  <section class="relative py-12 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-transparent to-blue-900/30"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-3xl md:text-5xl font-black mb-4" style="color: var(--text-primary);">
          <span class="text-purple-500">🎬</span> Movie Franchises
        </h1>
        <p class="text-lg mb-6" style="color: var(--text-secondary);">
          Explore complete movie collections and franchise universes
        </p>
        <div class="max-w-md mx-auto">
          <input
            id="franchise-search"
            type="search"
            placeholder="Search franchises… (Bond, Scary Movie, Marvel)"
            autocomplete="off"
            class="w-full px-5 py-3 rounded-full text-sm"
            style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
          />
        </div>
        <p id="franchise-count" class="text-xs mt-3" style="color: var(--text-muted);">{franchises.length} franchises</p>
      </div>
    </div>
  </section>

  <!-- Franchises: collapsed horizontal rows + search + pagination -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div id="franchise-list" class="space-y-6">
      {franchises.map((franchise, idx) => (
        <div
          class="franchise-card rounded-2xl overflow-hidden"
          data-name={franchise.name.toLowerCase()}
          data-page={Math.floor(idx / 12)}
          style="background-color: var(--bg-card); border: 1px solid var(--border);"
        >
          <div class="p-4 md:p-5">
            <div class="flex items-center gap-3 min-w-0 mb-3">
              <span class="inline-block w-2 h-8 rounded-full shrink-0" style={`background-color: ${franchise.color};`}></span>
              <h2 class="text-lg md:text-xl font-black truncate" style="color: var(--text-primary);">{franchise.name}</h2>
              <span class="text-xs whitespace-nowrap px-2 py-0.5 rounded-full" style="background: var(--bg-hover); color: var(--text-muted);">{franchise.totalMovies} films</span>
            </div>
            <div class="flex gap-3 overflow-x-auto pb-2">
              {franchise.movies.map((movie: any) => (
                <a href={`/movie/${movie.id}`} class="group shrink-0" style="width: 96px;">
                  <div class="relative aspect-[2/3] rounded-lg overflow-hidden mb-1">
                    <img loading="lazy" src={getPosterUrl(movie.poster_path)} alt={movie.title}
                      class="w-full h-full object-cover transition-transform group-hover:scale-105" />
                  </div>
                  <p class="text-[11px] font-medium line-clamp-2 leading-tight" style="color: var(--text-primary);">{movie.title}</p>
                  <p class="text-[10px]" style="color: var(--text-muted);">{movie.release_date ? new Date(movie.release_date).getFullYear() : 'TBA'}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <p id="franchise-empty" class="hidden text-center py-12" style="color: var(--text-secondary);">No franchises match your search.</p>
    <div id="franchise-pagination" class="flex justify-center items-center gap-2 mt-8"></div>
  </section>

  <script>
    (function () {
      const PER_PAGE = 12;
      const cards = Array.from(document.querySelectorAll('.franchise-card')) as HTMLElement[];
      const searchEl = document.getElementById('franchise-search') as HTMLInputElement | null;
      const emptyEl = document.getElementById('franchise-empty')!;
      const pagEl = document.getElementById('franchise-pagination')!;
      const countEl = document.getElementById('franchise-count')!;
      let page = 0;
      let query = '';

      const filtered = () => cards.filter(c => !query || (c.dataset.name || '').includes(query));

      function render() {
        const list = filtered();
        const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
        if (page >= pages) page = 0;
        cards.forEach(c => (c.style.display = 'none'));
        list.slice(page * PER_PAGE, page * PER_PAGE + PER_PAGE).forEach(c => (c.style.display = ''));
        emptyEl.classList.toggle('hidden', list.length > 0);
        countEl.textContent = query
          ? `${list.length} match${list.length === 1 ? '' : 'es'}`
          : `${cards.length} franchises`;
        pagEl.replaceChildren();
        if (pages > 1) {
          const mk = (label: string, target: number, disabled: boolean, active = false) => {
            const b = document.createElement('button');
            b.textContent = label;
            b.className = 'px-3 py-1.5 rounded-lg text-sm';
            b.style.cssText = `background:${active ? 'var(--accent,#e50914)' : 'var(--bg-card)'};color:${active ? '#fff' : 'var(--text-primary)'};border:1px solid var(--border);${disabled ? 'opacity:.4;pointer-events:none;' : 'cursor:pointer;'}`;
            b.onclick = () => { page = target; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
            return b;
          };
          pagEl.appendChild(mk('‹ Prev', page - 1, page === 0));
          for (let i = 0; i < pages; i++) {
            if (i === 0 || i === pages - 1 || Math.abs(i - page) <= 1) {
              pagEl.appendChild(mk(String(i + 1), i, false, i === page));
            } else if (Math.abs(i - page) === 2) {
              const dots = document.createElement('span'); dots.textContent = '…'; dots.style.cssText = 'color:var(--text-muted);padding:0 4px;'; pagEl.appendChild(dots);
            }
          }
          pagEl.appendChild(mk('Next ›', page + 1, page === pages - 1));
        }
      }
      let t: ReturnType<typeof setTimeout>;
      searchEl?.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(() => { query = (searchEl.value || '').trim().toLowerCase(); page = 0; render(); }, 120);
      });
      render();
    })();
  </script>
</BaseLayout>

