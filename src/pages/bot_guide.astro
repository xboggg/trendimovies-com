<style>
  /* ---- palette ------------------------------------------------------- */
  .bg-page{
    --ink:#f2eef7; --dim:#a9a2b8; --faint:#6f6880;
    --panel:#15121c; --panel2:#1b1724; --line:rgba(255,255,255,.085);
    --rose:#ff4d6d; --amber:#ff9f1c; --gold:#ffd166; --magenta:#f72585;
    --orange:#ff8800; --teal:#2ec4b6; --purple:#b16cff; --slate:#8fa3c0;
    --pink:#ff5fa8; --cyan:#4cc9f0;
