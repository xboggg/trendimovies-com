    position:relative; isolation:isolate; overflow-x:clip;
    background:#0a0810; color:var(--ink);
    font-family:'Outfit',system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  .hue-rose{--a:var(--rose)} .hue-amber{--a:var(--amber)} .hue-gold{--a:var(--gold)}
  .hue-magenta{--a:var(--magenta)} .hue-orange{--a:var(--orange)} .hue-teal{--a:var(--teal)}
  .hue-purple{--a:var(--purple)} .hue-slate{--a:var(--slate)} .hue-pink{--a:var(--pink)}
  .hue-cyan{--a:var(--cyan)}

  .bg-wrap{max-width:1020px;margin:0 auto;padding-inline:18px}

  /* ---- scroll progress ----------------------------------------------- */
  .bg-scroll-progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:60;background:transparent;pointer-events:none}
  .bg-scroll-progress i{display:block;height:100%;width:0;
    background:linear-gradient(90deg,#ff4d6d,#ff9f1c,#ffd166,#2ec4b6,#4cc9f0,#b16cff);
    box-shadow:0 0 14px rgba(255,120,180,.6)}

  /* ---- animated background ------------------------------------------- */
  .bg-aurora{position:absolute;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
  .orb{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;will-change:transform}
  .o1{width:46vmax;height:46vmax;left:-14vmax;top:-10vmax;background:radial-gradient(circle,#ff4d6d,transparent 68%);animation:drift1 26s ease-in-out infinite}
  .o2{width:40vmax;height:40vmax;right:-12vmax;top:14vmax;background:radial-gradient(circle,#b16cff,transparent 68%);animation:drift2 32s ease-in-out infinite}
  .o3{width:38vmax;height:38vmax;left:8vmax;top:92vmax;background:radial-gradient(circle,#2ec4b6,transparent 68%);animation:drift3 30s ease-in-out infinite}
  .o4{width:42vmax;height:42vmax;right:-8vmax;top:170vmax;background:radial-gradient(circle,#4cc9f0,transparent 68%);animation:drift1 36s ease-in-out infinite reverse}
  .bg-grid{position:absolute;inset:0;opacity:.3;
    background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 80% 55% at 50% 0%,#000 35%,transparent 78%);
    -webkit-mask-image:radial-gradient(ellipse 80% 55% at 50% 0%,#000 35%,transparent 78%)}
  @keyframes drift1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(7vmax,5vmax) scale(1.14)}}
  @keyframes drift2{0%,100%{transform:translate(0,0) scale(1.08)}50%{transform:translate(-8vmax,7vmax) scale(.92)}}
  @keyframes drift3{0%,100%{transform:translate(0,0)}50%{transform:translate(6vmax,-6vmax) scale(1.1)}}

  /* ---- hero ----------------------------------------------------------- */
  .bg-hero{padding:clamp(54px,11vw,110px) 0 36px;text-align:center}
  .bg-eyebrow{font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--rose);font-weight:700;margin:0 0 14px}
  .bg-h1{font-size:clamp(2.5rem,8.5vw,5rem);line-height:.97;margin:0 0 20px;font-weight:900;letter-spacing:-.03em;text-wrap:balance}
  .bg-h1 .w{display:block}
  .bg-h1 .grad{background:linear-gradient(100deg,#ff4d6d,#ff9f1c 28%,#ffd166 46%,#2ec4b6 68%,#4cc9f0 86%,#b16cff);
    -webkit-background-clip:text;background-clip:text;color:transparent;background-size:260% auto;animation:shimmer 7s linear infinite}
  @keyframes shimmer{to{background-position:260% center}}
  .bg-lede{max-width:62ch;margin:0 auto 34px;color:var(--dim);font-size:clamp(1rem,2.4vw,1.16rem);line-height:1.72}

  .bg-startcard{max-width:720px;margin:0 auto;text-align:left;border-radius:20px;padding:4px;
    background:linear-gradient(135deg,#ff4d6d,#ff9f1c,#2ec4b6,#4cc9f0,#b16cff);background-size:300% 300%;
    animation:borderflow 9s ease infinite;box-shadow:0 26px 70px rgba(0,0,0,.6)}
  @keyframes borderflow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
  .bg-starthead{padding:16px 20px 13px;font-weight:800;font-size:.95rem;letter-spacing:.01em;
    background:var(--panel);border-radius:17px 17px 0 0;display:flex;align-items:center;gap:9px}
  .spark{color:#ffd166;animation:spin 5s linear infinite;display:inline-block}
  @keyframes spin{to{transform:rotate(360deg)}}
  .bg-startfirst{margin:0;padding:13px 20px 14px;background:var(--panel);color:var(--dim);
    font-size:.95rem;line-height:1.6;border-top:1px solid var(--line)}
  .bg-startfirst b{color:var(--ink)}
  .bg-startfirst a{display:inline-block;margin-top:6px;color:var(--amber);text-decoration:none;font-weight:600}
  .bg-startfirst a:hover{text-decoration:underline}
  .bg-startlist{list-style:none;margin:0;padding:0 20px 18px;background:var(--panel);border-radius:0 0 17px 17px}
  .bg-startlist li{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;padding:11px 0;border-top:1px solid var(--line)}
  .bg-startlist li span{color:var(--dim);font-size:.93rem}

  /* ---- command chips --------------------------------------------------- */
  .cmd{font-family:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;font-size:.84rem;font-weight:600;
    background:rgba(255,255,255,.07);border:1px solid var(--line);color:#ffd9e2;
    padding:.3em .6em;border-radius:7px;white-space:nowrap;display:inline-block;transition:transform .18s,box-shadow .18s,border-color .18s}
  .cmd.good{color:#8ef0c8;border-color:rgba(46,196,182,.3);background:rgba(46,196,182,.09);white-space:normal}
  .cmd.inline{white-space:normal}
  .cmd:hover{transform:translateY(-2px);border-color:var(--a);box-shadow:0 6px 18px rgba(0,0,0,.45)}

  /* ---- sticky nav ------------------------------------------------------ */
  /* The site header is position:fixed at top:0, so this bar has to sit below
     it or it is hidden underneath. --hdr is measured at runtime (the header
     is 81px wide-screen, 65px on a phone, and transitions on scroll); the
     fallback here keeps it correct before the script runs. */
  .bg-nav{position:sticky;top:var(--hdr,81px);z-index:40;backdrop-filter:blur(14px);
    background:rgba(10,8,16,.82);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .bg-navinner{max-width:1020px;margin:0 auto;display:flex;gap:7px;overflow-x:auto;padding:11px 18px;
    scrollbar-width:none}
  .bg-navinner::-webkit-scrollbar{display:none}
  .bg-navinner a{flex:0 0 auto;display:flex;align-items:center;gap:7px;padding:8px 14px;border-radius:999px;
    font-size:.84rem;font-weight:600;color:var(--dim);text-decoration:none;border:1px solid var(--line);
    background:rgba(255,255,255,.03);transition:color .2s,border-color .2s,background .2s,transform .2s;white-space:nowrap}
  .bg-navinner a b{font-size:.72rem;opacity:.65;font-weight:800}
  .bg-navinner a:hover{color:var(--ink);transform:translateY(-2px);border-color:rgba(255,255,255,.22)}
  .bg-navinner a.on{color:#0a0810;background:linear-gradient(100deg,#ff9f1c,#ffd166);border-color:transparent}
  .bg-navinner a.on b{opacity:.75}

  /* ---- sections -------------------------------------------------------- */
  .bg-main{padding-block:46px 72px}
  /* Clear the fixed site header AND this page's own sticky nav when an anchor
     is followed, so a section never lands hidden behind both bars. */
  .bg-sec{scroll-margin-top:calc(var(--hdr,81px) + 74px);margin-bottom:62px}
  .bg-sechead{display:flex;gap:18px;align-items:flex-start;margin-bottom:26px;
    padding-bottom:20px;border-bottom:1px solid var(--line)}
  .bg-num{flex:0 0 auto;font-weight:900;font-size:1.15rem;width:56px;height:56px;border-radius:16px;
    display:grid;place-items:center;color:#0a0810;background:var(--a);
    box-shadow:0 10px 30px color-mix(in srgb,var(--a) 45%,transparent);transition:transform .5s}
  .bg-sec:hover .bg-num{transform:rotate(-8deg) scale(1.07)}
  .bg-sechead h2{margin:4px 0 5px;font-size:clamp(1.5rem,4.2vw,2.1rem);font-weight:800;letter-spacing:-.02em;
    color:var(--a);text-wrap:balance}
  .bg-sechead p{margin:0;color:var(--dim);font-size:.98rem;line-height:1.6}

  .bg-tip{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--a);
    border-radius:14px;padding:18px 20px;margin-bottom:14px;transition:transform .25s,box-shadow .25s,border-color .25s}
  .bg-tip:hover{transform:translateY(-3px);box-shadow:0 18px 44px rgba(0,0,0,.5);border-color:rgba(255,255,255,.16)}
  .bg-tip h3{margin:0 0 8px;font-size:1.06rem;font-weight:700;display:flex;gap:9px;align-items:baseline}
  .bg-tick{color:var(--a);font-size:.8em}
  .bg-tip p{margin:0 0 12px;color:var(--dim);line-height:1.72;font-size:.97rem}
  .bg-label{display:inline-block;font-size:.66rem;letter-spacing:.17em;text-transform:uppercase;
    font-weight:800;color:var(--a);margin-bottom:9px}
  .bg-chips{display:flex;flex-direction:column;gap:7px;align-items:flex-start}
  /* Two plain rules in place of a four-row table whose other two rows had
     nothing to warn about. */
  .bg-rules{list-style:none;margin:0 0 4px;padding:0;display:flex;flex-direction:column;gap:10px}
  .bg-rules li{padding:12px 15px;border-radius:11px;background:var(--panel2);
    border:1px solid var(--line);border-left:3px solid var(--a);color:var(--dim);line-height:1.7;font-size:.96rem}
  .bg-rules b{color:var(--ink);display:block;margin-bottom:3px}
  .bg-rules .ok,.bg-rules .no{font-family:'JetBrains Mono',monospace;font-size:.86em;
    padding:.12em .45em;border-radius:5px;white-space:nowrap}
  .bg-rules .ok{color:#8ef0c8;background:rgba(46,196,182,.12)}
  .bg-rules .no{color:#ff8098;background:rgba(255,77,109,.12)}
  .bg-warn{margin:12px 0 0 !important;padding:9px 13px;border-radius:9px;font-size:.9rem !important;
    background:rgba(255,77,109,.1);border:1px solid rgba(255,77,109,.25);color:#ffc2cd !important}

  .bg-sub{margin:30px 0 6px;font-size:1.14rem;font-weight:800;display:flex;gap:9px;align-items:baseline}
  .bg-subp{margin:0 0 16px;color:var(--dim);line-height:1.7}

  .bg-steps{list-style:none;margin:0 0 8px;padding:0;counter-reset:s}
  .bg-steps li{display:flex;gap:14px;padding:13px 16px;margin-bottom:9px;border-radius:12px;
    background:var(--panel);border:1px solid var(--line);line-height:1.7;color:var(--dim);font-size:.97rem;
    transition:transform .22s,border-color .22s}
  .bg-steps li:hover{transform:translateX(4px);border-color:var(--a)}
  .bg-steps li b{color:var(--ink)}
  .bg-stepn{flex:0 0 auto;width:28px;height:28px;border-radius:9px;display:grid;place-items:center;
    font-weight:800;font-size:.84rem;color:#0a0810;background:var(--a)}

  .bg-note{background:var(--panel2);border:1px solid var(--line);border-radius:13px;
    padding:15px 18px;margin:14px 0;color:var(--dim);line-height:1.74;font-size:.96rem}
  .bg-note b{color:var(--ink)}
  .bg-note a{color:var(--a);text-underline-offset:3px}
  .bg-note.alert{border-color:rgba(255,159,28,.34);background:rgba(255,159,28,.07)}
  .bg-note.tip{border-color:rgba(76,201,240,.3);background:rgba(76,201,240,.06)}

  /* ---- tables ----------------------------------------------------------- */
  .bg-tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--panel);
    margin:6px 0 2px}
  table{border-collapse:collapse;width:100%;min-width:34rem;font-size:.94rem}
  th{text-align:left;font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;font-weight:800;
    padding:13px 16px;color:#0a0810;background:var(--a);white-space:nowrap}
  td{padding:12px 16px;border-top:1px solid var(--line);color:var(--dim);line-height:1.65;vertical-align:top}
  tbody tr{transition:background .2s}
  tbody tr:hover{background:rgba(255,255,255,.035)}
  .bg-cmdtable td:first-child{white-space:nowrap}
  /* A linked cell holds one chip per destination; they wrap on a phone. */
  .bg-lnks{display:flex;flex-wrap:wrap;gap:6px}
  a.cmd.lnk{text-decoration:none;color:var(--a);border-color:color-mix(in srgb,var(--a) 34%,transparent);
    background:color-mix(in srgb,var(--a) 10%,transparent);white-space:nowrap}
  a.cmd.lnk::after{content:' \2192';opacity:.6}
  a.cmd.lnk:hover{background:color-mix(in srgb,var(--a) 20%,transparent);border-color:var(--a)}
  .bg-chartable td.muted{color:var(--faint)}
  .bg-chartable td.bad{color:#ff8098;font-weight:600}
  .bg-chartable td.good{color:#6ee7b7;font-weight:600}

  /* ---- footer ------------------------------------------------------------ */
  .bg-foot{margin-top:54px;padding-top:30px;border-top:1px solid var(--line);text-align:center}
  .bg-wheretitle{margin:0 0 16px;font-size:1.1rem;font-weight:800;color:var(--ink)}
  .bg-footlinks{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;
    margin-bottom:26px;text-align:left}
  .bg-footlinks a{display:flex;flex-direction:column;gap:5px;padding:15px 18px;border-radius:14px;
    text-decoration:none;background:var(--panel);border:1px solid var(--line);
    transition:transform .22s,border-color .22s,box-shadow .22s}
  .bg-footlinks a:hover{transform:translateY(-4px);border-color:var(--rose);box-shadow:0 16px 40px rgba(0,0,0,.5)}
  .bg-footlinks b{color:var(--ink);font-size:.95rem}
  .bg-footlinks span{color:var(--dim);font-size:.86rem;line-height:1.6}
  .bg-footsite{display:inline-block;font-size:clamp(1.3rem,4.5vw,1.9rem);font-weight:900;letter-spacing:-.02em;
    text-decoration:none;background:linear-gradient(100deg,#ff4d6d,#ff9f1c,#2ec4b6,#4cc9f0);
    background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;
    animation:shimmer 6s linear infinite}

  /* ---- reveal animation --------------------------------------------------- */
  .reveal{opacity:0;transform:translateY(26px);
    transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1);
    transition-delay:calc(var(--d,0) * 85ms)}
  .reveal.in{opacity:1;transform:none}

  @media (max-width:640px){
    .bg-sechead{gap:13px}
    .bg-num{width:46px;height:46px;font-size:1rem;border-radius:13px}
    .bg-steps li{padding:12px 13px;gap:11px}
    .bg-footlinks a{min-width:0;flex:1 1 140px}
    .bg-tip{padding:16px 15px}

    /* A two-column command table forces sideways scrolling on a phone, which
       is where most members will read this. Stack each row into a card so the
       description sits under its command and the page reads straight down. */
    .bg-cmdtable{min-width:0;display:block}
    .bg-cmdtable thead{display:none}
    .bg-cmdtable tbody,.bg-cmdtable tr,.bg-cmdtable td{display:block;width:100%}
    .bg-cmdtable tr{padding:13px 15px;border-top:1px solid var(--line)}
    .bg-cmdtable tbody tr:first-child{border-top:0}
    .bg-cmdtable td{border:0;padding:0}
    .bg-cmdtable td:first-child{white-space:normal;margin-bottom:7px}
    .bg-cmdtable td:last-child{font-size:.92rem}

    /* The do/don't table stays a real table — the comparison is the point —
       but it no longer needs to be as wide. */
    .bg-chartable{min-width:22rem;font-size:.86rem}
    .bg-chartable th,.bg-chartable td{padding:10px 12px}
  }

  /* People who ask for less motion get a static page: every drifting orb,
     shimmer and reveal is switched off rather than merely shortened. */
  @media (prefers-reduced-motion:reduce){
    .orb,.spark,.bg-h1 .grad,.bg-startcard,.bg-footsite{animation:none !important}
    .reveal{opacity:1 !important;transform:none !important;transition:none !important}
    *{transition-duration:.01ms !important}
  }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var page = document.querySelector('.bg-page');

    // The site header is fixed at top:0 and changes height between breakpoints
    // (and while scrolling). Measure it instead of hardcoding, so the sticky
    // section nav always parks directly beneath it rather than under it.
    var siteHeader = null;
    document.querySelectorAll('header, nav, [class*="header"]').forEach(function (el) {
      if (siteHeader || page.contains(el)) return;
      if (getComputedStyle(el).position === 'fixed') siteHeader = el;
    });
    function syncHeader() {
      var h = siteHeader ? Math.round(siteHeader.getBoundingClientRect().height) : 81;
      if (h > 0 && h < 200) page.style.setProperty('--hdr', h + 'px');
    }
    syncHeader();
    window.addEventListener('resize', syncHeader, { passive: true });
    if (siteHeader && 'ResizeObserver' in window) {
      new ResizeObserver(syncHeader).observe(siteHeader);
    }

    // Reveal on scroll. Without IntersectionObserver everything is shown at once
    // rather than left invisible.
    var items = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('in'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
      items.forEach(function (el) { io.observe(el); });
    }

    // Sticky-nav state. Declared here because the scroll handler below clears
    // the active pill once the reader scrolls back above the first section.
    var links = {};
    document.querySelectorAll('[data-navlink]').forEach(function (a) {
      links[a.getAttribute('data-navlink')] = a;
    });
    var secs = document.querySelectorAll('.bg-sec[id]');
    var firstSec = secs[0] || null;
    var current = null;
    function clearNav() {
      if (current === null) return;
      current = null;
      for (var k in links) links[k].classList.remove('on');
    }

    // Scroll progress bar.
    var bar = document.getElementById('bgProgress');
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var h = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
        // Above the first section nothing should read as current.
        if (firstSec && firstSec.getBoundingClientRect().top > 140) clearNav();
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Highlight the section currently in view in the sticky nav, and keep that
    // pill scrolled into view on narrow screens.
    if ('IntersectionObserver' in window && secs.length) {
      var navIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var id = e.target.id;
          if (id === current) return;
          current = id;
          for (var k in links) links[k].classList.toggle('on', k === id);
          var a = links[id];
          if (a && a.parentNode.scrollWidth > a.parentNode.clientWidth) {
            a.parentNode.scrollTo({
              left: a.offsetLeft - a.parentNode.clientWidth / 2 + a.clientWidth / 2,
              behavior: reduce ? 'auto' : 'smooth',
            });
          }
        });
      }, {
        // Start the band below the fixed site header plus this page's own nav,
        // so a section counts as current only once it is actually readable.
        rootMargin: '-' + ((siteHeader ? siteHeader.offsetHeight : 81) + 70) + 'px 0px -58% 0px',
        threshold: 0,
      });
      secs.forEach(function (s) { navIo.observe(s); });
    }
  })();
</script>
