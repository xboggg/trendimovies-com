---
import BaseLayout from '../layouts/BaseLayout.astro';

// Content is transcribed from TrendiMovies_Manual.docx (29 Sep 2026). Keep the
// wording in step with that document: this page and the .docx are the same
// manual in two formats, and members are pointed at whichever they open first.

// Private invite links, taken from the bot's own join buttons (handlers.py).
// These are deliberately NOT the public @handles: joins through an invite link
// are attributable, which is the whole point of using them.
const TG = {
  channel: 'https://t.me/+oAFGVNSusvoyMzI0',
  group: 'https://t.me/+vtOF1f_KsjY4Yjk0',
  infohub: 'https://t.me/+kIZn-UymRDE4OTFk',
};

const quickStart = [
  { cmd: '/m avengers endgame', desc: 'Search for a movie by name.' },
  { cmd: '/s blacklist', desc: 'Search for a series by name.' },
  { cmd: '/request <title>', desc: 'Ask us to add a movie or series we do not have yet.' },
  { cmd: '/discovery', desc: 'Browse the library when you do not know what you want.' },
  { cmd: '/commands', desc: 'The full command list, inside the bot.' },
];

const searchTips = [
  {
    h: 'Always start with /m or /s',
    p: 'Use /m for a movie, or /s for a series, then the name:',
    ex: ['/m avatar', '/s blacklist'],
    warn: 'If you send only the name, with no /m or /s in front, the bot will not reply.',
  },
  {
    h: 'Send the name only',
    // The .docx says "misspellings are fine — the bot will suggest the right
    // one". Verified 2026-10-07 and that overpromises: spell correction runs
    // against get_all_clean_titles(limit=10000), ordered newest-first, so it
    // only covers the 10,000 most recent of 701,287 distinct titles — nothing
    // before 2017. Misspelling Inception or Shawshank gets no correction even
    // though both are in the catalogue.
    p: 'After the command, give the title and nothing else. Do not add words like download, eng sub, kdrama, series, season, anime or drama. Small misspellings are fine — the bot works out what you meant and either shows those results straight away, or offers the closest titles as buttons to tap.',
    label: 'Correct',
    ex: ['/m avengers endgame   (no colon or punctuation needed)', '/m terminator', '/m the runner'],
  },
  {
    h: 'Narrow a movie by year or quality',
    p: 'Add the year, the quality, or both — after the name.',
    label: 'Examples',
    ex: [
      '/m avatar   (every version we have)',
      '/m avatar 2009   (that year only — useful when remakes share a name)',
      '/m avatar 720p   (that quality only)',
      '/m avatar 1080p   (higher quality, larger file)',
      '/m avatar 2009 720p   (year and quality together)',
    ],
  },
  {
    h: 'Want one season of a series?',
    p: 'Add S01, S02 and so on. The S stands for Season and the number is the season — and that is a ZERO, not the letter O. Put the name first: starting with the season number tends to pull up other shows.',
    label: 'Examples',
    ex: [
      '/s game of thrones s01   (season 1)',
      '/s game of thrones s1   (short form works too)',
      '/s stranger things S01',
    ],
  },
  {
    h: 'Want one specific episode?',
    p: 'Add S01E01. The E stands for Episode — again a ZERO, not the letter O.',
    label: 'Examples',
    ex: [
      '/s game of thrones s01e02   (season 1, episode 2)',
      '/s game of thrones s1e2   (short form works too)',
      '/s stranger things S01E01',
      '/s S01E01 stranger things   (episode first)',
    ],
  },
  {
    h: 'Want a specific quality of a series?',
    p: 'Put the quality on the end — alone, or with a season or episode.',
    label: 'Examples',
    ex: [
      '/s stranger things 720p',
      '/s stranger things S01 720p   (whole season, that quality)',
      '/s stranger things S01E03 720p   (one episode, that quality)',
    ],
  },
  {
    h: 'Anime with no seasons',
    p: 'Many anime run straight from episode 1 to 1000 with no season numbers. Try the name and the episode number on its own — it works when the file was named that way. If nothing comes back, the file is probably filed under a season, so try the S01E form with the same number.',
    label: 'Examples',
    ex: ['/m naruto 071', '/s one piece s01e1109   (when the bare number finds nothing)'],
  },
];

// Tested against the live search: punctuation is stripped before the query
// reaches the index, so typing it changes nothing. What DOES break a search is
// closing a hyphen up into one word, or spelling an ampersand out as "and".
const tgSteps = [
  { lead: 'Search.', text: 'Send /m and the movie name, or /s and the series name.' },
  { lead: 'Pick the title.', text: 'Tap the one you want from the results.' },
  { lead: 'Pick the quality.', text: 'You will see the sizes and qualities we hold — 480p, 720p, 1080p or 4K. A bigger file means better video quality.' },
  { lead: 'The file appears in the Request Group.', text: 'No queue, no waiting room, no link to open — it is posted straight into the group you joined.' },
  { lead: 'Forward it to your DM, then download.', text: 'Forward the file to your Saved Messages — or any chat of your own — and download it from there. Files are cleared from the group after a while to keep it tidy, so forwarding is what keeps your copy.' },
  { lead: 'Play it with VLC.', text: "Some files use formats a phone's built-in player cannot open. VLC Media Player (videolan.org) is free, plays everything, and is on Android, iPhone, Windows and Mac." },
];

const webSteps = [
  { lead: 'Stream it on the site.', text: 'Where a source exists, press Watch and it plays in your browser — nothing to download at all. Not offered on every title.' },
  { lead: 'Download directly from the website.', text: 'Use the direct download link on the page and the file saves straight to your device, the normal way a browser downloads anything.' },
  { lead: 'Send it to Telegram.', text: "Use the Telegram download button and our delivery bot sends you the file. Save it with Telegram's download arrow." },
];

// Sections 03-10 are all command/reference tables, so they share one shape.
const tableSections = [
  {
    n: '03', id: 'dates', title: 'Release dates & schedule', hue: 'gold',
    sub: 'Knowing when something is due, so you are not searching for a file that does not exist yet.',
    note: { lead: 'What a digital release date actually means.', text: 'A film opens in cinemas, then later reaches streaming. The digital release date is the day the proper HD copy is DUE — the real quality file, rather than the poor camera recordings that circulate before it. It is a calendar of what is coming, exactly like a cinema release schedule. It does not mean the file is here yet.' },
    head: ['Command', 'What it does'],
    rows: [
      ['/digitalrelease', 'Films whose digital release has been announced for the next 90 days — the day a proper HD copy is DUE, not the day it arrives. Seven at a time; tap one to Track it.'],
      ['/schedule', 'The full release calendar, day by day, covering what is coming across the months ahead.'],
      ['/upcoming', 'Films not yet released at all. Tap Track on one and you are messaged on the day it becomes available — no need to keep checking back.'],
      ['/notify <title>', 'Watches one specific title for you and messages you the moment it is added.'],
    ],
  },
  {
    n: '04', id: 'commands', title: 'Search commands', hue: 'magenta',
    sub: 'The full set. Every search starts with a command — a title typed on its own does nothing.',
    head: ['Command', 'What it does'],
    rows: [
      ['/m <title>', 'Main search across movies and series. The command you will use most. e.g. /m avengers endgame'],
      ['/s <title>', 'Series only. Use it when a show shares its name with a film, or to go straight to a season or episode. e.g. /s blacklist'],
      ['/quality <title>', 'Every quality we hold for one title side by side with file sizes, so you can choose before downloading. For a series it lists each episode’s qualities. e.g. /quality oppenheimer'],
      ['/similar <title>', 'Give it something you liked and it suggests what people who watched it went on to watch — then shows only the ones we actually hold. e.g. /similar inception'],
      ['/year <year> [title]', 'Browse a single year three ways: /year 2024 for that year’s top picks, /year 2024 action for one genre, or /year 2024 dune to search a title inside it — useful when a remake shares a name.'],
      ['/range <from-to> <title>', 'Restricts results to a span of years. e.g. /range 2020-2023 action'],
      ['/size <limit> <title>', 'Hides anything above a file size you set — useful on limited data. e.g. /size 1gb inception'],
      ['/request <title>', 'Asks us to add a movie or series we do not have. It joins a real queue and you are messaged when it lands. e.g. /request the batman'],
      ['/compare <a> vs <b>', 'Puts two titles side by side. e.g. /compare avatar vs inception'],
    ],
  },
  {
    n: '05', id: 'discover', title: 'Discover', hue: 'orange',
    sub: '/discovery opens one visual menu covering the main tiles — or type any command directly.',
    note: { lead: 'These lists clear themselves, and they are yours.', text: 'Any browsing list — Discovery, Trending, New Files, Upcoming, Top 100, Hidden Gems, Surprise Me, Digital Releases, the Schedule — deletes itself after about two minutes to keep the group tidy, so it has not broken if it vanishes while you are reading. Only the person who ran the command can page through it; if you tap Next on someone else\'s list the bot will tell you to run your own. Send the command again for a fresh one.' },
    head: ['Command', 'What it does'],
    rows: [
      ['/discovery', 'The Discovery Hub — one tap-through menu covering New Files, Trending, Upcoming, Top 100, Digital Releases, the Schedule, Surprise Me, Hidden Gems, Nollywood and Franchises. Start here when you do not know what you want.'],
      ['/trending', 'The most-viewed titles on the website right now, counted from real visits rather than a chart copied from elsewhere. Anything we cannot actually deliver is left out.'],
      ['/newfiles', 'The most recent additions, newest first. Asks whether you want Movies, Series or Everything, then lists them.'],
      ['/topmovies', 'The 100 best-rated films of any single year from 1990 to today. Pick a year and browse it.'],
      ['/hiddengems', 'Titles with high ratings but little attention — good when the obvious choices are exhausted.'],
      ['/surpriseme', 'One random title from the whole library. Open Details for the plot and rating first, or re-roll as often as you like.'],
      ['/genres', 'Browse by genre — Action, Comedy, Drama and the rest — or switch to browsing by mood instead: Happy, Scared, Romantic.'],
      ['/franchise', 'Whole film universes laid out in the correct watch order, so you know what to see first.'],
      ['/nollywood', 'Nigerian cinema, filtered by Drama, Comedy, Action, Romance or Thriller.'],
      ['/director <name>', 'Every film we hold by one director. e.g. /director christopher nolan'],
      ['/actor <name>', 'Every film we hold starring one actor. e.g. /actor tom cruise'],
    ],
  },
  {
    n: '06', id: 'profile', title: 'Your profile', hue: 'teal',
    sub: '/profile opens one menu covering all of this — or type each command directly.',
    head: ['Command', 'What it does'],
    rows: [
      ['/profile', 'Your Profile Hub — everything in this section in one place.'],
      ['/stats', 'How many searches and downloads you have made, and the date you joined.'],
      ['/history <title>', 'Full details for one film from TMDB — cast, crew and ratings. Needs a title: /history inception'],
      ['/myhistory', 'Your own recent searches, so you can return to something without retyping it.'],
      ['/diary', 'A running log of every title you have downloaded — useful for remembering what you already have.'],
      ['/points', 'Your points balance and level. Points come from searching, downloading, checking in and inviting friends.'],
      ['/badges', 'Badges you have earned and the ones still to unlock, with what each one needs.'],
      ['/collections', 'Themed challenges — Action, Classic, DC, Horror, Marvel and Sci-Fi. Work through a set to fill it in and earn its badge; shows how far along you are on each.'],
      ['/streak', 'Your current and longest run of consecutive days. Search on any day to keep it alive.'],
      ['/checkin', "Claim today's reward. Checking in on consecutive days pays more each time."],
      ['/leaderboard', 'The top 20 members by points, counted all-time rather than reset weekly.'],
      ['/invite', 'Your personal invite link. You earn points for every friend who joins through it.'],
      ['/share <title>', 'Builds a shareable card for any title — poster, rating and plot — ready to forward to a friend.'],
    ],
  },
  {
    n: '07', id: 'fun', title: 'Fun', hue: 'purple',
    sub: 'A little extra for the regulars. Both reset every day.',
    head: ['Command', 'What it does'],
    rows: [
      ['/quotes', 'The daily quote challenge — a line from a film, and you name it.'],
      ['/trivia', 'The daily trivia challenge — one question, multiple choice.'],
    ],
  },
  {
    n: '08', id: 'settings', title: 'Settings & help', hue: 'slate',
    sub: 'Housekeeping, and where to find help without leaving the bot.',
    head: ['Command', 'What it does'],
    rows: [
      ['/settings', 'Your preferences, including whether you receive the weekly digest.'],
      ['/help', 'Short help panels for the main features.'],
      ['/guide', 'The same manual as this page, but inside Telegram. Not to be confused with Guides on the website, which are hand-picked lists of what to watch.'],
      ['/commands', 'This entire command list, on your phone, always current.'],
      ['/about', 'Live numbers — how many titles we hold, searches made today, members active.'],
      ['/start', 'Starts or re-initialises the bot. Also what opens when someone uses your invite link.'],
    ],
  },
  {
    n: '09', id: 'channel', title: 'In the Channel', hue: 'pink',
    sub: 'You do not have to ask for any of this. Join the Channel and it arrives on its own.',
    head: ['When', 'What arrives'],
    // Only rows backed by an ACTIVE cron on srv 38. Daily Picks, Trending Now,
    // This Day in Cinema, Trailer of the Day, New Releases, Weekend Watchlist,
    // Weekend Binge and Family Movie Night were all disabled on 2026-09-30 and
    // must not be promised here until their cron lines are re-enabled.
    rows: [
      ['Every morning', 'Movie News — what is happening in film today.'],
      ['Every midday', 'Actor Birthday — who was born today, and which of their films we hold.'],
      ['Mon · Wed · Fri', 'Movie Trivia in the Channel.'],
      ['Wednesday', 'New Episodes — every series that gained episodes this week. Plus the Anime Spotlight.'],
      ['Thursday', 'Before They Were Famous — early roles of people you know now.'],
      ['Sunday', 'Box Office results, Top 10 by Genre, and a Director Spotlight.'],
      ['Weekly', 'Your personal digest — switch it on or off in /settings.'],
    ],
  },
  {
    n: '10', id: 'website', title: 'On the website', hue: 'cyan',
    sub: 'trendimovies.com — the same library, with covers, cast and plot.',
    head: ['Where', 'What you get'],
    // Third element, where present, turns the first cell into real links.
    // Watch and Subtitles have none on purpose: both are controls on an
    // individual title's page, not destinations of their own (/watch and
    // /subtitles both 404).
    rows: [
      ['Movies & Series', 'The full catalogue with posters, cast, ratings and plot, and every quality we hold listed with its file size.',
        [['Movies', '/movies'], ['Series', '/series']]],
      ['Watch', 'Play a title in your browser where a source exists, instead of downloading it. Not available on every title.'],
      ['Discovery', 'Browse visually instead of typing — genres, curated universes, franchises, and themed categories like Anime, K-Drama, Bollywood, Marvel and DC.',
        [['Franchises', '/franchises'], ['Universes', '/universe']]],
      ['Digital Releases', 'The calendar of dates HD copies are due, so you know when a proper quality file is expected.',
        [['Digital Releases', '/digital-releases']]],
      ['Blog & Reviews', 'Written pieces and full reviews, updated regularly.',
        [['Blog', '/blog'], ['Reviews', '/reviews']]],
      ['Guides', 'Hand-picked lists for choosing what to watch next, grouped By Mood, By Decade and Hidden Gems — tearjerkers, feel-good films, mind-benders and the best of a decade. About what to watch, not how to use the bot.',
        [['Guides', '/guides']]],
      ['Request', 'The same request queue as the bot, from a web form, if you would rather not use Telegram.',
        [['Request', '/request']]],
      ['Subtitles', 'Where subtitles exist for a title, they are offered next to the download.'],
    ],
  },
];

const navItems = [
  { id: 'search', n: '01', label: 'How to search' },
  { id: 'download', n: '02', label: 'How to download' },
  ...tableSections.map((s) => ({ id: s.id, n: s.n, label: s.title })),
];

const pageTitle = 'TrendiMovies Bot Guide';
const pageDesc = 'How to search, download and get the most out of the TrendiMovies Telegram bot — every command explained, with examples.';
---

<BaseLayout title={pageTitle} description={pageDesc} image="/images/bot-guide-cover.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <div class="bg-scroll-progress"><i id="bgProgress"></i></div>

  <div class="bg-page">
    <!-- animated background -->
    <div class="bg-aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="orb o2"></span>
      <span class="orb o3"></span>
      <span class="orb o4"></span>
      <span class="bg-grid"></span>
    </div>

    <!-- hero -->
    <header class="bg-hero">
      <div class="bg-wrap">
        <p class="bg-eyebrow reveal">Telegram Bot · Member Guide</p>
        <h1 class="bg-h1">
          <span class="w reveal" style="--d:0">TrendiMovies</span>
          <span class="w reveal grad" style="--d:1">Bot Guide</span>
        </h1>
        <p class="bg-lede reveal" style="--d:2">
          Thousands of movies and series, delivered inside Telegram. No waiting rooms, no link
          shorteners, no countdowns — search, tap your quality, and the file is yours. Can't find a
          movie or series? Request it, and we will message you the moment it lands.
        </p>

        <div class="bg-startcard reveal" style="--d:3">
          <div class="bg-starthead"><span class="spark">★</span> Start here — these cover almost everything</div>
          <p class="bg-startfirst">
            <b>First, join the Request Group.</b> That is where you search and where your file
            arrives, so everything below happens there.
            <a href={TG.group} target="_blank" rel="noopener">Join the Request Group →</a>
          </p>
          <ul class="bg-startlist">
            {quickStart.map((q, i) => (
              <li class="reveal" style={`--d:${i}`}>
                <code class="cmd">{q.cmd}</code>
                <span>{q.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </header>

    <!-- sticky section nav -->
    <nav class="bg-nav" id="bgNav" aria-label="Sections">
      <div class="bg-navinner">
        {navItems.map((it) => (
          <a href={`#${it.id}`} data-navlink={it.id}><b>{it.n}</b>{it.label}</a>
        ))}
      </div>
    </nav>

    <main class="bg-wrap bg-main">

      <!-- 01 how to search -->
      <section class="bg-sec hue-rose" id="search">
        <div class="bg-sechead reveal">
          <span class="bg-num">01</span>
          <div>
            <h2>How to search</h2>
            <p>Get this right and you will find almost anything on the first try.</p>
          </div>
        </div>

        {searchTips.map((t, i) => (
          <article class="bg-tip reveal" style={`--d:${i % 3}`}>
            <h3><span class="bg-tick">▸</span>{t.h}</h3>
            <p>{t.p}</p>
            {t.label && <span class="bg-label">{t.label}</span>}
            <div class="bg-chips">
              {t.ex.map((e) => <code class="cmd good">{e}</code>)}
            </div>
            {t.warn && <p class="bg-warn">{t.warn}</p>}
          </article>
        ))}

        <article class="bg-tip reveal">
          <h3><span class="bg-tick">▸</span>Punctuation takes care of itself</h3>
          <p>
            Type the title exactly as it is written. Apostrophes, colons, hyphens and
            ampersands are all ignored by the search, so putting them in or leaving them out
            makes no difference — <code class="cmd inline">Raven's Home</code> and
            <code class="cmd inline">Ravens Home</code> find the same thing.
          </p>
          <p>Only two things trip it up:</p>
          <ul class="bg-rules">
            <li>
              <b>Do not join a hyphenated name into one word.</b>
              <span class="ok">Grown-ish</span> and <span class="ok">Grown ish</span> both work
              — <span class="no">Grownish</span> finds nothing.
            </li>
            <li>
              <b>Do not spell an ampersand out as “and”.</b>
              <span class="ok">Tom &amp; Jerry</span> finds the film —
              <span class="no">Tom and Jerry</span> brings back the wrong one.
            </li>
          </ul>
        </article>

        <div class="bg-note reveal">
          <b>Dots are the exception — they are fine.</b> Release files are normally named with dots
          between the words, the year and the quality, so a search like
          <code class="cmd inline">avengers.endgame.2019.1080p</code> still works. It is the other
          symbols that cause misses.
        </div>
        <div class="bg-note reveal">
          <b>Still nothing?</b> Try fewer words. Then try the other word order. Then check the
          spelling of the name only — not the year. If it still does not appear we probably do not
          have it yet: send <code class="cmd inline">/request</code> and the title, and you will be
          messaged when it lands.
        </div>
      </section>

      <!-- 02 how to download -->
      <section class="bg-sec hue-amber" id="download">
        <div class="bg-sechead reveal">
          <span class="bg-num">02</span>
          <div>
            <h2>How to download</h2>
            <p>Two places to start — inside Telegram, or on the website.</p>
          </div>
        </div>

        <div class="bg-note alert reveal">
          <b>Before you search in Telegram: join the Request Group.</b> Searches and files happen in
          the group, so you must be a member before you can download there —
          <a href={TG.group} target="_blank" rel="noopener">join the Request Group</a>.
          Join once and you are set.
        </div>

        <h3 class="bg-sub reveal"><span class="bg-tick">▸</span>Downloading from Telegram</h3>
        <p class="bg-subp reveal">The quickest route. You never leave the app.</p>
        <ol class="bg-steps">
          {tgSteps.map((s, i) => (
            <li class="reveal" style={`--d:${i % 3}`}>
              <span class="bg-stepn">{i + 1}</span>
              <div><b>{s.lead}</b> {s.text}</div>
            </li>
          ))}
        </ol>

        <h3 class="bg-sub reveal"><span class="bg-tick">▸</span>Downloading from the website</h3>
        <p class="bg-subp reveal">
          Better when you want to browse with posters, cast and plot before deciding. Open the title
          on trendimovies.com and you have three ways to watch it:
        </p>
        <ol class="bg-steps">
          {webSteps.map((s, i) => (
            <li class="reveal" style={`--d:${i}`}>
              <span class="bg-stepn">{i + 1}</span>
              <div><b>{s.lead}</b> {s.text}</div>
            </li>
          ))}
        </ol>

        <div class="bg-note reveal">
          <b>Which should I use?</b> Streaming is fastest if you only want to watch once. The direct
          download suits a laptop. The Telegram route suits a phone, and keeps the file in an app you
          already have. The website route is the shortest — the file comes straight to you.
        </div>
        <div class="bg-note tip reveal">
          <b>Two free tools that make this much better.</b> For streaming, use
          <a href="https://brave.com" target="_blank" rel="noopener">Brave browser</a> — it blocks the
          pop-ups and redirect ads that ruin playback elsewhere. For anything you download, use
          <a href="https://videolan.org" target="_blank" rel="noopener">VLC Media Player</a> — it opens
          formats the default phone player often refuses. Both are free and take a minute to install.
        </div>
      </section>

      <!-- 03 - 10 : reference tables -->
      {tableSections.map((s) => (
        <section class={`bg-sec hue-${s.hue}`} id={s.id}>
          <div class="bg-sechead reveal">
            <span class="bg-num">{s.n}</span>
            <div>
              <h2>{s.title}</h2>
              <p>{s.sub}</p>
            </div>
          </div>

          {s.note && (
            <div class="bg-note reveal"><b>{s.note.lead}</b> {s.note.text}</div>
          )}

          <div class="bg-tablewrap reveal">
            <table class="bg-cmdtable">
              <thead><tr><th>{s.head[0]}</th><th>{s.head[1]}</th></tr></thead>
              <tbody>
                {s.rows.map((r, i) => (
                  <tr class="reveal" style={`--d:${i % 4}`}>
                    <td>
                      {r[2]
                        ? <span class="bg-lnks">{r[2].map(([lbl, href]) => (
                            <a class="cmd lnk" href={href}>{lbl}</a>
                          ))}</span>
                        : <code class="cmd">{r[0]}</code>}
                    </td>
                    <td>{r[1]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}

      <div class="bg-note alert reveal">
        <b>If we do not have it yet.</b> Send <code class="cmd inline">/request</code> and the title
        in the bot, or use the Request page on the site. It joins a real queue that people work
        through, and you are messaged the moment it is added — you do not have to keep checking.
      </div>

      <footer class="bg-foot reveal">
        <h3 class="bg-wheretitle">Where to find us</h3>
        <div class="bg-footlinks">
          <a href={TG.group} target="_blank" rel="noopener">
            <b>Request Group</b>
