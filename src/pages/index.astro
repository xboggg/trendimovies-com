---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';
import ContentRow from '../components/ContentRow.svelte';
import FeaturedSection from '../components/FeaturedSection.svelte';
import Collections from '../components/Collections.svelte';
import PickYourMood from '../components/PickYourMood.svelte';
import ContinueWatching from '../components/ContinueWatching.svelte';
import TrendingNowRow from '../components/TrendingNowRow.svelte';
import { getTrendingMovies, getNowPlayingMovies, getPopularMovies, getTopRatedMovies, getTrendingTV, getPopularTV, getOnTheAirTV, discoverMovies, getMovieDetails, getMovieGenres, getTVDetails, searchMovies, fetchFromTMDB } from '../lib/tmdb';
import { getCache as _getCache, setCache as _setCache } from '../lib/cache';
import topMoviesData from '../data/top_movies_by_year.json';

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';

// Fetch latest additions from our database (movies with downloads, sorted by created_at)
async function getLatestAdditions() {
  // "Latest Additions" = recently-acquired recent-release content.
  //   - year filter: only current year + previous year (rolls automatically)
  //   - sort: by movies.updated_at DESC, which a PG trigger bumps whenever a
  //     download_link is inserted/updated. So a movie that gets new files today
  //     surfaces today, even if the row itself was created months ago.
  const currentYear = new Date().getFullYear();
  const minYear = currentYear - 1;
  try {
    const res = await fetch(
      `${POSTGREST_URL}/movies?has_downloads=eq.true&year=gte.${minYear}&order=updated_at.desc&limit=30&select=tmdb_id,title,year,poster_path,backdrop_path,vote_average,vote_count,popularity,overview,updated_at`
    );
    if (!res.ok) return [];
    return await res.json();
  } catch (e) {
    console.error('Failed to fetch latest additions:', e);
    return [];
  }
}

// Fetch "Trending Now" — most-viewed movies based on REAL audience data
// (page_views table, ~4M rows). The rpc/top_viewed_movies function returns
// movies ranked by actual view_count with poster/title/year already joined.
// This is OUR audience's real behaviour, distinct from TMDB's global trending.
async function getMostViewed() {
  try {
    const res = await fetch(`${POSTGREST_URL}/rpc/top_viewed_movies`);
    if (!res.ok) return [];
    return await res.json();
  } catch (e) {
    console.error('Failed to fetch most-viewed movies:', e);
    return [];
  }
}

// Calculate date range for upcoming movies (future releases only - start from tomorrow)
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);
const tomorrowStr = tomorrow.toISOString().split('T')[0];
const threeMonthsLater = new Date(today);
threeMonthsLater.setMonth(threeMonthsLater.getMonth() + 3);
const futureStr = threeMonthsLater.toISOString().split('T')[0];

// Fetch all data from TMDB and our database in parallel
// All TMDB calls wrapped with safe fallbacks so one bad upstream call doesn't 500 the homepage.
const ARR: any = [];
const OBJ: any = { results: [] };
const [trending, nowPlaying, popular, topRatedRecent, upcomingData, trendingTV, popularTV, onTheAirTV, actionMovies, comedyMovies, romanceMovies, thrillerMovies, animeMovies, kDramaMovies, movieGenres, latestAdditions, mostViewed] = await Promise.all([
  getTrendingMovies('week').catch(() => ARR),
  getNowPlayingMovies().catch(() => ARR),
  getPopularMovies().catch(() => ARR),
  discoverMovies({ sort_by: 'vote_average.desc', 'vote_count.gte': '1000', 'primary_release_date.gte': '2015-01-01' }).catch(() => OBJ),
  discoverMovies({
    'primary_release_date.gte': tomorrowStr,
    'primary_release_date.lte': futureStr,
    sort_by: 'popularity.desc'
  }).catch(() => OBJ),
  getTrendingTV('week').catch(() => ARR),
  getPopularTV().catch(() => ARR),
  getOnTheAirTV().catch(() => ARR),
  discoverMovies({ with_genres: '28', sort_by: 'popularity.desc' }).catch(() => OBJ),
  discoverMovies({ with_genres: '35', sort_by: 'popularity.desc' }).catch(() => OBJ),
  discoverMovies({ with_genres: '10749', sort_by: 'popularity.desc' }).catch(() => OBJ),
  discoverMovies({ with_genres: '53', sort_by: 'popularity.desc' }).catch(() => OBJ),
  discoverMovies({ with_genres: '16', with_original_language: 'ja', sort_by: 'vote_average.desc', 'vote_count.gte': '500' }).catch(() => OBJ),
  discoverMovies({ with_original_language: 'ko', sort_by: 'vote_average.desc', 'vote_count.gte': '200' }).catch(() => OBJ),
  getMovieGenres().catch(() => ARR),
  getLatestAdditions().catch(() => ARR),
  getMostViewed().catch(() => ARR)
]);

const upcoming = (upcomingData?.results || []).filter((m: any) => m.poster_path && m.release_date && new Date(m.release_date) > new Date());

// Create a genre map for quick lookup
const genreMap = new Map(movieGenres.map((g: any) => [g.id, g.name]));

// Fetch detailed info for hero carousel items.
// The hero mixes MOVIES + SERIES: top 8 trending movies + top 4 trending series,
// interleaved so series appear throughout the rotation (see heroItems below).
const heroMovieIds = (trending || []).slice(0, 8).map((m: any) => m.id);
const heroDetailsPromises = heroMovieIds.map((id: number) => getMovieDetails(id).catch(() => null));

// Same for series: pull full TV details (genres / tagline / seasons) for the top trending shows.
const heroSeriesIds = (trendingTV || []).slice(0, 4).map((t: any) => t.id);
const heroSeriesDetailsPromises = heroSeriesIds.map((id: number) => getTVDetails(id).catch(() => null));
const _heroSeriesDetailsP = Promise.all(heroSeriesDetailsPromises);

// PERF: kick off all the independent downstream fetches NOW (in parallel) instead
// of awaiting each one sequentially further down. They don't depend on each other,
// only on the main batch above. This collapses ~5 serial round-trips into 1.
const _heroDetailsP    = Promise.all(heroDetailsPromises);
const _imageOverridesP = getCustomImageOverrides();
const _boxOfficeDataP  = getBoxOfficeData();
const _moodGenresP = Promise.all([
  discoverMovies({ with_genres: "10751", sort_by: "vote_average.desc", "vote_count.gte": "200" }),
  discoverMovies({ with_genres: "27", sort_by: "popularity.desc" }),
  discoverMovies({ with_genres: "878", sort_by: "vote_average.desc", "vote_count.gte": "300" }),
  discoverMovies({ with_genres: "18", sort_by: "vote_average.desc", "vote_count.gte": "500" }),
  discoverMovies({ with_original_language: "hi", sort_by: "popularity.desc" }),
  discoverMovies({ with_genres: "16", sort_by: "popularity.desc" }),
  discoverMovies({ with_genres: "36", sort_by: "vote_average.desc", "vote_count.gte": "500" }),
]);

const heroDetails = await _heroDetailsP;
const heroSeriesDetails = await _heroSeriesDetailsP;

// Load custom poster/backdrop overrides — any movie whose poster_path or backdrop_path
// in our DB starts with /images/ overrides TMDB on every section of the homepage.
// (Detail page already does this; homepage sections pull from TMDB so we re-apply here.)
async function getCustomImageOverrides(): Promise<Map<number, { poster_path?: string; backdrop_path?: string }>> {
  const map = new Map<number, { poster_path?: string; backdrop_path?: string }>();
  try {
    const res = await fetch(`${POSTGREST_URL}/movies?or=(poster_path.like.%2Fimages%2F*,backdrop_path.like.%2Fimages%2F*)&select=tmdb_id,poster_path,backdrop_path`);
    if (res.ok) {
      const rows: any[] = await res.json();
      for (const r of rows) {
        if (!r.tmdb_id) continue;
        const entry: { poster_path?: string; backdrop_path?: string } = {};
        if (r.poster_path && r.poster_path.startsWith('/images/')) entry.poster_path = r.poster_path;
        if (r.backdrop_path && r.backdrop_path.startsWith('/images/')) entry.backdrop_path = r.backdrop_path;
        map.set(r.tmdb_id, entry);
      }
    }
  } catch (e) {
    console.error('Failed to load image overrides:', e);
  }
  return map;
}
const imageOverrides = await _imageOverridesP;
function applyOverride(tmdbId: number, posterPath: string | null, backdropPath: string | null) {
  const ov = imageOverrides.get(tmdbId);
  return {
    poster_path: ov?.poster_path ?? posterPath,
    backdrop_path: ov?.backdrop_path ?? backdropPath
  };
}

// Transform for components
function transformMovie(m: any) {
  const ov = applyOverride(m.id, m.poster_path, m.backdrop_path);
  return {
    id: m.id,
    tmdb_id: m.id,
    title: m.title,
    poster_path: ov.poster_path,
    backdrop_path: ov.backdrop_path,
    vote_average: m.vote_average,
    vote_count: m.vote_count,
    popularity: m.popularity,
    year: m.release_date ? new Date(m.release_date).getFullYear() : null,
    release_date: m.release_date || null,
    overview: m.overview,
    genre_ids: m.genre_ids,
    type: 'movie' as const
  };
}

function transformTV(t: any) {
  const ov = applyOverride(t.id, t.poster_path, t.backdrop_path);
  return {
    id: t.id,
    tmdb_id: t.id,
    title: t.name,
    poster_path: ov.poster_path,
    backdrop_path: ov.backdrop_path,
    vote_average: t.vote_average,
    vote_count: t.vote_count,
    popularity: t.popularity,
    year: t.first_air_date ? new Date(t.first_air_date).getFullYear() : null,
    overview: t.overview,
    type: 'series' as const
  };
}

// Transform database movies to component format
function transformDbMovie(m: any) {
  return {
    id: m.tmdb_id,
    tmdb_id: m.tmdb_id,
    title: m.title,
    poster_path: m.poster_path,
    backdrop_path: m.backdrop_path,
    vote_average: m.vote_average || 0,
    vote_count: m.vote_count || 0,
    popularity: m.popularity || 0,
    year: m.year,
    overview: m.overview,
    updated_at: m.updated_at,
    type: 'movie' as const,
    has_downloads: true
  };
}

// Transform hero MOVIE items with full details (tagline, runtime, genres)
const heroMovieItems = (trending || []).slice(0, 8).map((m: any, index: number) => {
  const details = heroDetails[index];
  const ov = applyOverride(m.id, m.poster_path, m.backdrop_path);
  return {
    id: m.id,
    tmdb_id: m.id,
    title: m.title,
    poster_path: ov.poster_path,
    backdrop_path: ov.backdrop_path,
    vote_average: m.vote_average,
    vote_count: m.vote_count,
    popularity: m.popularity,
    year: m.release_date ? new Date(m.release_date).getFullYear() : null,
    overview: m.overview,
    type: 'movie' as const,
    // Full details from API
    tagline: details?.tagline || null,
    runtime: details?.runtime || null,
    release_date: m.release_date || details?.release_date || null,
    genres: details?.genres || (m.genre_ids || []).map((id: number) => ({ id, name: genreMap.get(id) || '' }))
  };
});

// Transform hero SERIES items — same shape, but type 'series' so the carousel
// links to /tv/{id}, shows a "Series" badge, and uses first_air_date for the year.
const heroSeriesItems = (trendingTV || []).slice(0, 4).map((t: any, index: number) => {
  const details = heroSeriesDetails[index];
  const ov = applyOverride(t.id, t.poster_path, t.backdrop_path);
  return {
    id: t.id,
    tmdb_id: t.id,
    title: t.name,
    poster_path: ov.poster_path,
    backdrop_path: ov.backdrop_path,
    vote_average: t.vote_average,
    vote_count: t.vote_count,
    popularity: t.popularity,
    year: t.first_air_date ? new Date(t.first_air_date).getFullYear() : null,
    overview: t.overview,
    type: 'series' as const,
    // Full details from API
    tagline: details?.tagline || null,
    runtime: null,
    release_date: t.first_air_date || details?.first_air_date || null,
    genres: details?.genres || (t.genre_ids || []).map((id: number) => ({ id, name: genreMap.get(id) || '' }))
  };
});

// Interleave movies + series so shows appear THROUGHOUT the rotation, not clustered
// at the end. Pattern: 8 movies + 4 series = 12 slides, a series roughly every 3rd slide.
const heroItems = (() => {
  const out: any[] = [];
  let mi = 0, si = 0;
  // Series slotted every 3rd position: M M S M M S M M S M M S.
  const pattern = ['m', 'm', 's', 'm', 'm', 's', 'm', 'm', 's', 'm', 'm', 's'];
  for (const p of pattern) {
    if (p === 'm' && mi < heroMovieItems.length) out.push(heroMovieItems[mi++]);
    else if (p === 's' && si < heroSeriesItems.length) out.push(heroSeriesItems[si++]);
  }
  // Append any leftovers (in case one list was short) so nothing is dropped.
  while (mi < heroMovieItems.length) out.push(heroMovieItems[mi++]);
  while (si < heroSeriesItems.length) out.push(heroSeriesItems[si++]);
  return out;
})();

const trendingItems = (trending || []).slice(0, 20).map(transformMovie);
const featured = heroItems[0] || null;
const nowPlayingItems = (nowPlaying || []).map(transformMovie);
const popularItems = (popular || []).map(transformMovie);
const topRatedItems = (topRatedRecent?.results || []).slice(0, 20).map(transformMovie);

// Transform latest additions from database
const latestAdditionItems = (latestAdditions || []).map(transformDbMovie);

// "Coming to Digital" reel card. MUST stay consistent with the /digital-releases
// page, so it reads the SAME scraped dvdsreleasedates data (cache keys dvdsrd-2026-N)
// — NOT a separate TMDB query (that mismatch showed movies on the card that weren't
// on the page). Picks the SOONEST strictly-upcoming titles; posters/tmdbId come from
// the same TMDB lookup the page uses (shared dvdsrd-lk2 cache).
const _dToday = new Date();
const _midnight = new Date(_dToday); _midnight.setHours(0, 0, 0, 0);
const _todayISO = _midnight.toISOString().slice(0, 10);
let digitalReleaseItems: any[] = [];
try {
  // The dvdsrd cache (6h TTL) is normally populated by the /digital-releases page.
  // But if it has EXPIRED and nobody visited that page, this reel would go blank and
  // the homepage falls back to "Just Dropped". So scrape-on-miss here too — same
  // regexes + cache keys as the page, so both stay identical & the reel never empties.
  const _SRC = 'https://www.dvdsreleasedates.com';
  const _MONTH_NAMES = ['january','february','march','april','may','june','july','august','september','october','november','december'];
  const _DATE_RE = /class=["']reldate[^>]*>(?:<a[^>]*><\/a>)?([A-Za-z]+day\s+[A-Za-z]+\s+\d{1,2},\s*\d{4})/g;
  const _MOVIE_RE = /href=['"]\/movies\/(\d+)\/([^'"]+)['"]><img[^>]*alt=['"]([^'"]+?)\s+DVD Release Date['"][^>]*src=['"]([^'"]+)['"]/g;
  async function _getOrScrapeMonth(mNum: number): Promise<any[]> {
    const cacheKey = `dvdsrd-2026-${mNum}`;
    const cached = _getCache<any[]>(cacheKey, {});
    if (cached) return cached;
    let html = '';
    try {
      const url = `${_SRC}/digital-releases/2026/${mNum}/digital-hd-releases-${_MONTH_NAMES[mNum - 1]}-2026`;
      const r = await fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120' } });
      if (r.ok) html = await r.text();
    } catch (e) { html = ''; }
    const marks: { date: string; idx: number }[] = [];
    let m: RegExpExecArray | null; _DATE_RE.lastIndex = 0;
    while ((m = _DATE_RE.exec(html))) marks.push({ date: m[1], idx: m.index });
    const groups: any[] = [];
    for (let i = 0; i < marks.length; i++) {
      const chunk = html.slice(marks[i].idx, i + 1 < marks.length ? marks[i + 1].idx : html.length);
      const movies: any[] = []; let mm: RegExpExecArray | null; _MOVIE_RE.lastIndex = 0;
      while ((mm = _MOVIE_RE.exec(chunk))) {
        movies.push({ id: mm[1], slug: mm[2], title: mm[3].replace(/&amp;/g, '&').replace(/&#039;/g, "'").trim() });
      }
      if (!movies.length) continue;
      const d = new Date(marks[i].date);
      groups.push({ date: marks[i].date, iso: isNaN(+d) ? null : d.toISOString().slice(0, 10), movies });
    }
    // Only cache a non-empty scrape, so a transient fetch failure doesn't poison the
    // cache with an empty month for the full TTL.
    if (groups.length) _setCache(cacheKey, {}, groups);
    return groups;
  }
  // Same TMDB poster+id lookup as the page (reuses dvdsrd-lk2-* cache → identical results).
  async function dvdsrdLookup(title: string, year: number): Promise<{ poster: string | null; tmdbId: number | null }> {
    const key = `dvdsrd-lk2-${title}-${year}`.toLowerCase();
    const cached = _getCache<{ poster: string | null; tmdbId: number | null }>(key, {});
    if (cached) return cached;
    let poster: string | null = null, tmdbId: number | null = null;
    try {
      let hit: any = null;
      const r: any = await fetchFromTMDB('/search/movie', { query: title, year: String(year), include_adult: 'false' });
      hit = (r.results || [])[0];
      if (!hit) { const r2: any = await fetchFromTMDB('/search/movie', { query: title, include_adult: 'false' }); hit = (r2.results || [])[0]; }
      if (hit) { tmdbId = hit.id ?? null; if (hit.poster_path) poster = `https://image.tmdb.org/t/p/w342${hit.poster_path}`; }
    } catch (e) { /* nulls */ }
    const out = { poster, tmdbId };
    _setCache(key, {}, out);
    return out;
  }

  // Read scraped months from the current month forward (same cache the page wrote).
  const _monthsAhead = [0, 1, 2, 3]; // current + next 3 months is plenty for an 8-slot reel
  const _curMonth = _midnight.getMonth(); // 0-based
  const _flat: { title: string; iso: string; days: number }[] = [];
  for (const off of _monthsAhead) {
    const mNum = _curMonth + off + 1; // cache key uses 1-based month of the SAME year (2026)
    if (mNum > 12) break;
    const groups = await _getOrScrapeMonth(mNum); // read cache, or scrape+cache on miss
    if (!groups || !groups.length) continue;
    for (const g of groups) {
      if (!g.iso || g.iso <= _todayISO) continue; // strictly upcoming only
      const days = Math.ceil((new Date(g.iso + 'T00:00:00').getTime() - _midnight.getTime()) / 86400000);
      for (const mv of (g.movies || [])) {
        if (mv && mv.title) _flat.push({ title: mv.title, iso: g.iso, days });
      }
    }
  }
  // Soonest first; resolve poster+tmdbId for the first 12, keep 8 that have a poster.
  _flat.sort((a, b) => a.days - b.days);
  const picked = _flat.slice(0, 14);
  const resolved = await Promise.all(picked.map(async (it) => {
    const lk = await dvdsrdLookup(it.title, Number(it.iso.slice(0, 4)));
    return { ...it, poster: lk.poster, tmdbId: lk.tmdbId };
  }));
  digitalReleaseItems = resolved
    .filter((it) => it.poster) // only show ones we have a (CSP-allowed TMDB) poster for
    .slice(0, 8)
    .map((it) => {
      const label = it.days === 1 ? 'Digital tomorrow' : `Digital in ${it.days} days`;
      return {
        id: it.tmdbId || 0, tmdb_id: it.tmdbId || 0, title: it.title,
        poster_path: it.poster ? it.poster.replace('https://image.tmdb.org/t/p/w342', '') : null,
        backdrop_path: null,
        vote_average: 0,
        year: Number(it.iso.slice(0, 4)),
        digital_label: label, days_until: it.days, type: 'movie' as const,
      };
    });
} catch (e) { digitalReleaseItems = []; }

// All latest additions go into the "Newly Added Movies" row below -- EXCEPT when
// the Digital Releases reel above (FeaturedSection) has come up empty and fallen
// back to spotlighting these same latest additions under a "Just Dropped" label.
// In that fallback case, skip the titles the reel is already showing so the row
// beneath it doesn't repeat them (restores a dedupe fix that was dropped in an
// earlier sync; see FeaturedSection.svelte's reelIsDigital/reelSource fallback).
const _reelFallbackIds = digitalReleaseItems.length === 0
  ? new Set(latestAdditionItems.filter((m: any) => m.poster_path || m.backdrop_path).slice(0, 8).map((m: any) => m.id))
  : new Set();
const latestAdditionsRowItems = latestAdditionItems.filter((m: any) => !_reelFallbackIds.has(m.id));

// "Trending Now" — real most-viewed movies (rpc/top_viewed_movies). The RPC's
// poster_path/year can be stale (e.g. dead .webp posters, wrong year), so we
// enrich each row against the movies table (fresh poster/year) by tmdb_id.
const mostViewedRaw = (mostViewed || []).filter((m: any) => (m.view_count || 0) > 0);
let mvFresh: Record<number, any> = {};
if (mostViewedRaw.length > 0) {
  try {
    const ids = mostViewedRaw.map((m: any) => m.tmdb_id).filter(Boolean).join(',');
    const r = await fetch(`${POSTGREST_URL}/movies?tmdb_id=in.(${ids})&select=tmdb_id,title,year,poster_path,vote_average`);
    if (r.ok) {
      const rows = await r.json();
      mvFresh = Object.fromEntries(rows.map((m: any) => [m.tmdb_id, m]));
    }
  } catch (e) { console.error('most-viewed enrich failed:', e); }
}
// Normalise a TMDB poster path: dead .webp variants 404, the .jpg works.
const fixPoster = (p: string | null): string | null => {
  if (!p) return null;
  if (p.startsWith('/images/')) return p;
  return p.replace(/\.webp$/i, '.jpg');
};
const mostViewedItems = mostViewedRaw
  .map((m: any) => {
    const fresh = mvFresh[m.tmdb_id] || {};
    const poster = fixPoster(fresh.poster_path || m.poster_path);
    return {
      id: m.tmdb_id,
      tmdb_id: m.tmdb_id,
      title: fresh.title || m.title,
      poster_path: poster,
      vote_average: fresh.vote_average || 0,
      year: fresh.year || m.year,
      type: 'movie' as const,
      has_downloads: true,
      view_count: m.view_count || 0,
    };
  })
  .filter((m: any) => m.poster_path);

// Transform upcoming movies with full release date
const upcomingItems = (upcoming || []).map((m: any) => {
  const ov = applyOverride(m.id, m.poster_path, null);
  return {
    id: m.id,
    tmdb_id: m.id,
    title: m.title,
    poster_path: ov.poster_path,
    vote_average: m.vote_average,
    year: m.release_date ? new Date(m.release_date).getFullYear() : null,
    release_date: m.release_date,
    type: 'movie' as const
  };
});

const tvItems = (trendingTV || []).map(transformTV);
const popularTVItems = (popularTV || []).map(transformTV);

// Fetch DB-assigned recent episodes (last 7 days) + TMDB on-the-air list
let dbRecentEpisodes: any[] = [];
try {
  const dbRes = await fetch(`${POSTGREST_URL}/recent_episode_series?order=latest_added.desc&limit=30`);
  if (dbRes.ok) dbRecentEpisodes = await dbRes.json();
} catch(e) {}

const dbOnAirItems = dbRecentEpisodes
  .filter((r: any) => r.poster_path)
  .map((r: any) => {
    const s = String(r.season_number).padStart(2, '0');
    const e = String(r.episode_number).padStart(2, '0');
    return {
      id: r.tmdb_id,
      tmdb_id: r.tmdb_id,
      title: r.title,
      poster_path: r.poster_path,
      vote_average: r.vote_average,
      year: r.year,
      type: 'series' as const,
      episode_info: `S${s}E${e}`,
    };
  });

// Fetch TV details for on-the-air shows to get last_episode_to_air data
const onTheAirFiltered = (onTheAirTV || []).filter((t: any) => t.poster_path);
const onTheAirDetails = await Promise.all(
  onTheAirFiltered.map((t: any) => getTVDetails(t.id).catch(() => null))
);
const tmdbOnAirItems = onTheAirFiltered.map((t: any, index: number) => {
  const base = transformTV(t);
  const details = onTheAirDetails[index];
  const lastEp = details?.last_episode_to_air;
  if (lastEp && lastEp.season_number != null && lastEp.episode_number != null) {
    const s = String(lastEp.season_number).padStart(2, '0');
    const e = String(lastEp.episode_number).padStart(2, '0');
    return { ...base, episode_info: `S${s}E${e}` };
  }
  return base;
});
// Merge: DB results first, then TMDB (deduplicate by tmdb_id)
const dbTmdbIds = new Set(dbOnAirItems.map((x: any) => x.tmdb_id));
const onTheAirItems = [
  ...dbOnAirItems,
  ...tmdbOnAirItems.filter((x: any) => !dbTmdbIds.has(x.tmdb_id)),
];
const actionItems = (actionMovies?.results || []).slice(0, 15).map(transformMovie);
const comedyItems = (comedyMovies?.results || []).slice(0, 15).map(transformMovie);
const romanceItems = (romanceMovies?.results || []).slice(0, 15).map(transformMovie);
const thrillerItems = (thrillerMovies?.results || []).slice(0, 15).map(transformMovie);
const animeItems = (animeMovies?.results || []).slice(0, 15).map(transformMovie);
const kDramaItems = (kDramaMovies?.results || []).slice(0, 15).map(transformMovie);

// Movie Guides — curated topic lists (replaces Anime/Korean rows). Pulls a few
// published topics + their top posters for a cinematic collage card.
let movieGuides: any[] = [];
try {
  const _gr = await fetch(`${POSTGREST_URL}/movie_topics?is_published=eq.true&order=sort_order.asc&limit=6&select=id,slug,title,intro,emoji,color`);
  if (_gr.ok) {
    movieGuides = await _gr.json();
    await Promise.all(movieGuides.map(async (g: any) => {
      try {
        const ir = await fetch(`${POSTGREST_URL}/movie_topic_items?topic_id=eq.${g.id}&order=position.asc&limit=4&select=poster_path`);
        g.posters = (ir.ok ? await ir.json() : []).map((i: any) => i.poster_path).filter(Boolean);
      } catch (e) { g.posters = []; }
    }));
  }
} catch (e) {}

// Oscar 2026 nominees - search TMDB for each
const oscarTitles = [
  'Sinners', 'One Battle After Another', 'Bugonia', 'F1', 'Frankenstein',
  'Hamnet', 'Marty Supreme', 'The Secret Agent', 'Sentimental Value', 'Train Dreams'
];

async function searchOscarMovie(title: string) {
  try {
    const result = await searchMovies(title, 1);
    if (result.results && result.results.length > 0) {
      const movie = result.results.find((m: any) => {
        const year = m.release_date ? new Date(m.release_date).getFullYear() : 0;
        return year >= 2024 && year <= 2026;
      }) || result.results[0];
      return transformMovie(movie);
    }
  } catch (e) {
    console.error(`Failed to search Oscar movie ${title}:`, e);
  }
  return null;
}

const oscarResults = await Promise.all(oscarTitles.map(searchOscarMovie));
const oscarMovies = oscarResults.filter((m): m is NonNullable<typeof m> => m !== null);

// Top Movies (current year) - sourced from curated list shipped in JSON
const currentYear = new Date().getFullYear();
const _topMoviesYear = topMoviesData.by_year[String(currentYear)] || topMoviesData.by_year[String(topMoviesData.years[0])] || [];
// Build PostgREST overlay so the homepage hero links to /movie/{slug} when we own the file
const _topTmdbIds = _topMoviesYear.slice(0, 20).map((m: any) => m.tmdb_id).filter((x: any): x is number => typeof x === 'number');
const _topLiveMap = new Map<number, { id: number; slug: string | null }>();
if (_topTmdbIds.length > 0) {
  try {
    const _r = await fetch(POSTGREST_URL + "/movies?tmdb_id=in.(" + _topTmdbIds.join(",") + ")&has_downloads=eq.true&select=id,slug,tmdb_id");
    if (_r.ok) {
      const _rows: Array<{id: number; slug: string | null; tmdb_id: number}> = await _r.json();
      for (const row of _rows) _topLiveMap.set(row.tmdb_id, { id: row.id, slug: row.slug });
    }
  } catch (_) { /* ignore, fall back to JSON */ }
}
const topMovies = _topMoviesYear.slice(0, 20).map((m: any) => {
  const live = m.tmdb_id ? _topLiveMap.get(m.tmdb_id) : undefined;
  return {
    // FeaturedSection uses /movie/{id} where id is tmdb_id
    id: m.tmdb_id || 0,
    title: m.title,
    poster_path: m.poster_path,
    backdrop_path: m.backdrop_path,
    vote_average: m.imdb || m.vote_average || 0,
    year: parseInt(String(currentYear), 10),
    in_db: !!live || (m.in_db && m.db_id),
  };
});

// Fetch box office from database
async function getBoxOfficeData() {
  try {
    const res = await fetch(
      `${POSTGREST_URL}/box_office_weekly?order=week_start.desc,rank.asc&limit=15`
    );
    if (!res.ok) return [];
    const data = await res.json();
    if (data.length === 0) return [];
    const latestWeek = data[0].week_start;
    return data.filter(d => d.week_start === latestWeek).slice(0, 7).map(d => ({
      rank: d.rank,
      title: d.movie_title,
      weekend_gross: d.three_day_gross ? `$${(d.three_day_gross / 1000000).toFixed(1)}M` : "-",
      total_gross: d.total_gross > 100000 ? `$${(d.total_gross / 1000000).toFixed(1)}M` : (d.three_day_gross ? `$${(d.three_day_gross / 1000000).toFixed(1)}M` : "-"),
      tmdb_id: d.tmdb_id || 0,
      poster_path: d.poster_path || null
    }));
  } catch (e) {
    console.error("Failed to fetch box office:", e);
    return [];
  }
}

// Mood-specific genres (kicked off in parallel up top for perf)
const [familyMovies, horrorMovies, sciFiMovies, dramaMovies, hindiMovies, animationMovies, historyMovies] = await _moodGenresP;

const familyItems = (familyMovies?.results || []).slice(0, 8).map(transformMovie);
const horrorItems = (horrorMovies?.results || []).slice(0, 8).map(transformMovie);
const sciFiItems = (sciFiMovies?.results || []).slice(0, 8).map(transformMovie);
const dramaItems = (dramaMovies?.results || []).slice(0, 8).map(transformMovie);
const hindiItems = (hindiMovies?.results || []).slice(0, 8).map(transformMovie);
const animationItems = (animationMovies?.results || []).slice(0, 8).map(transformMovie);
const historyItems = (historyMovies?.results || []).slice(0, 8).map(transformMovie);

const moodData = [
  { id: "chill", emoji: "😌", label: "Chill", gradient: "linear-gradient(135deg, #06b6d4, #0284c7)", items: familyItems.slice(0, 4) },
  { id: "thrilling", emoji: "😰", label: "Thrilling", gradient: "linear-gradient(135deg, #dc2626, #991b1b)", items: thrillerItems.slice(0, 4) },
  { id: "laugh", emoji: "😂", label: "Laugh", gradient: "linear-gradient(135deg, #f59e0b, #ea580c)", items: comedyItems.slice(0, 4) },
  { id: "cry", emoji: "😢", label: "Cry", gradient: "linear-gradient(135deg, #7c3aed, #4f46e5)", items: dramaItems.slice(0, 4) },
  { id: "mind-blown", emoji: "🤯", label: "Mind-Blown", gradient: "linear-gradient(135deg, #059669, #0d9488)", items: sciFiItems.slice(0, 4) },
  { id: "nostalgic", emoji: "🥹", label: "Nostalgic", gradient: "linear-gradient(135deg, #be185d, #e11d48)", items: romanceItems.slice(0, 4) },
];

const collectionsData = [
  { id: "true-story", title: "True Story", subtitle: "Because real life is stranger than fiction", link: "/genre/history", gradient: "linear-gradient(135deg, #78716c 0%, #44403c 100%)", posters: historyItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
  { id: "animation", title: "Animation World", subtitle: "Stunning animated films", link: "/genre/animation", gradient: "linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%)", posters: animationItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
  { id: "sci-fi", title: "Mind-Bending Sci-Fi", subtitle: "Beyond imagination", link: "/genre/sci-fi", gradient: "linear-gradient(135deg, #059669 0%, #0d9488 100%)", posters: sciFiItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
  { id: "horror", title: "Nightmare Fuel", subtitle: "Sleep with the lights on", link: "/genre/horror", gradient: "linear-gradient(135deg, #1e1e1e 0%, #7f1d1d 100%)", posters: horrorItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
  { id: "bollywood", title: "Bollywood Hits", subtitle: "Best of Hindi cinema", link: "/category/bollywood", gradient: "linear-gradient(135deg, #f59e0b 0%, #e11d48 100%)", posters: hindiItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
  { id: "top-rated", title: "Highest Rated of All Time", subtitle: "The all-time greatest", link: "/top-rated", gradient: "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)", posters: topRatedItems.slice(0, 4).map((i) => i.poster_path).filter(Boolean) },
];

const boxOfficeData = await _boxOfficeDataP;

// Search TMDB for box office movies to get posters
const boxOfficeWithPosters = await Promise.all(boxOfficeData.map(async (entry) => {
  try {
    const result = await searchMovies(entry.title, 1);
    if (result.results && result.results.length > 0) {
      const movie = result.results[0];
      return { ...entry, tmdb_id: movie.id, poster_path: movie.poster_path };
    }
  } catch (e) {}
  return entry;
}));

// Attach reviewSlug to box-office + digital items that have a PUBLISHED review.
try {
  const POSTGREST_RV = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';
  const rvIds = [...new Set([
    ...boxOfficeWithPosters.map((e: any) => e.tmdb_id).filter(Boolean),
    ...digitalReleaseItems.map((e: any) => e.tmdb_id).filter(Boolean),
  ])];
  if (rvIds.length) {
    const rvRes = await fetch(`${POSTGREST_RV}/movie_reviews?status=eq.published&tmdb_id=in.(${rvIds.join(',')})&select=tmdb_id,slug`);
    if (rvRes.ok) {
      const rvRows = await rvRes.json();
      const bySlug = new Map<number, string>();
      for (const r of rvRows) bySlug.set(Number(r.tmdb_id), r.slug);
      for (const e of boxOfficeWithPosters) if (e.tmdb_id && bySlug.has(Number(e.tmdb_id))) (e as any).reviewSlug = bySlug.get(Number(e.tmdb_id));
      for (const e of digitalReleaseItems) if (e.tmdb_id && bySlug.has(Number(e.tmdb_id))) (e as any).reviewSlug = bySlug.get(Number(e.tmdb_id));
    }
  }
} catch (e) { /* reviews are optional enrichment */ }

// Latest published reviews for the homepage Reviews tab.
let latestReviews: any[] = [];
try {
  const POSTGREST_RV2 = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';
  const rr = await fetch(`${POSTGREST_RV2}/movie_reviews?status=eq.published&select=slug,title,year,headline,poster_path,rt_score&order=published_at.desc&limit=8`);
  if (rr.ok) latestReviews = await rr.json();
} catch (e) { latestReviews = []; }
---

<BaseLayout title="Watch Movies & TV Series Online Free">
  <!-- Hero Section -->
  <!-- SEO H1 -->
  <h1 class="sr-only">Watch Movies &amp; TV Series Online Free - TrendiMovies</h1>
  <HeroCarousel
    client:load
    featured={featured}
    trending={heroItems}
  />

  <!-- Trending Movies -->
  {trendingItems.length > 0 && (
    <ContentRow
      client:load
      title="Trending This Week"
      items={trendingItems}
      seeAllLink="/trending"
      autoScroll={true}
    />
  )}

  <!-- Trending Now — ranked by REAL views on TrendiMovies (page_views data).
       Distinct from "Trending This Week" (TMDB global) via rank #s + view counts. -->
  {mostViewedItems.length >= 5 && (
    <TrendingNowRow
      client:load
      items={mostViewedItems}
      title="Trending Now"
      subtitle="Most watched on TrendiMovies"
      seeAllLink="/trending"
    />
  )}

  <!-- Featured Section + Latest Additions:
       Featured (which now contains the "Just Dropped" reel) comes FIRST on all
       breakpoints, then "More Just Added" below it. -->
  <div class="flex flex-col">
    <!-- Featured Section: Oscar + Tabs + Just Dropped reel -->
    <div class="order-1">
      <FeaturedSection
        client:load
        oscarMovies={oscarMovies}
        topMovies={topMovies}
        boxOffice={boxOfficeWithPosters}
        comingSoon={upcoming.slice(0, 10).map(transformMovie)}
        latestAdditions={latestAdditionItems}
        digitalReleases={digitalReleaseItems}
        reviews={latestReviews}
      />
    </div>

    <!-- Newly Added Movies (from our database - movies with downloads).
         Now the SINGLE latest-additions section (merged from the old
         "Just Dropped" reel + "More Just Added" row). -->
    {latestAdditionsRowItems.length > 0 && (
      <div class="order-2">
        <ContentRow
          client:load
          title="Newly Added Movies"
          items={latestAdditionsRowItems}
          seeAllLink="/movies/latest"
          autoScroll={false}
        />
      </div>
    )}
  </div>

  <!-- Now Playing -->
  {nowPlayingItems.length > 0 && (
    <ContentRow
      client:load
      title="Now Playing in Theaters"
      items={nowPlayingItems}
      seeAllLink="/movies?filter=now_playing"
      autoScroll={true}
    />
  )}

  <!-- Upcoming Movies -->
  {upcomingItems.length > 0 && (
    <ContentRow
      client:visible
      title="Coming Soon"
      items={upcomingItems}
      seeAllLink="/movies/upcoming"
    />
  )}

  <!-- Popular Movies -->
  {popularItems.length > 0 && (
    <ContentRow
      client:visible
      title="Popular Movies"
      items={popularItems}
      seeAllLink="/movies/popular"
    />
  )}

  <!-- Trending TV -->
  {tvItems.length > 0 && (
    <ContentRow
      client:visible
      title="Trending TV Series"
      items={tvItems}
      seeAllLink="/series"
    />
  )}

  <!-- Continue Watching (client-side, reads from localStorage) -->
  <ContinueWatching client:load />

  <!-- Collections -->
  <Collections client:visible collections={collectionsData} />

  <!-- Pick Your Mood -->
  <PickYourMood client:visible moods={moodData} />

  <!-- New Episodes This Week -->
  {onTheAirItems.length > 0 && (
    <ContentRow
      client:visible
      title="New Episodes This Week"
      items={onTheAirItems}
      seeAllLink="/series/new-episodes"
    />
  )}

  <!-- Action Movies -->
  {actionItems.length > 0 && (
    <ContentRow
      client:visible
      title="Non-Stop Action"
      items={actionItems}
      seeAllLink="/genre/action"
    />
  )}

  <!-- Comedy Movies -->
  {comedyItems.length > 0 && (
    <ContentRow
      client:visible
      title="Comedy Central"
      items={comedyItems}
      seeAllLink="/genre/comedy"
    />
  )}

  <!-- Romance Movies -->
  {romanceItems.length > 0 && (
    <ContentRow
      client:visible
      title="Midnight Romance"
      items={romanceItems}
      seeAllLink="/genre/romance"
    />
  )}

  <!-- Thriller Movies -->
  {thrillerItems.length > 0 && (
    <ContentRow
      client:visible
      title="Thriller Movies"
      items={thrillerItems}
      seeAllLink="/genre/thriller"
    />
  )}

  <!-- Movie Guides — curated topic lists (replaced Anime/Korean rows) -->
  {movieGuides.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl">🎬</span>
          <h2 class="text-lg sm:text-2xl md:text-3xl font-extrabold" style="color: var(--text-primary);">Movie Guides</h2>
        </div>
        <a href="/guides" class="text-sm font-medium text-purple-400 hover:text-purple-300 transition-colors">See All →</a>
      </div>
      <p class="text-sm mb-6 -mt-2" style="color: var(--text-muted);">Hand-picked lists for every mood and era.</p>
      <div class="vinyl-grid">
        <div class="vinyl-track">
          {movieGuides.map((g: any) => (
            <a href={`/guides/${g.slug}`} class="vinyl-card group" style={`--c: ${g.color};`}>
              <div class="vinyl-disc">
                <img src={g.posters?.[0] && g.posters[0].startsWith('/images/') ? g.posters[0] : `https://image.tmdb.org/t/p/w342${g.posters?.[0]}`} alt="" loading="lazy" class="vinyl-label" />
                <div class="vinyl-sheen"></div>
                <div class="vinyl-hole"></div>
              </div>
              <p class="vinyl-name"><span class="vinyl-emoji">{g.emoji}</span> {g.title}</p>
            </a>
          ))}
          {/* duplicate set so the mobile auto-slide loops seamlessly (hidden from screen readers) */}
          {movieGuides.map((g: any) => (
            <a href={`/guides/${g.slug}`} class="vinyl-card group vinyl-dupe" style={`--c: ${g.color};`} aria-hidden="true" tabindex="-1">
              <div class="vinyl-disc">
                <img src={g.posters?.[0] && g.posters[0].startsWith('/images/') ? g.posters[0] : `https://image.tmdb.org/t/p/w342${g.posters?.[0]}`} alt="" loading="lazy" class="vinyl-label" />
                <div class="vinyl-sheen"></div>
                <div class="vinyl-hole"></div>
              </div>
              <p class="vinyl-name"><span class="vinyl-emoji">{g.emoji}</span> {g.title}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* Movie Guides — auto-spinning vinyl/film-reel discs */
  /* Tablet/desktop: a normal multi-column grid. The .vinyl-track is transparent
     to layout (display:contents) and the duplicate set is hidden. */
  .vinyl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 16px;
    justify-items: center;
  }
  @media (min-width: 1024px) { .vinyl-grid { grid-template-columns: repeat(6, 1fr); } }
  .vinyl-track { display: contents; }

  .vinyl-card { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 170px; text-decoration: none; }
  .vinyl-card.vinyl-dupe { display: none; }   /* desktop/tablet: only the real set (beats .vinyl-card) */

  /* Mobile (< 640px): manual finger-swipe carousel (no auto-slide). Discs still spin. */
  @media (max-width: 639px) {
    .vinyl-grid {
      display: block;
      overflow-x: auto;                 /* swipe horizontally with your finger */
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scrollbar-width: none;            /* hide scrollbar (Firefox) */
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    }
    .vinyl-grid::-webkit-scrollbar { display: none; }   /* hide scrollbar (WebKit) */
    .vinyl-track {
      display: flex;
      width: max-content;
      gap: 22px;
      padding: 0 4px 4px;
    }
    .vinyl-card.vinyl-dupe { display: none; }   /* manual scroll → no duplicate set needed */
    .vinyl-card { width: 132px; max-width: 132px; flex: 0 0 auto; scroll-snap-align: center; }
  }

  .vinyl-disc {
    position: relative; width: 100%; aspect-ratio: 1; border-radius: 50%; overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #1a1a1a 0 30%, #0a0a0a 30%);
    box-shadow: 0 10px 28px rgba(0,0,0,0.55), inset 0 0 0 7px #111, inset 0 0 0 8px var(--c);
    /* concentric vinyl grooves */
    background-image:
      repeating-radial-gradient(circle at 50% 50%, rgba(255,255,255,0.04) 0 1px, transparent 1px 4px);
    animation: vinyl-spin 14s linear infinite;     /* AUTO-SPIN — no hover needed */
    will-change: transform;
  }
  .vinyl-card:hover .vinyl-disc { animation-duration: 4s; }   /* desktop bonus: spin faster on hover */

  .vinyl-label {
    position: absolute; top: 28%; left: 28%; width: 44%; height: 44%;
    object-fit: cover; border-radius: 50%; box-shadow: 0 0 0 2px rgba(255,255,255,0.15);
  }
  .vinyl-sheen {
    position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background: linear-gradient(125deg, rgba(255,255,255,0.18) 0 18%, transparent 38% 62%, rgba(255,255,255,0.08) 82% 100%);
  }
  .vinyl-hole {
    position: absolute; top: 47%; left: 47%; width: 6%; height: 6%; border-radius: 50%;
    background: #000; box-shadow: 0 0 0 2px #333; z-index: 3;
  }

  .vinyl-name {
    margin-top: 12px; font: 700 12px/1.25 system-ui; color: var(--text-primary);
    text-align: center; max-width: 160px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vinyl-card:hover .vinyl-name { color: #fff; }
  .vinyl-emoji { font-size: 14px; }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc { animation: none; }
  }
  @keyframes vinyl-spin { to { transform: rotate(360deg); } }
</style>
