---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingView from '../components/ListingView.svelte';
import { fetchFromTMDB, getMovieGenres, getTVGenres } from '../lib/tmdb';

// Trending this week: movies and TV series, with Genre and Language filters and a Grid | List switch.
const genreParam = Astro.url.searchParams.get('genre') || '';
const langParam = Astro.url.searchParams.get('lang') || '';

const LANGUAGES: [string, string][] = [
  ['en', 'English'], ['fr', 'French'], ['es', 'Spanish'], ['de', 'German'], ['it', 'Italian'],
  ['pt', 'Portuguese'], ['ru', 'Russian'], ['tr', 'Turkish'], ['ar', 'Arabic'],
  ['hi', 'Hindi'], ['ta', 'Tamil'], ['te', 'Telugu'], ['ml', 'Malayalam'], ['kn', 'Kannada'], ['bn', 'Bengali'],
  ['ja', 'Japanese'], ['ko', 'Korean'], ['zh', 'Chinese'], ['th', 'Thai'], ['id', 'Indonesian'],
];
const lang = LANGUAGES.some(([c]) => c === langParam) ? langParam : '';

const [movieGenres, tvGenres] = await Promise.all([
  getMovieGenres().catch(() => [] as { id: number; name: string }[]),
  getTVGenres().catch(() => [] as { id: number; name: string }[]),
]);
const genre = movieGenres.some((g) => String(g.id) === genreParam) ? genreParam : '';

// Movie and TV genre numbers differ a little at TMDB, so a chosen genre is translated for the series side.
// A genre that has no TV version (Horror, Romance, Thriller...) simply shows no series.
const TV_FROM_MOVIE: Record<string, number> = { '28': 10759, '12': 10759, '14': 10765, '878': 10765, '10752': 10768 };
const tvIds = new Set(tvGenres.map((g) => g.id));
let tvGenre: number | null = null;
if (genre) {
  const m = TV_FROM_MOVIE[genre] ?? Number(genre);
  tvGenre = tvIds.has(m) ? m : null;
}

// TMDB gives 20 a page; take three pages so there is enough left after filtering
async function trending(kind: 'movie' | 'tv'): Promise<any[]> {
  const parts = await Promise.all(
    [1, 2, 3].map((p) => fetchFromTMDB<any>(`/trending/${kind}/week`, { page: String(p) }).catch(() => ({ results: [] })))
  );
  const seen = new Set<number>();
  return parts.flatMap((r: any) => r.results || []).filter((x: any) => {
    if (!x.poster_path || seen.has(x.id)) return false;
    seen.add(x.id);
    return true;
  });
}

const [rawMovies, rawTV] = await Promise.all([trending('movie'), trending('tv')]);

const LIMIT = 30; // 6 across x 5 down fills the screen
const pickedMovies = rawMovies
  .filter((m: any) => (!genre || (m.genre_ids || []).includes(Number(genre))) && (!lang || m.original_language === lang))
  .slice(0, LIMIT);
const pickedTV = (genre && tvGenre === null ? [] : rawTV)
  .filter((t: any) => (!tvGenre || (t.genre_ids || []).includes(tvGenre)) && (!lang || t.original_language === lang))
  .slice(0, LIMIT);

function transformMovie(movie: any) {
  return {
    id: movie.id,
    tmdb_id: movie.id,
    title: movie.title,
    poster_path: movie.poster_path,
    overview: movie.overview,
    vote_average: movie.vote_average,
    year: movie.release_date ? new Date(movie.release_date).getFullYear() : null,
    type: 'movie' as const
  };
}

function transformSeries(show: any) {
  return {
    id: show.id,
    tmdb_id: show.id,
    title: show.name,
    poster_path: show.poster_path,
    overview: show.overview,
    vote_average: show.vote_average,
    year: show.first_air_date ? new Date(show.first_air_date).getFullYear() : null,
    type: 'series' as const
  };
}

const movies = pickedMovies.map(transformMovie);
const series = pickedTV.map(transformSeries);

// Branded WhatsApp/OG banner (1200×630) via the /api/og.png generator.
const _ogBackdrop = pickedMovies.find((m: any) => m.backdrop_path)?.backdrop_path || '';
const _ogTitles = movies.slice(0, 4).map((m: any) => m.title).join('|');
const ogImage = `/api/og.png?type=list&label=${encodeURIComponent('Trending This Week')}&emoji=${encodeURIComponent('🔥')}&color=%23e50914&backdrop=${encodeURIComponent(_ogBackdrop)}&titles=${encodeURIComponent(_ogTitles)}`;
const gridClass = 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-4';
---

<BaseLayout
  title="Trending"
  description="Trending movies and TV series this week"
  image={ogImage}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
      <h1 class="text-3xl font-bold" style="color: var(--text-primary);">Trending This Week</h1>

      <div class="mt-4 md:mt-0 flex flex-wrap gap-2">
        <select
          id="genre-select"
          aria-label="Genre"
          class="px-3 py-2 rounded-lg text-sm"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          <option value="">All Genres</option>
          {movieGenres.map((g) => <option value={g.id} selected={genre === String(g.id)}>{g.name}</option>)}
        </select>

        <select
          id="lang-select"
          aria-label="Language"
          class="px-3 py-2 rounded-lg text-sm"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          <option value="">All Languages</option>
          {LANGUAGES.map(([c, n]) => <option value={c} selected={lang === c}>{n}</option>)}
        </select>
      </div>
    </div>

    <!-- Trending Movies -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6" style="color: var(--text-primary);">Movies</h2>
      {movies.length > 0 ? (
        <ListingView client:load items={movies} gridClass={gridClass} />
      ) : (
        <p style="color: var(--text-secondary);">No trending movies for this choice</p>
      )}
    </section>

    <!-- Trending Series -->
    <section>
      <h2 class="text-2xl font-semibold mb-6" style="color: var(--text-primary);">TV Series</h2>
      {series.length > 0 ? (
        <ListingView client:load showToggle={movies.length === 0} items={series} gridClass={gridClass} />
      ) : (
        <p style="color: var(--text-secondary);">No trending series for this choice</p>
      )}
    </section>
  </div>

  <script>
    function go() {
      const url = new URL(window.location.href);
      const set = (k: string, id: string) => {
        const v = (document.getElementById(id) as HTMLSelectElement | null)?.value || '';
        if (v) url.searchParams.set(k, v); else url.searchParams.delete(k);
      };
      set('genre', 'genre-select');
      set('lang', 'lang-select');
      window.location.href = url.toString();
    }
    ['genre-select', 'lang-select'].forEach((id) => {
      document.getElementById(id)?.addEventListener('change', go);
    });
  </script>
</BaseLayout>
