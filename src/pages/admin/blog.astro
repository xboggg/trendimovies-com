---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BlogManager from '../../components/admin/BlogManager.svelte';
---

<AdminLayout title="Blog" activeTab="blog">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-white">Blog</h1>
    <p class="text-[#888] mt-1 text-sm">AI-written once a day via <code class="text-[#f59e0b]">auto_blog.py</code>. Auto-publishes if it passes the sanity gate, otherwise lands here as a draft for approval. Generate one manually on the server with <code class="text-[#f59e0b]">blog_generator.py --angle &lt;name&gt;</code>.</p>
  </div>
  <BlogManager client:load />
</AdminLayout>
