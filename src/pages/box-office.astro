---
import BaseLayout from '../layouts/BaseLayout.astro';
import { searchMovies } from '../lib/tmdb';

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';

// Fetch box office data from database
async function getBoxOfficeData() {
  try {
    const res = await fetch(
      `${POSTGREST_URL}/box_office_weekly?order=week_start.desc,rank.asc&limit=100`,
      { headers: { 'Accept-Profile': 'public' }, signal: AbortSignal.timeout(10000) }
    );
    if (!res.ok) return [];
    return await res.json();
  } catch (e) {
    console.error('Failed to fetch box office:', e);
    return [];
  }
}

const boxOfficeData = await getBoxOfficeData();

// Group by week
const weeklyData: Record<string, any[]> = {};
for (const entry of boxOfficeData) {
  const weekKey = entry.week_start;
  if (!weeklyData[weekKey]) {
    weeklyData[weekKey] = [];
  }
  weeklyData[weekKey].push(entry);
}

// Get sorted week keys (most recent first)
const weeks = Object.keys(weeklyData).sort((a, b) => new Date(b).getTime() - new Date(a).getTime());

// If no data from DB, use hardcoded data
const hasDbData = weeks.length > 0;

const hardcodedData = [
  { rank: 1, movie_title: 'Wuthering Heights', three_day_gross: 34800000, four_day_gross: 40000000, total_gross: 40000000, weeks_in_release: 1 },
  { rank: 2, movie_title: 'GOAT', three_day_gross: 26000000, four_day_gross: 32000000, total_gross: 32000000, weeks_in_release: 1 },
  { rank: 3, movie_title: 'Crime 101', three_day_gross: 15400000, four_day_gross: 17700000, total_gross: 17700000, weeks_in_release: 1 },
  { rank: 4, movie_title: 'Send Help', three_day_gross: 8900000, four_day_gross: 10700000, total_gross: 49600000, weeks_in_release: 3 },
  { rank: 5, movie_title: 'Solo Mio', three_day_gross: 6800000, four_day_gross: 8000000, total_gross: 18500000, weeks_in_release: 2 },
  { rank: 6, movie_title: 'Zootopia 2', three_day_gross: 3700000, four_day_gross: 5000000, total_gross: 420600000, weeks_in_release: 9 },
  { rank: 7, movie_title: 'Good Luck, Have Fun, Don\'t Die', three_day_gross: 3600000, four_day_gross: 4100000, total_gross: 4100000, weeks_in_release: 1 },
  { rank: 8, movie_title: 'Avatar: Fire and Ash', three_day_gross: 3300000, four_day_gross: 3800000, total_gross: 396500000, weeks_in_release: 10 },
  { rank: 9, movie_title: 'Iron Lung', three_day_gross: 3300000, four_day_gross: 3700000, total_gross: 37900000, weeks_in_release: 4 },
  { rank: 10, movie_title: 'Dracula', three_day_gross: 3000000, four_day_gross: 3500000, total_gross: 9500000, weeks_in_release: 2 },
];

// Search TMDB for posters
async function enrichWithPosters(entries: any[]) {
  return Promise.all(entries.map(async (entry) => {
    if (entry.poster_path) return entry;
    try {
      const result = await searchMovies(entry.movie_title, 1);
      if (result.results && result.results.length > 0) {
        const movie = result.results[0];
        return { ...entry, tmdb_id: movie.id, poster_path: movie.poster_path };
      }
    } catch (e) {}
    return entry;
  }));
}

const currentWeekData = hasDbData
  ? await enrichWithPosters(weeklyData[weeks[0]] || [])
  : await enrichWithPosters(hardcodedData);

// Phone list: every bar is drawn relative to the biggest weekend number
const topWeekend = Math.max(1, ...currentWeekData.map((e: any) => Number(e.three_day_gross) || 0));

// Wide screens: the top three get big poster cards, the rest are a compact table
const topThree = currentWeekData.slice(0, 3);
const restRows = currentWeekData.slice(3);

function formatMoney(amount: number | null): string {
  if (!amount) return '-';
  if (amount >= 1000000000) return `$${(amount / 1000000000).toFixed(2)}B`;
  if (amount >= 1000000) return `$${(amount / 1000000).toFixed(1)}M`;
  return `$${amount.toLocaleString()}`;
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

function getPosterUrl(path: string | null, size: string = 'w185'): string {
  if (!path) return '/images/no-poster.svg';
  return `https://image.tmdb.org/t/p/${size}${path}`;
}
---

<BaseLayout
  title="Weekend Box Office — Top-Grossing Movies & Charts | TrendiMovies"
  description="See what's #1 at the box office. Live weekend earnings, rankings and charts for the highest-grossing films — updated every week on TrendiMovies."
  image={`/api/og.png?type=digital&posters=${encodeURIComponent(boxOfficeData.filter((e: any) => e.poster_path).slice(0, 5).map((e: any) => e.poster_path).join('|'))}&accent=${encodeURIComponent('#22c55e')}&eyebrow=${encodeURIComponent('WEEKEND BOX OFFICE')}&eyebrowEmoji=${encodeURIComponent('📊')}&headline=${encodeURIComponent('Weekend Box Office')}&subtitle=${encodeURIComponent("This week's top-grossing movies — ranked, with earnings")}&ogurl=${encodeURIComponent('trendimovies.com/box-office')}`}
>
  <!-- Header -->
  <section class="relative py-12 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-green-900/30 via-transparent to-emerald-900/30"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-3xl md:text-5xl font-black mb-4" style="color: var(--text-primary);">
          <span class="text-green-500">$</span> Weekend Box Office
        </h1>
        <p class="text-lg" style="color: var(--text-secondary);">
          Track the highest-grossing films at the box office
        </p>
        {hasDbData && weeks[0] && (
          <p class="mt-2 text-sm font-medium text-green-500">
            Latest: {formatDate(weeks[0])}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Current Week -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h2 class="text-xl md:text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
      <span class="text-green-500">📊</span>
      This Week's Top 10
    </h2>

    <!-- Phone list (under 768px): rank, name, weekend money, a bar drawn to scale, total + weeks, and a link to the film page.
         The table below is for wider screens, so nothing is squeezed on a phone. -->
    <ol class="md:hidden flex flex-col gap-5 list-none p-0 m-0">
      {currentWeekData.map((entry, index) => {
        const Row = entry.tmdb_id ? 'a' : 'div';
        const barPct = Math.max(3, Math.round(((Number(entry.three_day_gross) || 0) / topWeekend) * 100));
        return (
          <li>
            <Row href={entry.tmdb_id ? `/movie/${entry.tmdb_id}` : undefined} class="flex items-start gap-3">
              <span
                class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0"
                style={index < 3
                  ? 'background: linear-gradient(135deg, #22c55e, #16a34a); color: white;'
                  : 'background-color: var(--bg-hover); color: var(--text-primary);'}
              >
                {entry.rank}
              </span>
              <span class="flex-1 min-w-0 block">
                <span class="flex justify-between items-baseline gap-3">
                  <span class="font-semibold" style="color: var(--text-primary);">{entry.movie_title}</span>
                  <span class="font-bold text-green-500 flex-shrink-0">{formatMoney(entry.three_day_gross)}</span>
                </span>
                <span class="block rounded-full mt-2 overflow-hidden" style="height: 10px; background-color: var(--bg-hover);">
                  <span class="block h-full rounded-full" style={`width: ${barPct}%; background-color: #22c55e;`}></span>
                </span>
                <span class="flex justify-between items-center gap-3 mt-1.5 text-xs" style="color: var(--text-muted);">
                  <span>Total {formatMoney(entry.total_gross)} · Week {entry.weeks_in_release || 1}</span>
                  {entry.tmdb_id && <span class="font-bold text-green-500 whitespace-nowrap">View film ›</span>}
                </span>
              </span>
            </Row>
          </li>
        );
      })}
    </ol>

    <!-- Wide screens (768px and up): big poster cards for the top three, then a compact table for the rest. -->
    <div class="hidden md:block">
      <div class="grid grid-cols-3 gap-4 mb-5">
        {topThree.map((entry, index) => {
          const href = entry.tmdb_id ? `/movie/${entry.tmdb_id}` : null;
          return (
            <div class="rounded-2xl p-3.5 flex gap-3.5" style="background-color: var(--bg-card); border: 1px solid var(--border);">
              <a href={href} class="flex-shrink-0 block">
                <img loading="lazy" src={getPosterUrl(entry.poster_path, 'w342')} alt={entry.movie_title} class="bo-poster rounded-lg object-cover" />
              </a>
              <div class="flex flex-col items-start gap-1.5 min-w-0">
                <span
                  class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold"
                  style="background: linear-gradient(135deg, #22c55e, #16a34a); color: white;"
                >
                  {entry.rank}
                </span>
                <a href={href} class="font-bold leading-tight hover:text-green-500 transition-colors" style="color: var(--text-primary); font-size: 16px;">{entry.movie_title}</a>
                <p class="bo-money font-extrabold text-green-500 leading-none">{formatMoney(entry.three_day_gross)}</p>
                <p class="text-xs" style="color: var(--text-muted);">Total {formatMoney(entry.total_gross)} · Week {entry.weeks_in_release || 1}</p>
                {entry.four_day_gross ? <p class="text-xs" style="color: var(--text-muted);">4-day weekend {formatMoney(entry.four_day_gross)}</p> : null}
                {href && (
                  <a
                    href={href}
                    class="mt-auto inline-flex items-center text-sm font-bold rounded-full px-3.5 py-1.5 whitespace-nowrap"
                    style={index === 0
                      ? 'background-color: #22c55e; color: #052e16;'
                      : 'border: 1px solid #22c55e; color: #22c55e;'}
                  >
                    View film ›
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div class="bo-cols text-sm pb-2" style="color: var(--text-muted);">
        <span class="pl-1">#</span>
        <span></span>
        <span>Movie</span>
        <span class="text-right">Weekend</span>
        <span class="text-right">Total gross</span>
        <span class="text-center">Weeks</span>
        <span></span>
      </div>
      {restRows.map((entry) => {
        const href = entry.tmdb_id ? `/movie/${entry.tmdb_id}` : null;
        return (
          <div class="bo-cols py-2.5 transition-colors hover:bg-[var(--bg-hover)]" style="border-top: 1px solid var(--border);">
            <span class="pl-1">
              <span class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: var(--bg-hover); color: var(--text-primary);">
                {entry.rank}
              </span>
            </span>
            <a href={href} class="block">
              <img loading="lazy" src={getPosterUrl(entry.poster_path)} alt={entry.movie_title} class="rounded object-cover" style="width: 32px; height: 48px;" />
            </a>
            <a href={href} class="font-semibold hover:text-green-500 transition-colors min-w-0" style="color: var(--text-primary);">{entry.movie_title}</a>
            <span class="text-right font-semibold" style="color: var(--text-primary);">
              {formatMoney(entry.three_day_gross)}
              {entry.four_day_gross ? <span class="block text-xs font-normal" style="color: var(--text-muted);">4-day {formatMoney(entry.four_day_gross)}</span> : null}
            </span>
            <span class="text-right font-bold text-green-500">{formatMoney(entry.total_gross)}</span>
            <span class="text-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold" style="background-color: var(--bg-hover); color: var(--text-primary);">
                {entry.weeks_in_release || 1}
              </span>
            </span>
            <span class="text-right">
              {href && (
                <a href={href} class="inline-flex items-center text-sm font-bold rounded-full px-3.5 py-1 whitespace-nowrap" style="border: 1px solid #22c55e; color: #22c55e;">View ›</a>
              )}
            </span>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Historical Data -->
  {hasDbData && weeks.length > 1 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <h2 class="text-xl md:text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--text-primary);">
        <span class="text-green-500">📈</span>
        Previous Weeks
      </h2>

      <div class="space-y-8">
        {weeks.slice(1, 6).map((weekKey) => (
          <div class="rounded-xl p-6" style="background-color: var(--bg-card); border: 1px solid var(--border);">
            <h3 class="text-lg font-bold mb-4" style="color: var(--text-primary);">
              Week of {formatDate(weekKey)}
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {weeklyData[weekKey].slice(0, 6).map((entry) => (
                <a
                  href={entry.tmdb_id ? `/movie/${entry.tmdb_id}` : '#'}
                  class="flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-[var(--bg-hover)]"
                >
                  <span
                    class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0"
                    style="background: linear-gradient(135deg, #22c55e, #16a34a); color: white;"
                  >
                    {entry.rank}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="font-medium truncate" style="color: var(--text-primary);">{entry.movie_title}</p>
                    <p class="text-xs" style="color: var(--text-muted);">
                      Weekend: {formatMoney(entry.three_day_gross)} | Total: {formatMoney(entry.total_gross)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Info Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="rounded-xl p-6" style="background-color: var(--bg-card); border: 1px solid var(--border);">
      <h3 class="text-lg font-bold mb-4" style="color: var(--text-primary);">
        About Box Office Data
      </h3>
      <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
        Box office data is updated weekly every Monday with the latest weekend earnings.
        The 3-day weekend covers Friday through Sunday, while the 4-day weekend includes
        Monday for holiday weekends. Total gross represents the cumulative domestic earnings
        since the film's theatrical release.
      </p>
      <p class="text-xs mt-4" style="color: var(--text-muted);">
        Data source: The Numbers / Box Office Mojo
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .bo-poster { width: 88px; height: 132px; }
  .bo-money { font-size: 24px; }
  .bo-cols {
    display: grid;
    align-items: center;
    gap: 16px;
    grid-template-columns: 40px 34px minmax(0, 1fr) 100px 100px 56px 80px;
  }
  @media (min-width: 1024px) {
    .bo-poster { width: 104px; height: 156px; }
    .bo-money { font-size: 26px; }
    .bo-cols { grid-template-columns: 40px 34px minmax(0, 1fr) 120px 120px 64px 100px; }
  }
</style>

