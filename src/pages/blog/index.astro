---
import BaseLayout from '../../layouts/BaseLayout.astro';

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';

let posts: any[] = [];
try {
  const res = await fetch(`${POSTGREST_URL}/blog_posts?status=eq.published&select=slug,title,deck,tags,cover_image,accent,angle,published_at&order=published_at.desc&limit=60`);
  if (res.ok) posts = await res.json();
} catch (e) { posts = []; }

// "Now Showing" — the 2 most current posts, subtitle/timecode treatment.
// "More From The Blog" — everything else, vinyl sleeve shelf.
const nowShowing = posts.slice(0, 2);
const rest = posts.slice(2);

const cover = (p: string | null) => p ? (p.startsWith('http') ? p : `https://image.tmdb.org/t/p/w780${p}`) : '/images/no-poster.svg';
const angleLabel = (a: string | null) => a ? a.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) : '';
const timecode = (s: string | null) => s ? `${new Date(s).toLocaleTimeString('en-GB', { hour12: false })}:00` : '00:00:00:00';

const _ogPosters = posts.map((p) => p.cover_image).filter((p) => p && !p.startsWith('http')).slice(0, 5).join('|');
const ogImage = _ogPosters
  ? `/api/og.png?type=digital&posters=${encodeURIComponent(_ogPosters)}`
    + `&accent=${encodeURIComponent('#f59e0b')}`
    + `&eyebrow=${encodeURIComponent('TRENDIMOVIES BLOG')}`
    + `&eyebrowEmoji=${encodeURIComponent('📝')}`
    + `&headline=${encodeURIComponent('The Blog')}`
    + `&subtitle=${encodeURIComponent('Recaps, takes and franchise deep-dives from the TrendiMovies desk')}`
    + `&ogurl=${encodeURIComponent('trendimovies.com/blog')}`
  : '/api/og.png?type=digital&accent=%23f59e0b&eyebrow=TRENDIMOVIES%20BLOG&headline=The%20Blog';

const pageTitle = 'Blog';
const pageDesc = 'Recaps, takes and franchise deep-dives from the TrendiMovies desk — new posts most days.';
---

<BaseLayout title={pageTitle} description={pageDesc} image={ogImage}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,900&display=swap" rel="stylesheet" />

  <section class="blh">
    <div class="blh-wrap">
      <div class="blh-head">
        <div class="blh-kicker"><span class="blh-dot"></span> TrendiMovies</div>
        <h1 class="blh-title">The Blog</h1>
        <p class="blh-sub">Recaps, comparisons and franchise takes — the stuff that doesn&rsquo;t fit in a review. New posts most days.</p>
      </div>

      {posts.length === 0 && (
        <p class="blh-empty">No posts published yet. Check back soon.</p>
      )}

      {nowShowing.length > 0 && (
        <div class="blh-section">
          <div class="blh-section-head"><h2>Now Showing</h2><span>Most Current</span></div>
          <div class="tc-row" style={`--tc-cols:${nowShowing.length}`}>
            {nowShowing.map((p) => (
              <a class="tc-frame" href={`/blog/${p.slug}`} style={`--glow:${p.accent || '#f59e0b'};background-image:linear-gradient(180deg, rgba(6,6,8,.55) 0%, transparent 22%, transparent 60%, rgba(6,6,8,.92) 100%), url('${cover(p.cover_image)}')`}>
                <div class="tc-slate">
                  <span>{angleLabel(p.angle)}</span>
                  {p.tags?.[0] && <span class="tc-badge">{p.tags[0]}</span>}
                </div>
                <div class="tc-bottom">
                  <p class="tc-sub">{p.title}</p>
                  {p.published_at && <span class="tc-tc" style={`color:${p.accent || '#f59e0b'}`}>{timecode(p.published_at)}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {rest.length > 0 && (
        <div class="blh-section">
          <div class="blh-section-head"><h2>More From The Blog</h2><span>{rest.length} Post{rest.length === 1 ? '' : 's'}</span></div>
          <div class="vs-shelf">
            <div class="vs-row">
              {rest.map((p) => (
                <a class="vs-sleeve" href={`/blog/${p.slug}`} style={`--glow:${p.accent || '#f59e0b'};background-image:linear-gradient(180deg, rgba(10,6,16,.6) 0%, transparent 28%, transparent 58%, rgba(10,6,16,.88) 100%), url('${cover(p.cover_image)}')`}>
                  <span class="vs-kicker">{p.tags?.[0] || angleLabel(p.angle)}</span>
                  <span class="vs-title">{p.title}</span>
                  <div class="vs-label" style={`--ring:${p.accent || '#f59e0b'}`}></div>
                </a>
              ))}
            </div>
            <div class="vs-ledge"></div>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blh{position:relative;padding:0 0 80px}
  .blh-wrap{max-width:1180px;margin:0 auto;padding:52px 28px 0}
  .blh-head{max-width:720px;margin-bottom:44px}
  .blh-kicker{display:inline-flex;align-items:center;gap:9px;font-weight:800;letter-spacing:3px;font-size:12px;color:#f59e0b;text-transform:uppercase;margin-bottom:16px}
  .blh-dot{width:7px;height:7px;border-radius:50%;background:#f59e0b;box-shadow:0 0 12px #f59e0b}
  .blh-title{font-family:'Fraunces',Georgia,serif;font-weight:900;font-size:clamp(40px,6vw,64px);line-height:1.02;letter-spacing:-1.5px;color:#fff;margin:0 0 14px}
  .blh-sub{font-size:18px;line-height:1.6;color:#b9b6c0;max-width:56ch}
  .blh-empty{color:#888;padding:40px 0}

  .blh-section{margin-bottom:56px}
  .blh-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px}
  .blh-section-head h2{font-family:'Fraunces',Georgia,serif;font-size:20px;font-weight:900;color:#fff;margin:0}
  .blh-section-head span{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8a8790}

  /* Now Showing — subtitle / timecode */
  .tc-row{display:grid;grid-template-columns:repeat(var(--tc-cols,2),1fr);gap:24px}
  .tc-frame{aspect-ratio:2/3;border-radius:16px;position:relative;overflow:hidden;background-size:cover;background-position:center;
    display:flex;flex-direction:column;justify-content:space-between;padding:20px;text-decoration:none;color:inherit;
    border:1px solid color-mix(in srgb, var(--glow) 40%, transparent);
    box-shadow:0 20px 50px rgba(0,0,0,.45), 0 0 26px 1px color-mix(in srgb, var(--glow) 30%, transparent);
    transition:transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease, border-color .35s ease;
    animation:tc-pulse 3.4s ease-in-out infinite}
  .tc-frame:hover{transform:translateY(-8px) scale(1.015);animation-play-state:paused;
    border-color:color-mix(in srgb, var(--glow) 75%, transparent);
    box-shadow:0 30px 70px rgba(0,0,0,.55), 0 0 55px 10px color-mix(in srgb, var(--glow) 65%, transparent)}
  @keyframes tc-pulse{
    0%,100%{box-shadow:0 20px 50px rgba(0,0,0,.45), 0 0 26px 1px color-mix(in srgb, var(--glow) 30%, transparent)}
    50%{box-shadow:0 20px 50px rgba(0,0,0,.45), 0 0 44px 6px color-mix(in srgb, var(--glow) 55%, transparent)}
  }
  @media (prefers-reduced-motion: reduce){.tc-frame{animation:none;transition:none}}
  .tc-slate{display:flex;justify-content:space-between;align-items:center;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.78)}
  .tc-badge{background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.28);padding:3px 9px;border-radius:4px}
  .tc-bottom{display:flex;flex-direction:column;align-items:center;gap:10px}
  .tc-sub{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-weight:700;font-size:19px;text-align:center;color:#fff;
    text-shadow:-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000,1px 1px 0 #000,0 2px 10px rgba(0,0,0,.6);line-height:1.32;max-width:94%}
  .tc-tc{align-self:flex-end;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums;font-size:11px;letter-spacing:.04em}

  /* More From The Blog — vinyl sleeve shelf */
  .vs-shelf{background:linear-gradient(180deg,#241533 0%,#1a0f26 100%);border-radius:16px;padding:32px 28px 0;overflow:hidden}
  .vs-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:20px;padding-bottom:28px}
  .vs-sleeve{aspect-ratio:1/1;border-radius:8px;position:relative;background-size:cover;background-position:center top;
    box-shadow:0 18px 34px rgba(0,0,0,.45), 0 0 0 1px color-mix(in srgb, var(--glow) 25%, transparent);
    padding:15px;display:flex;flex-direction:column;justify-content:space-between;text-decoration:none;color:inherit;
    background-color:#2a1a3d;transition:transform .25s ease, box-shadow .25s ease}
  .vs-sleeve:hover{transform:translateY(-5px);box-shadow:0 26px 46px rgba(0,0,0,.5), 0 0 30px 4px color-mix(in srgb, var(--glow) 55%, transparent)}
  .vs-label{position:absolute;bottom:13px;right:13px;width:42px;height:42px;border-radius:50%;
    background:radial-gradient(circle at 50% 50%,var(--ring,#fff) 0 4px,transparent 5px),
                repeating-radial-gradient(circle at 50% 50%,rgba(0,0,0,.3) 0 2px,transparent 2px 5px);
    border:3px solid rgba(255,255,255,.85)}
  .vs-kicker{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.82);text-shadow:0 1px 4px rgba(0,0,0,.6)}
  .vs-title{font-family:'Fraunces',Georgia,serif;font-weight:900;font-size:14px;line-height:1.25;color:#fff;max-width:76%;text-shadow:0 2px 8px rgba(0,0,0,.6)}
  .vs-ledge{height:14px;background:linear-gradient(180deg,#3a2450,#150a1f);border-radius:0 0 16px 16px;box-shadow:inset 0 6px 10px rgba(0,0,0,.4)}

  @media(max-width:640px){
    .tc-row{grid-template-columns:1fr}
    .vs-row{grid-template-columns:repeat(2,1fr)}
  }
</style>
