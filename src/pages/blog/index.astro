---
import BaseLayout from '../../layouts/BaseLayout.astro';

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';

let posts: any[] = [];
try {
  const res = await fetch(`${POSTGREST_URL}/blog_posts?status=eq.published&select=slug,title,deck,tags,cover_image,accent,angle,published_at&order=published_at.desc&limit=60`);
  if (res.ok) posts = await res.json();
} catch (e) { posts = []; }

const featured = posts[0];
const rest = posts.slice(1);
const cover = (p: string | null) => p ? (p.startsWith('http') ? p : `https://image.tmdb.org/t/p/w780${p}`) : '/images/no-poster.svg';
const fmt = (s: string | null) => s ? new Date(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

const _ogPosters = posts.map((p) => p.cover_image).filter((p) => p && !p.startsWith('http')).slice(0, 5).join('|');
const ogImage = _ogPosters
  ? `/api/og.png?type=digital&posters=${encodeURIComponent(_ogPosters)}`
    + `&accent=${encodeURIComponent('#f59e0b')}`
    + `&eyebrow=${encodeURIComponent('TRENDIMOVIES BLOG')}`
    + `&eyebrowEmoji=${encodeURIComponent('📝')}`
    + `&headline=${encodeURIComponent('The Blog')}`
    + `&subtitle=${encodeURIComponent('Recaps, takes and franchise deep-dives from the TrendiMovies desk')}`
    + `&ogurl=${encodeURIComponent('trendimovies.com/blog')}`
  : '/api/og.png?type=digital&accent=%23f59e0b&eyebrow=TRENDIMOVIES%20BLOG&headline=The%20Blog';

const pageTitle = 'Blog';
const pageDesc = 'Recaps, takes and franchise deep-dives from the TrendiMovies desk — new posts most days.';
---

<BaseLayout title={pageTitle} description={pageDesc} image={ogImage}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,900&display=swap" rel="stylesheet" />

  <section class="blh">
    <div class="blh-wrap">
      <div class="blh-head">
        <div class="blh-kicker"><span class="blh-dot"></span> TrendiMovies</div>
        <h1 class="blh-title">The Blog</h1>
        <p class="blh-sub">Recaps, comparisons and franchise takes — the stuff that doesn&rsquo;t fit in a review. New posts most days.</p>
      </div>

      {posts.length === 0 && (
        <p class="blh-empty">No posts published yet. Check back soon.</p>
      )}

      {featured && (
        <a class="blh-feature" href={`/blog/${featured.slug}`} style={`--a:${featured.accent || '#f59e0b'}`}>
          <div class="blh-feature-cover"><img src={cover(featured.cover_image)} alt={featured.title} /></div>
          <div class="blh-feature-body">
            <div class="blh-tag">Latest{featured.tags?.length ? ` · ${featured.tags[0]}` : ''}</div>
            <h2 class="blh-feature-h">{featured.title}</h2>
            {featured.deck && <p class="blh-feature-deck">{featured.deck}</p>}
            <div class="blh-meta">
              {featured.published_at && <span class="blh-date">{fmt(featured.published_at)}</span>}
              <span class="blh-read">Read post →</span>
            </div>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="blh-grid">
          {rest.map((p) => (
            <a class="blh-card" href={`/blog/${p.slug}`} style={`--a:${p.accent || '#f59e0b'}`}>
              <div class="blh-card-cover"><img src={cover(p.cover_image)} alt={p.title} loading="lazy" /></div>
              <div class="blh-card-body">
                {p.tags?.[0] && <div class="blh-card-tag">{p.tags[0]}</div>}
                <div class="blh-card-h">{p.title}</div>
                {p.published_at && <div class="blh-card-date">{fmt(p.published_at)}</div>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blh{position:relative;padding:0 0 80px}
  .blh-wrap{max-width:1180px;margin:0 auto;padding:52px 28px 0}
  .blh-head{max-width:720px;margin-bottom:44px}
  .blh-kicker{display:inline-flex;align-items:center;gap:9px;font-weight:800;letter-spacing:3px;font-size:12px;color:#f59e0b;text-transform:uppercase;margin-bottom:16px}
  .blh-dot{width:7px;height:7px;border-radius:50%;background:#f59e0b;box-shadow:0 0 12px #f59e0b}
  .blh-title{font-family:'Fraunces',Georgia,serif;font-weight:900;font-size:clamp(40px,6vw,64px);line-height:1.02;letter-spacing:-1.5px;color:#fff;margin:0 0 14px}
  .blh-sub{font-size:18px;line-height:1.6;color:#b9b6c0;max-width:56ch}
  .blh-empty{color:#888;padding:40px 0}
  /* featured */
  .blh-feature{display:grid;grid-template-columns:340px 1fr;gap:32px;align-items:center;text-decoration:none;
    background:linear-gradient(135deg,color-mix(in srgb,var(--a) 14%,transparent),rgba(255,255,255,.02));
    border:1px solid color-mix(in srgb,var(--a) 26%,rgba(255,255,255,.08));border-radius:24px;padding:26px;margin-bottom:46px;
    box-shadow:0 24px 60px rgba(0,0,0,.4);transition:transform .2s,border-color .2s}
  .blh-feature:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--a) 55%,transparent)}
  .blh-feature-cover{border-radius:16px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,.5);aspect-ratio:16/10}
  .blh-feature-cover img{width:100%;height:100%;object-fit:cover;display:block}
  .blh-tag{color:var(--a);font-weight:800;letter-spacing:2px;font-size:12px;text-transform:uppercase;margin-bottom:14px}
  .blh-feature-h{font-family:'Fraunces',Georgia,serif;font-weight:900;font-size:clamp(26px,3.4vw,40px);line-height:1.08;letter-spacing:-1px;color:#fff;margin:0 0 12px}
  .blh-feature-deck{font-size:17px;line-height:1.55;color:#c3c0cc;margin:0 0 18px;max-width:56ch}
  .blh-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:#9a97a4;font-size:14px}
  .blh-date{color:#9a97a4}
  .blh-read{color:var(--a);font-weight:800;font-size:15px;margin-left:auto}
  /* grid */
  .blh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
  .blh-card{text-decoration:none;border-radius:18px;overflow:hidden;background:#141216;border:1px solid rgba(255,255,255,.07);transition:transform .2s,border-color .2s}
  .blh-card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--a) 55%,transparent)}
  .blh-card-cover{position:relative;aspect-ratio:16/10;overflow:hidden}
  .blh-card-cover img{width:100%;height:100%;object-fit:cover;display:block}
  .blh-card-body{padding:16px 17px 20px}
  .blh-card-tag{font-size:11px;color:var(--a);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}
  .blh-card-h{font-family:'Fraunces',Georgia,serif;font-weight:900;font-size:18px;line-height:1.25;color:#fff;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px}
  .blh-card-date{font-size:12px;color:#8a8790}
  @media(max-width:640px){
    .blh-feature{grid-template-columns:1fr;text-align:center;gap:20px}
    .blh-meta{justify-content:center}.blh-read{margin-left:0}
    .blh-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
  }
</style>
