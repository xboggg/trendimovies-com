---
// /app - the Telegram Mini App home (phone-first, Netflix-style).
// Standalone page: no site header/footer and NO ads. Data comes from /api/app/home, movie buttons from /api/app/title.
// The previous Mini App (the whole website opened inside Telegram) is untouched: it is simply "/" and is linked from
// the bottom of this page ("Open the full website").
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#0a0a0a">
  <title>TrendiMovies Mini</title>
  <meta name="description" content="The mini version of TrendiMovies, made for your phone. Browse trending movies and series, filter by genre, year and language, and get 720p or 1080p downloads.">
  <!-- link preview (WhatsApp, Telegram, ...): the site's standard preview image (63 KB; WhatsApp drops previews over about 300 KB) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="TrendiMovies">
  <meta property="og:url" content="https://trendimovies.com/app">
  <meta property="og:title" content="TrendiMovies Mini: the website, made for your phone">
  <meta property="og:description" content="Trending movies and series, new episodes, filters by genre, year and language, and 720p or 1080p downloads. No ads.">
  <meta property="og:image" content="https://trendimovies.com/images/og-default.jpg">
  <meta property="og:image:secure_url" content="https://trendimovies.com/images/og-default.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="TrendiMovies Mini: the website, made for your phone">
  <meta name="twitter:image" content="https://trendimovies.com/images/og-default.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Figtree:wght@400;500;600;700&display=swap">
  <style is:inline>
    :root {
      --bg: #0a0a0a; --surface: #141414; --card: #1a1a1a; --line: #2a2a2a; --text: #ffffff; --muted: #a0a0a0;
      --accent: #e50914; --accent-hover: #f40612; --ok: #3ddc84;
      --font-display: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
      --font-body: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    html, body { background: var(--bg); margin: 0; }
    body { color: var(--text); font-family: var(--font-body); font-size: 15px; line-height: 1.4; -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
    button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
    .app { max-width: 480px; margin: 0 auto; min-height: 100vh; background: var(--bg); position: relative; }

    .brand { display: flex; align-items: center; justify-content: space-between; padding: 16px 16px 4px; }
    .brand .logo { height: 40px; width: auto; display: block; }
    .brand h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 30px; letter-spacing: .04em; color: var(--accent); }
    .brand span { color: var(--muted); font-size: 12.5px; }

    .hero { margin: 8px 16px 0; }
    .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; border-radius: 14px; scrollbar-width: none; }
    .slides::-webkit-scrollbar { display: none; }
    .slide { flex: 0 0 100%; scroll-snap-align: center; position: relative; aspect-ratio: 4 / 5; max-height: 440px; overflow: hidden; text-align: left; display: block;
             background: radial-gradient(120% 80% at 70% 10%, hsl(var(--h) 60% 28%) 0%, hsl(calc(var(--h) + 30) 55% 10%) 48%, #0a0a0a 100%); }
    .slide .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
    .slide::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, #0a0a0a 10%, #0a0a0a00 62%); }
    .slide .inner { position: absolute; inset: auto 0 0 0; z-index: 1; padding: 18px; display: flex; flex-direction: column; gap: 8px; }
    .tag { align-self: flex-start; background: var(--accent); color: #fff; font-weight: 700; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; }
    .hero h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 44px; line-height: .95; letter-spacing: .02em; text-wrap: balance; text-shadow: 0 2px 12px #000; }
    .hero p { margin: 0; color: #d0d0d0; font-size: 13.5px; }
    .cta { margin-top: 4px; display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--accent); color: #fff; font-weight: 700; font-size: 16px; padding: 13px 16px; border-radius: 10px; width: 100%; text-align: center; }
    .cta:hover { background: var(--accent-hover); }
    .cta.soft { background: var(--card); border: 1px solid var(--line); }
    .dots { display: flex; justify-content: center; gap: 6px; margin-top: 10px; }
    .dot { width: 6px; height: 6px; border-radius: 99px; background: var(--line); transition: width .2s, background .2s; }
    .dot.on { width: 18px; background: var(--accent); }

    .row { margin-top: 22px; }
    .row h3 { margin: 0 16px 10px; font-family: var(--font-display); font-weight: 400; font-size: 24px; letter-spacing: .05em; }
    .rowhead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0 16px 10px; }
    .rowhead h3 { margin: 0; }
    .more { font-size: 13px; font-weight: 700; color: var(--accent); padding: 4px 0 4px 10px; white-space: nowrap; }
    .mhead { display: flex; align-items: center; gap: 12px; padding: 14px 16px 0; }
    .mback { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 99px; border: 1px solid var(--line); display: grid; place-items: center; font-size: 22px; line-height: 1; }
    .mhead h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 28px; letter-spacing: .04em; }
    .rlist { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px 0; }
    .rlist .rcard { flex: none; }
    .rail { display: flex; gap: 10px; overflow-x: auto; padding: 0 16px 4px; scroll-snap-type: x proximity; scrollbar-width: none; }
    .rail::-webkit-scrollbar { display: none; }
    .poster { flex: 0 0 118px; aspect-ratio: 2 / 3; border-radius: 8px; position: relative; overflow: hidden; scroll-snap-align: start; display: block; text-align: left;
              background: linear-gradient(160deg, hsl(var(--h) 55% 30%), hsl(calc(var(--h) + 40) 60% 11%)); }
    .poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .poster .t { position: absolute; inset: auto 0 0 0; padding: 22px 8px 8px; font-weight: 700; font-size: 12.5px; line-height: 1.15; background: linear-gradient(to top, #000000d0, transparent); text-wrap: balance; }
    .poster .b { position: absolute; top: 6px; left: 6px; background: var(--accent); font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 3px; letter-spacing: .04em; z-index: 1; }
    .poster .date { position: absolute; inset: auto 0 0 0; padding: 26px 6px 7px; background: linear-gradient(to top, #000000ee 20%, #00000000); display: flex; flex-direction: column; gap: 1px; z-index: 1; }
    .poster .date b { font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
    .poster .date i { font-style: normal; font-size: 11px; color: var(--ok); font-weight: 600; }
    .poster .y { position: absolute; left: 6px; bottom: 6px; background: #000000b8; color: #fff; font-size: 10.5px; font-weight: 700; padding: 1px 6px; border-radius: 10px; letter-spacing: .02em; z-index: 1; }
    .poster:active { transform: scale(.97); }

    .rcard { flex: 0 0 292px; scroll-snap-align: start; text-align: left; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px; display: flex; gap: 12px; }
    .rcard .pic { flex: 0 0 74px; aspect-ratio: 2 / 3; border-radius: 6px; overflow: hidden; background: var(--line); }
    .rcard .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rcard .body { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .rcard .rt { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
    .rcard .rt b { font-family: var(--font-display); font-weight: 400; font-size: 21px; letter-spacing: .04em; line-height: 1; }
    .rcard .rt span { font-size: 11.5px; font-weight: 700; padding: 2px 7px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
    .rcard .rt span.good { color: var(--ok); border-color: var(--ok); }
    .rcard .rt span.bad { color: var(--accent); border-color: var(--accent); }
    .rcard p { margin: 0; font-size: 13px; line-height: 1.35; color: #d8d8d8; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .rcard .go { margin-top: auto; font-size: 12.5px; font-weight: 700; color: var(--accent); }

    .full { display: block; margin: 28px 16px 8px; text-align: center; color: var(--muted); font-size: 13px; padding: 12px; border: 1px solid var(--line); border-radius: 10px; }

    .fbar { display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px 0; scrollbar-width: none; }
    .fbar::-webkit-scrollbar { display: none; }
    .fchip { flex: 0 0 auto; padding: 8px 13px; border: 1px solid var(--line); border-radius: 99px; background: var(--card); color: var(--text); font-size: 13px; font-weight: 600; white-space: nowrap; }
    .fchip.on { border-color: var(--accent); background: #e5091426; }
    .fchip.clear { color: var(--accent); border-style: dashed; background: none; }
    .fcount { margin: 10px 16px 0; color: var(--muted); font-size: 12.5px; }
    .showmore { width: calc(100% - 32px); }
    .optlist { max-height: 58vh; overflow-y: auto; margin-top: 10px; }
    .opt { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 14px 6px; border-bottom: 1px solid var(--line); font-weight: 600; text-align: left; }
    .opt.on { color: var(--accent); }
    .tabs { position: sticky; bottom: 0; z-index: 20; display: grid; grid-template-columns: repeat(5, 1fr); background: var(--surface); border-top: 1px solid var(--line);
            padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px)); margin-top: 20px; }
    .tabs button { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 0; font-size: 11.5px; color: var(--muted); font-weight: 600; }
    .tabs svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .tabs button[aria-selected="true"] { color: var(--text); }
    .tabs button[aria-selected="true"] svg { stroke: var(--accent); }

    .view { display: none; min-height: 60vh; }
    .view.on { display: block; }
    .search { margin: 14px 16px 0; display: block; width: calc(100% - 32px); background: var(--card); border: 1px solid var(--line); color: var(--text); border-radius: 10px; padding: 12px 14px; font: inherit; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 14px 16px 0; }
    .grid .poster { flex: none; width: 100%; }
    .empty { margin: 40px 16px; text-align: center; color: var(--muted); }
    .empty b { display: block; color: var(--text); font-family: var(--font-display); font-weight: 400; font-size: 24px; letter-spacing: .05em; margin-bottom: 4px; }
    .skel { margin: 16px; height: 300px; border-radius: 14px; background: linear-gradient(90deg, #141414, #1d1d1d, #141414); background-size: 200% 100%; animation: sh 1.4s infinite; }
    @keyframes sh { to { background-position: -200% 0; } }

    .scrim { position: fixed; inset: 0; background: #000000a0; z-index: 40; opacity: 0; pointer-events: none; transition: opacity .2s; }
    .scrim.on { opacity: 1; pointer-events: auto; }
    .sheet { position: fixed; left: 50%; bottom: 0; width: min(100%, 480px); transform: translate(-50%, 100%); transition: transform .25s ease; z-index: 41; background: var(--surface);
             border: 1px solid var(--line); border-bottom: 0; border-radius: 18px 18px 0 0; padding: 16px 16px calc(18px + env(safe-area-inset-bottom, 0px)); visibility: hidden; max-height: 85vh; overflow-y: auto; }
    .sheet.on { transform: translate(-50%, 0); visibility: visible; }
    .sheet .grab { width: 40px; height: 4px; border-radius: 4px; background: var(--line); margin: 0 auto 14px; }
    .sheet .top { display: flex; gap: 14px; }
    .sheet .poster { flex: 0 0 84px; }
    .sheet h4 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 28px; line-height: 1; letter-spacing: .03em; }
    .sheet .meta { color: var(--muted); font-size: 13px; margin-top: 4px; }
    .sheet .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .sheet .chips span { font-size: 11.5px; font-weight: 600; padding: 3px 9px; border: 1px solid var(--line); border-radius: 12px; color: var(--muted); }
    .sheet .about { margin: 14px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--text, inherit); }
    .sheet .sub { color: var(--muted); font-size: 12.5px; text-align: center; margin: 8px 0 0; }
    details { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
    summary { cursor: pointer; font-weight: 600; font-size: 14px; padding: 4px 0; }
    .q { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 11px 12px; margin-top: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 8px; font-weight: 600; }
    .q span { color: var(--muted); font-weight: 500; font-size: 13px; }
    .save { margin-top: 12px; width: 100%; padding: 11px; border: 1px solid var(--line); border-radius: 10px; font-weight: 600; color: var(--muted); }
    .save[aria-pressed="true"] { color: var(--ok); border-color: var(--ok); }
    .pagelink { display: block; margin-top: 10px; text-align: center; font-size: 13px; color: var(--muted); text-decoration: underline; }
    @media (prefers-reduced-motion: reduce) { .sheet, .scrim, .dot, .skel { transition: none; animation: none; } }
  </style>
</head>
<body>
  <div class="app" id="app">
    <section class="view on" id="v-home">
      <div class="brand"><img class="logo" src="/images/logo-header.png" alt="TrendiMovies" width="678" height="224"><span>Tap any poster</span></div>
      <div id="home-body"><div class="skel"></div></div>
    </section>

    <section class="view" id="v-more">
      <div class="mhead"><button class="mback" data-mback aria-label="Back">‹</button><h2 id="more-title"></h2></div>
      <div id="more-body"></div>
    </section>

    <section class="view" id="v-movies">
      <div class="brand"><h1>MOVIES</h1><span>Filter and sort</span></div>
      <div class="fbar" id="movies-fbar"></div>
      <p class="fcount" id="movies-count"></p>
      <div class="grid" id="movies-grid"><div class="skel" style="grid-column: 1 / -1"></div></div>
      <button class="full showmore" id="movies-more" data-showmore="movies" hidden>Show more</button>
      <a class="full" href="/movies/latest">See every new movie on the website</a>
    </section>

    <section class="view" id="v-series">
      <div class="brand"><h1>SERIES</h1><span>Filter and sort</span></div>
      <div class="fbar" id="series-fbar"></div>
      <p class="fcount" id="series-count"></p>
      <div class="grid" id="series-grid"><div class="skel" style="grid-column: 1 / -1"></div></div>
      <button class="full showmore" id="series-more" data-showmore="series" hidden>Show more</button>
      <a class="full" href="/series/new-episodes">See every new episode on the website</a>
    </section>

    <section class="view" id="v-search">
      <input class="search" id="q" type="search" placeholder="Search movies and series" autocomplete="off" enterkeyhint="search">
      <div class="fbar" id="search-fbar"></div>
      <div class="grid" id="search-grid"></div>
      <p class="empty" id="search-empty" hidden><b>No match</b>Try another name.</p>
    </section>

    <section class="view" id="v-list">
      <div class="brand"><h1>MY LIST</h1><span>Saved on this phone</span></div>
      <div class="grid" id="list-grid"></div>
      <p class="empty" id="list-empty"><b>Nothing saved yet</b>Open a movie and tap Save to My List.</p>
    </section>

    <nav class="tabs" role="tablist" aria-label="Sections">
      <button role="tab" aria-selected="true" data-view="home"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Home</button>
      <button role="tab" aria-selected="false" data-view="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>Search</button>
      <button role="tab" aria-selected="false" data-view="movies"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg>Movies</button>
      <button role="tab" aria-selected="false" data-view="series"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="2"/><path d="M8 21h8"/></svg>Series</button>
      <button role="tab" aria-selected="false" data-view="list"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.3-9A5.4 5.4 0 0 1 12 6.2 5.4 5.4 0 0 1 21.3 12C19 16.4 12 21 12 21z"/></svg>My List</button>
    </nav>
  </div>

  <div class="scrim" id="scrim"></div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Title details"></div>

  <script is:inline src="/js/tg-miniapp.js?v=20261026d" defer></script>
  <script is:inline>
    (function () {
      'use strict';
      var D = null, items = [], byKey = {}, saved = [], searchTimer = 0, heroNow = 0, heroPause = false;
      var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], DAY = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      var $ = function (id) { return document.getElementById(id); };

      function setHtml(el, markup) {
        var doc = new DOMParser().parseFromString('<body>' + markup, 'text/html');
        el.replaceChildren.apply(el, Array.prototype.slice.call(doc.body.childNodes));
      }
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
      function hue(t) { return (String(t).length * 37 + String(t).charCodeAt(0) * 7) % 360; }
      function dt(iso) { return new Date(iso + 'T00:00:00'); }
      function dlabel(iso) { var d = dt(iso); return DAY[d.getDay()] + ' ' + d.getDate() + ' ' + MON[d.getMonth()]; }
      function rel(iso) { var n = Math.round((dt(iso) - dt(D.today)) / 86400000); return n <= 0 ? 'Out now' : (n === 1 ? 'Tomorrow' : 'In ' + n + ' days'); }

      // saved list: only a per-viewer convenience, so every storage call is wrapped
      function loadSaved() { try { saved = JSON.parse(localStorage.getItem('tmAppList') || '[]') || []; } catch (e) { saved = []; } }
      function storeSaved() { try { localStorage.setItem('tmAppList', JSON.stringify(saved)); } catch (e) {} }
      function keyOf(it) { return it.type + ':' + (it.id || it.t); }
      function isSaved(it) { return saved.some(function (s) { return s.k === keyOf(it); }); }

      function register(c) {
        var k = keyOf(c);
        if (!byKey[k]) { byKey[k] = c; items.push(c); }
        else {
          if (c.date && !byKey[k].date) byKey[k].date = c.date;
          if (c.ep && !byKey[k].ep) byKey[k].ep = c.ep;
          if (c.y && !byKey[k].y) byKey[k].y = c.y;
        }
        return byKey[k];
      }
      function poster(c, badge, withDate) {
        var tag = badge || c.ep || '';
        var date = (withDate && c.date) ?'<span class="date"><b>' + esc(dlabel(c.date)) + '</b><i>' + esc(rel(c.date)) + '</i></span>' : '';
        return '<button class="poster" data-k="' + esc(keyOf(c)) + '" style="--h:' + hue(c.t) + '" aria-label="Open ' + esc(c.t) + '">' +
          (c.img ? '<img src="' + esc(c.img) + '" alt="' + esc(c.t) + '" loading="lazy">' : '<span class="t">' + esc(c.t) + '</span>') +
          (tag ? '<span class="b">' + esc(tag) + '</span>' : '') + date + ((c.y && !date) ? '<span class="y">' + esc(c.y) + '</span>' : '') + '</button>';
      }
      function grid(list) { return list.map(function (c) { return poster(c); }).join(''); }
      function head(title, key, showMore) {
        return '<div class="rowhead"><h3>' + esc(title) + '</h3>' + (showMore ? '<button class="more" data-more="' + esc(key) + '">More \u203a</button>' : '') + '</div>';
      }
      function reviewCard(r) {
        var s = parseInt(r.rt, 10), cls = r.rt ? (s >= 70 ? 'good' : (s < 50 ? 'bad' : '')) : '';
        return '<a class="rcard" href="' + esc(r.href) + '"><div class="pic">' + (r.img ? '<img src="' + esc(r.img) + '" alt="" loading="lazy">' : '') + '</div><div class="body">' +
          '<div class="rt"><b>' + esc(r.t) + '</b>' + (r.rt ? '<span class="' + cls + '">RT ' + esc(r.rt) + '</span>' : '') + '</div>' +
          '<p>' + esc(r.h) + '</p><span class="go">Read review</span></div></a>';
      }

      function render() {
        D.rows.forEach(function (r) { r.items = r.items.map(register); });
        D.hero = D.hero.map(function (h) { var base = register(h); return {c: base, img: h.img, tag: h.tag}; });
        var html = '';
        html += '<div class="hero" aria-roledescription="carousel" aria-label="Featured movies and series"><div class="slides" id="slides">' +
          D.hero.map(function (h) {
            return '<button class="slide" data-k="' + esc(keyOf(h.c)) + '" style="--h:' + hue(h.c.t) + '" aria-label="Open ' + esc(h.c.t) + '">' +
              (h.img ? '<img class="bg" src="' + esc(h.img) + '" alt="">' : '') + '<div class="inner"><span class="tag">' + esc(h.tag) + '</span>' +
              '<h2>' + esc(h.c.t) + '</h2><p>' + (h.c.type === 'series' ? 'Series' : 'Movie') + (h.c.ep ? ' · ' + esc(h.c.ep) : '') + '</p>' +
              '<span class="cta">' + (h.c.type === 'series' ? 'Open' : 'Download') + '</span></div></button>';
          }).join('') + '</div><div class="dots" id="dots">' + D.hero.map(function () { return '<span class="dot"></span>'; }).join('') + '</div></div>';
        D.rows.forEach(function (r) {
          html += '<div class="row">' + head(r.title, r.key, r.total > r.items.length) + '<div class="rail">' + r.items.map(function (c) { return poster(c, '', r.key === 'digital'); }).join('') + '</div></div>';
        });
        if (D.reviews && D.reviews.length) {
          html += '<div class="row">' + head(D.reviewsTitle || 'Movie Reviews', 'reviews', (D.reviewsTotal || 0) > D.reviews.length) + '<div class="rail">' + D.reviews.map(reviewCard).join('') + '</div></div>';
        }
        html += '<a class="full" href="/">Open the full website</a>';
        setHtml($('home-body'), html);
        startHero();
      }

      // hero carousel
      function startHero() {
        var slides = $('slides'), dots = document.querySelectorAll('.dot');
        if (!slides) return;
        var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function sync() { dots.forEach(function (d, n) { d.classList.toggle('on', n === heroNow); }); }
        slides.addEventListener('scroll', function () {
          var n = Math.round(slides.scrollLeft / slides.clientWidth);
          if (n !== heroNow && n >= 0 && n < D.hero.length) { heroNow = n; sync(); }
        });
        ['pointerdown', 'touchstart'].forEach(function (ev) {
          slides.addEventListener(ev, function () { heroPause = true; setTimeout(function () { heroPause = false; }, 9000); }, {passive: true});
        });
        if (!calm) setInterval(function () {
          if (heroPause || document.hidden || $('sheet').classList.contains('on')) return;
          heroNow = (heroNow + 1) % D.hero.length;
          slides.scrollTo({left: slides.clientWidth * heroNow, behavior: 'smooth'});
          sync();
        }, 5000);
        sync();
      }

      // Movies and Series tabs: 60 per page with filters, from /api/app/browse (the first page loads when the tab is first opened)
      var BR = {
        movies: {f: {}, meta: null, items: [], total: 0, page: 0, busy: false, started: false},
        series: {f: {}, meta: null, items: [], total: 0, page: 0, busy: false, started: false}
      };
      function ensureBrowse(kind) { if (!BR[kind].started) { BR[kind].started = true; loadBrowse(kind, true); } }
      function browseQuery(kind, page) {
        var f = BR[kind].f, q = ['kind=' + kind, 'page=' + page];
        ['genre', 'lang', 'year', 'sort'].forEach(function (k) { if (f[k]) q.push(k + '=' + encodeURIComponent(f[k])); });
        ['rating', 'nolly', 'running'].forEach(function (k) { if (f[k]) q.push(k + '=1'); });
        return q.join('&');
      }
      function loadBrowse(kind, reset) {
        var S = BR[kind];
        if (S.busy) return;
        S.busy = true;
        var page = reset ? 1 : S.page + 1;
        if (reset) setHtml($(kind + '-grid'), '<div class="skel" style="grid-column: 1 / -1"></div>');
        fetch('/api/app/browse?' + browseQuery(kind, page)).then(function (r) { if (!r.ok) throw new Error('bad'); return r.json(); }).then(function (j) {
          S.meta = j.meta; S.total = j.total; S.page = j.page; S.hasMore = j.hasMore;
          var fresh = j.items.map(register);
          S.items = reset ? fresh : S.items.concat(fresh);
          S.busy = false;
          renderBrowse(kind);
        }).catch(function () {
          S.busy = false;
          if (reset) { S.started = false; setHtml($(kind + '-grid'), '<p class="empty" style="grid-column: 1 / -1"><b>Could not load</b>Open the tab again to retry.</p>'); }
        });
      }
      function filterLabel(list, key, fallback) {
        for (var i = 0; i < list.length; i++) if ((list[i].key || list[i][0]) === key) return list[i].label || list[i][1];
        return fallback;
      }
      function anyFilter(kind) {
        var S = BR[kind], f = S.f;
        return !!(f.genre || f.lang || f.year || f.rating || f.nolly || f.running || (f.sort && S.meta && f.sort !== S.meta.defaultSort));
      }
      function chipHtml(kind, field, label, on) {
        return '<button class="fchip' + (on ? ' on' : '') + '" data-open="' + field + '" data-kind="' + kind + '">' + esc(label) + ' ▾</button>';
      }
      function toggleHtml(kind, field, label, on) {
        return '<button class="fchip' + (on ? ' on' : '') + '" data-toggle="' + field + '" data-kind="' + kind + '">' + esc(label) + '</button>';
      }
      function renderBrowse(kind) {
        var S = BR[kind], m = S.meta, f = S.f;
        if (!m) return;
        var sort = f.sort || m.defaultSort, bar = '';
        bar += chipHtml(kind, 'sort', filterLabel(m.sorts, sort, 'Sort'), sort !== m.defaultSort);
        bar += chipHtml(kind, 'genre', f.genre || 'Genre', !!f.genre);
        bar += chipHtml(kind, 'year', f.year ? filterLabel(m.years, f.year, 'Year') : 'Year', !!f.year);
        bar += chipHtml(kind, 'lang', f.lang ? filterLabel(m.langs, f.lang, 'Language') : 'Language', !!f.lang);
        bar += toggleHtml(kind, 'rating', '7+ rating', !!f.rating);
        if (kind === 'movies') bar += toggleHtml(kind, 'nolly', 'Nigerian', !!f.nolly);
        if (kind === 'series') bar += toggleHtml(kind, 'running', 'Still running', !!f.running);
        if (anyFilter(kind)) bar += '<button class="fchip clear" data-clear="1" data-kind="' + kind + '">Clear</button>';
        setHtml($(kind + '-fbar'), bar);
        var noun = kind === 'movies' ? 'movies' : 'series';
        $(kind + '-count').textContent = S.total ? (S.total.toLocaleString('en-US') + ' ' + noun) : '';
        if (!S.items.length) {
          setHtml($(kind + '-grid'), '<p class="empty" style="grid-column: 1 / -1"><b>Nothing matches</b>Try fewer filters' + (anyFilter(kind) ? ' or tap Clear.' : '.') + '</p>');
        } else {
          setHtml($(kind + '-grid'), S.items.map(function (c) { return poster(c); }).join(''));
        }
        $(kind + '-more').hidden = !S.hasMore;
        $(kind + '-more').textContent = 'Show more (' + Math.max(0, S.total - S.items.length).toLocaleString('en-US') + ' left)';
      }
      function searchOpts(field) {
        if (field === 'type') return [['all', 'All'], ['movie', 'Movies'], ['series', 'Series']];
        return [['', 'Any year']].concat(SEARCH_YEARS.map(function (y) { return [y.key, y.label]; }));
      }
      function openPicker(kind, field) {
        var title, opts, cur;
        if (kind === 'search') {
          title = field === 'type' ? 'Show' : 'Year'; opts = searchOpts(field); cur = field === 'type' ? searchType : searchYear;
        } else {
          var S = BR[kind], m = S.meta;
          if (!m) return;
          if (field === 'genre') { title = 'Genre'; opts = [['', 'Any genre']].concat(m.genres.map(function (g) { return [g, g]; })); cur = S.f.genre || ''; }
          else if (field === 'year') { title = 'Year'; opts = [['', 'Any year']].concat(m.years.map(function (y) { return [y.key, y.label]; })); cur = S.f.year || ''; }
          else if (field === 'lang') { title = 'Language'; opts = [['', 'Any language']].concat(m.langs.map(function (l) { return [l.key, l.label]; })); cur = S.f.lang || ''; }
          else { title = 'Sort by'; opts = m.sorts.map(function (o) { return [o.key, o.label]; }); cur = S.f.sort || m.defaultSort; }
        }
        setHtml(sheet, '<div class="grab"></div><h4>' + esc(title) + '</h4><div class="optlist">' + opts.map(function (o) {
          var on = o[0] === cur;
          return '<button class="opt' + (on ? ' on' : '') + '" data-pick="1" data-kind="' + kind + '" data-field="' + field + '" data-val="' + esc(o[0]) + '"><span>' + esc(o[1]) + '</span>' + (on ? '<b>✓</b>' : '') + '</button>';
        }).join('') + '</div>');
        openKey = '';
        scrim.classList.add('on'); sheet.classList.add('on');
      }
      function applyPick(kind, field, val) {
        if (kind === 'search') {
          if (field === 'type') { searchType = val || 'all'; doSearch(); } else { searchYear = val; renderSearch(); }
          renderSearchBar();
          return;
        }
        var S = BR[kind];
        if (field === 'sort' && S.meta && val === S.meta.defaultSort) val = '';
        if (val) S.f[field] = val; else delete S.f[field];
        loadBrowse(kind, true);
      }

      // tabs
      var tabs = document.querySelectorAll('.tabs button');
      function show(name) {
        document.querySelectorAll('.view').forEach(function (v) { v.classList.toggle('on', v.id === 'v-' + name); });
        tabs.forEach(function (b) { b.setAttribute('aria-selected', b.dataset.view === name ? 'true' : 'false'); });
        if (name === 'list') renderList();
        if (name === 'movies' || name === 'series') ensureBrowse(name);
        window.scrollTo(0, 0);
      }
      tabs.forEach(function (b) {
        b.addEventListener('click', function () {
          if (/^#more=/.test(location.hash)) { try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {} navNote(); }
          show(b.dataset.view);
        });
      });

      function renderList() {
        setHtml($('list-grid'), saved.map(function (s) { return poster(s.item); }).join(''));
        $('list-empty').hidden = saved.length > 0;
      }

      // search (the site's own search)
      function posterUrl(p) { return p ? (String(p).indexOf('/images/') === 0 ? p : 'https://image.tmdb.org/t/p/w185' + p) : ''; }
      // Search: the site's own search, plus "Show" (all / movies / series) and a year filter on the results
      var searchType = 'all', searchYear = '', lastSearch = [];
      var SEARCH_YEARS = [
        {key: '2026', label: '2026', from: 2026, to: 2026}, {key: '2025', label: '2025', from: 2025, to: 2025}, {key: '2024', label: '2024', from: 2024, to: 2024},
        {key: '2020s', label: '2020–23', from: 2020, to: 2023}, {key: '2010s', label: '2010s', from: 2010, to: 2019}, {key: 'older', label: 'Before 2010', from: 1900, to: 2009}
      ];
      function renderSearchBar() {
        var typeLabel = filterLabel(searchOpts('type'), searchType, 'All'), yr = '';
        for (var i = 0; i < SEARCH_YEARS.length; i++) if (SEARCH_YEARS[i].key === searchYear) yr = SEARCH_YEARS[i].label;
        setHtml($('search-fbar'), chipHtml('search', 'type', typeLabel, searchType !== 'all') + chipHtml('search', 'year', yr || 'Year', !!searchYear) +
          ((searchType !== 'all' || searchYear) ? '<button class="fchip clear" data-clear="1" data-kind="search">Clear</button>' : ''));
      }
      function renderSearch() {
        var list = lastSearch;
        if (searchYear) {
          var r = SEARCH_YEARS.filter(function (y) { return y.key === searchYear; })[0];
          list = list.filter(function (c) { return c.y && c.y >= r.from && c.y <= r.to; });
        }
        setHtml($('search-grid'), grid(list));
        $('search-empty').hidden = list.length > 0 || $('q').value.trim().length < 2;
      }
      function doSearch() {
        var v = $('q').value.trim();
        if (v.length < 2) { lastSearch = []; setHtml($('search-grid'), ''); $('search-empty').hidden = true; return; }
        fetch('/api/search?q=' + encodeURIComponent(v) + '&type=' + encodeURIComponent(searchType)).then(function (r) { return r.json(); }).then(function (j) {
          if ($('q').value.trim() !== v) return;
          lastSearch = (j.results || []).filter(function (x) { return x && x.id && x.title; }).map(function (x) {
            var type = x.type === 'series' || x.type === 'tv' ? 'series' : 'movie';
            var c = register({t: x.title, img: posterUrl(x.poster_path), type: type, id: Number(x.id), href: (type === 'series' ? '/tv/' : '/movie/') + x.id});
            if (x.year) c.y = Number(x.year);
            return c;
          });
          renderSearch();
        }).catch(function () { lastSearch = []; setHtml($('search-grid'), ''); $('search-empty').hidden = false; });
      }
      $('q').addEventListener('input', function () { clearTimeout(searchTimer); searchTimer = setTimeout(doSearch, 300); });
      renderSearchBar();

      // pop-up
      var sheet = $('sheet'), scrim = $('scrim'), openKey = '';
      function closeSheet() { scrim.classList.remove('on'); sheet.classList.remove('on'); openKey = ''; }
      scrim.addEventListener('click', closeSheet);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSheet(); });

      function runtimeLabel(m) { m = Number(m) || 0; return m ? (m >= 60 ? Math.floor(m / 60) + 'h ' + (m % 60 ? (m % 60) + 'm' : '') : m + 'm').trim() : ''; }
      function sheetShell(c, body, d) {
        d = d || {};
        var kind = c.type === 'series' ? 'Series' : 'Movie';
        var bits = [kind, d.year || c.y, d.seasons ? d.seasons + (d.seasons === 1 ? ' season' : ' seasons') : '', runtimeLabel(d.runtime), d.rating ? '\u2605 ' + d.rating : ''].filter(Boolean);
        var meta = c.date ? 'Digital release · ' + dlabel(c.date) + ' · ' + rel(c.date) : bits.join(' · ');
        var chips = (d.genres && d.genres.length) ? '<div class="chips">' + d.genres.map(function (g) { return '<span>' + esc(g) + '</span>'; }).join('') + '</div>' : '';
        var about = d.overview ? '<p class="about">' + esc(d.overview) + '</p>' : '';
        return '<div class="grab"></div><div class="top"><div class="poster" style="--h:' + hue(c.t) + '">' + (c.img ? '<img src="' + esc(c.img) + '" alt="">' : '') + '</div>' +
          '<div><h4>' + esc(c.t) + '</h4><div class="meta">' + esc(meta) + '</div>' + chips + '</div></div>' + about + body +
          '<button class="save" data-act="save" aria-pressed="' + isSaved(c) + '">' + (isSaved(c) ? 'Saved to My List' : 'Save to My List') + '</button>';
      }
      function openItem(c) {
        if (c.type !== 'movie' && c.type !== 'series') { location.href = c.href; return; }          // request pages are the normal pages
        openKey = keyOf(c);
        setHtml(sheet, sheetShell(c, '<p class="sub">' + (c.type === 'series' ? 'Loading…' : 'Loading the download buttons…') + '</p>'));
        scrim.classList.add('on'); sheet.classList.add('on');
        fetch('/api/app/title?type=' + c.type + '&id=' + c.id).then(function (r) { return r.json(); }).then(function (j) {
          if (openKey !== keyOf(c)) return;
          if (c.type === 'series') {
            setHtml(sheet, sheetShell(c, '<a class="cta" href="' + esc(c.href) + '" style="margin-top:16px">See episodes and downloads</a>', j));
            return;
          }
          var best = j.best || [], more = j.more || [], body;
          if (!best.length && more.length) { best = [more[0]]; more = more.slice(1); }
          function lab(l) { return [l.variant, l.size, l.lang].filter(Boolean).join(' \u00b7 '); }
          if (best.length) {
            body = best.map(function (l, n) {
              return '<a class="cta" href="' + esc(l.tg) + '" style="margin-top:' + (n ? 10 : 16) + 'px">Get ' + esc(l.quality || 'it') + ' in Telegram' + (lab(l) ? ' \u00b7 ' + esc(lab(l)) : '') + '</a>';
            }).join('') + '<p class="sub">The delivery bot opens and sends the file to you.</p>';
            if (more.length) {
              body += '<details><summary>Other versions</summary>' + more.map(function (l) {
                return '<a class="q" href="' + esc(l.tg) + '">' + esc(l.quality || 'File') + '<span>' + esc(lab(l)) + '</span></a>';
              }).join('') + '</details>';
            }
          } else {
            body = '<p class="sub" style="margin-top:16px">' + (c.date && c.date > D.today ? 'Not out yet.' : 'No Telegram file yet.') + '</p>' +
              '<a class="cta soft" href="' + esc(c.href) + '" style="margin-top:12px">Open the movie page</a>';
          }
          body += '<a class="pagelink" href="' + esc(c.href) + '">Open the full movie page</a>';
          setHtml(sheet, sheetShell(c, body, j));
        }).catch(function () {
          if (openKey !== keyOf(c)) return;
          setHtml(sheet, sheetShell(c, '<a class="cta soft" href="' + esc(c.href) + '" style="margin-top:16px">Open the ' + (c.type === 'series' ? 'series' : 'movie') + ' page</a>'));
        });
      }
      sheet.addEventListener('click', function (e) {
        var pk = e.target.closest('[data-pick]');
        if (pk) { applyPick(pk.getAttribute('data-kind'), pk.getAttribute('data-field'), pk.getAttribute('data-val')); closeSheet(); return; }
        var b = e.target.closest('[data-act="save"]'); if (!b || !openKey) return;
        var c = byKey[openKey], at = -1;
        saved.forEach(function (s, n) { if (s.k === openKey) at = n; });
        if (at === -1) saved.push({k: openKey, item: {t: c.t, img: c.img, type: c.type, id: c.id, href: c.href}}); else saved.splice(at, 1);
        storeSaved();
        b.setAttribute('aria-pressed', at === -1 ? 'true' : 'false');
        b.textContent = at === -1 ? 'Saved to My List' : 'Save to My List';
      });

      $('app').addEventListener('click', function (e) {
        var op = e.target.closest('[data-open]');
        if (op) { openPicker(op.getAttribute('data-kind'), op.getAttribute('data-open')); return; }
        var tg = e.target.closest('[data-toggle]');
        if (tg) { var tk = tg.getAttribute('data-kind'), tf = tg.getAttribute('data-toggle'); if (BR[tk].f[tf]) delete BR[tk].f[tf]; else BR[tk].f[tf] = true; loadBrowse(tk, true); return; }
        var cl = e.target.closest('[data-clear]');
        if (cl) { var ck = cl.getAttribute('data-kind'); if (ck === 'search') { searchType = 'all'; searchYear = ''; renderSearchBar(); doSearch(); } else { BR[ck].f = {}; loadBrowse(ck, true); } return; }
        var sm = e.target.closest('[data-showmore]');
        if (sm) { loadBrowse(sm.getAttribute('data-showmore'), false); return; }
        var mb = e.target.closest('[data-more]');
        if (mb) { openMore(mb.getAttribute('data-more')); return; }
        if (e.target.closest('[data-mback]')) { closeMore(); return; }
        var p = e.target.closest('[data-k]');
        if (!p) return;
        var c = byKey[p.getAttribute('data-k')];
        if (c) openItem(c);
      });

      // "More": the full list behind a row, inside the app. It gets its own history entry (#more=<row>), so
      // Telegram's Back button, and the one in the page, simply close it.
      var lastView = 'home', moreCache = {};
      function navNote() { try { window.dispatchEvent(new Event('tm-nav')); } catch (e) {} }
      function showMore(key) {
        var cur = document.querySelector('.view.on');
        if (cur && cur.id !== 'v-more') lastView = cur.id.replace('v-', '');
        document.querySelectorAll('.view').forEach(function (v) { v.classList.toggle('on', v.id === 'v-more'); });
        $('more-title').textContent = '';
        setHtml($('more-body'), '<div class="skel"></div>');
        window.scrollTo(0, 0);
        function fill(j) {
          if (!$('v-more').classList.contains('on')) return;
          $('more-title').textContent = j.title;
          var html;
          if (key === 'reviews') html = '<div class="rlist">' + j.items.map(reviewCard).join('') + '</div>';
          else html = '<div class="grid">' + j.items.map(register).map(function (c) { return poster(c, '', key === 'digital'); }).join('') + '</div>';
          setHtml($('more-body'), html + '<a class="full" href="' + esc(j.seeAll) + '">See everything on the website</a>');
        }
        if (moreCache[key]) { fill(moreCache[key]); return; }
        fetch('/api/app/more?row=' + encodeURIComponent(key)).then(function (r) { if (!r.ok) throw new Error('bad'); return r.json(); }).then(function (j) {
          moreCache[key] = j; fill(j);
        }).catch(function () {
          setHtml($('more-body'), '<p class="empty"><b>Could not load</b>Check your connection and try again.</p>');
        });
      }
      function openMore(key) {
        try { history.pushState({more: key}, '', '#more=' + key); } catch (e) { location.hash = 'more=' + key; }
        navNote();
        showMore(key);
      }
      function route() {
        var m = (location.hash || '').match(/^#more=([a-z]+)$/);
        if (m) showMore(m[1]);
        else if ($('v-more').classList.contains('on')) show(lastView || 'home');
        navNote();
      }
      window.addEventListener('popstate', route);
      function closeMore() {
        if (history.state && history.state.more) { history.back(); return; }
        try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
        show(lastView || 'home');
        navNote();
      }

      // start
      loadSaved();
      saved = saved.filter(function (s) { return s && s.k && s.item; });
      saved.forEach(function (s) { s.item = register(s.item); });
      fetch('/api/app/home').then(function (r) { if (!r.ok) throw new Error('bad'); return r.json(); }).then(function (j) {
        D = j; render(); route();
      }).catch(function () {
        setHtml($('home-body'), '<p class="empty"><b>Could not load</b>Check your connection and try again.</p>' +
          '<a class="full" href="" onclick="location.reload();return false">Try again</a><a class="full" href="/">Open the full website</a>');
      });
    })();
  </script>
</body>
</html>
