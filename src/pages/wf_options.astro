---
import BaseLayout from '../layouts/BaseLayout.astro';

const TG = {
  channel: 'https://t.me/+oAFGVNSusvoyMzI0',
  group: 'https://t.me/+vtOF1f_KsjY4Yjk0',
  infohub: 'https://t.me/+kIZn-UymRDE4OTFk',
};

// Same four destinations in every variant, so only the design differs.
const D = [
  { k: 'group', c: 'amber', n: 'Request Group', full: 'Movie/Series Request Group',
    s: 'Where you search. Your file arrives here.',
    t: 'On Telegram. Send /m or /s here and your file arrives here. Free.',
    go: 'Join', href: TG.group, first: true },
  { k: 'channel', c: 'pink', n: 'Channel', full: 'Channel',
    s: 'News, daily picks and trailers.',
    t: 'Movie and series news, daily picks and trailers. React and comment.',
    go: 'Follow', href: TG.channel, first: false },
  { k: 'info', c: 'cyan', n: 'Info Hub', full: 'Info Hub',
    s: 'Updates, and the new link if we get blocked.',
    t: 'Announcements only. Where the new link goes if Telegram blocks a group.',
    go: 'Join', href: TG.infohub, first: false },
  { k: 'site', c: 'rose', n: 'trendimovies.com', full: 'trendimovies.com',
    s: 'Stream in your browser, or download.',
    t: 'Browse with posters, cast and plot. Stream or download.',
    go: 'Open', href: '/', first: false },
];
---

<BaseLayout title="Where to find us — 6 options" description="Design options" image="/images/og-default.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <div style="position:fixed;top:0;left:0;right:0;z-index:70;background:#b0161d;color:#fff;font:600 12px/1.9 system-ui,sans-serif;text-align:center;letter-spacing:.05em">PREVIEW — pick one</div>

  <div class="opt-page">
    <div class="opt-wrap">
      <h1 class="opt-h1">Where to find us — six options</h1>
      <p class="opt-sub">Same content in each. Pick a letter and I will put it on the real page.</p>

      {/* ---------- A : compact rows ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>A</b> Compact rows — one line each, densest of the lot</div>
        <h3 class="wf-h">Where to find us</h3>
        <div class="a-list">
          {D.map((d) => (
            <a class={`a-row c-${d.c}`} href={d.href} target="_blank" rel="noopener">
              <span class="a-dot"></span>
              <b>{d.n}</b>
              <span class="a-s">{d.s}</span>
              <i>→</i>
            </a>
          ))}
        </div>
      </div>

      {/* ---------- B : pill chips ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>B</b> Pills — smallest footprint, names only</div>
        <h3 class="wf-h">Where to find us</h3>
        <p class="b-lead">Three rooms on Telegram, plus the website.</p>
        <div class="b-pills">
          {D.map((d) => (
            <a class={`b-pill c-${d.c}`} href={d.href} target="_blank" rel="noopener">
              {d.n}{d.first && <em>start here</em>}
            </a>
          ))}
        </div>
      </div>

      {/* ---------- C : small cards, 4 across ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>C</b> Small cards, four across — compact version of what you saw</div>
        <h3 class="wf-h">Where to find us</h3>
        <div class="c-grid">
          {D.map((d) => (
            <a class={`c-card c-${d.c}`} href={d.href} target="_blank" rel="noopener">
              <b>{d.n}</b>
              <span>{d.s}</span>
            </a>
          ))}
        </div>
      </div>

      {/* ---------- D : table ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>D</b> Table — matches the command tables elsewhere on the page</div>
        <h3 class="wf-h">Where to find us</h3>
        <div class="d-wrap">
          <table class="d-table">
            <thead><tr><th>Where</th><th>What it is for</th><th></th></tr></thead>
            <tbody>
              {D.map((d) => (
                <tr class={`c-${d.c}`}>
                  <td><b>{d.n}</b></td>
                  <td>{d.t}</td>
                  <td><a href={d.href} target="_blank" rel="noopener">{d.go} →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* ---------- E : single strip ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>E</b> One strip — a single bar, four segments</div>
        <h3 class="wf-h">Where to find us</h3>
        <div class="e-strip">
          {D.map((d) => (
            <a class={`e-seg c-${d.c}`} href={d.href} target="_blank" rel="noopener">
              <b>{d.n}</b>
              <span>{d.s}</span>
            </a>
          ))}
        </div>
      </div>

      {/* ---------- F : numbered list ---------- */}
      <div class="opt">
        <div class="opt-tag"><b>F</b> Plain list — no boxes at all, just type</div>
        <h3 class="wf-h">Where to find us</h3>
        <ul class="f-list">
          {D.map((d) => (
            <li class={`c-${d.c}`}>
              <a href={d.href} target="_blank" rel="noopener"><b>{d.full}</b></a>
              <span> — {d.t}</span>
            </li>
          ))}
        </ul>
      </div>

      <p class="opt-end">Reply with a letter.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .opt-page{--ink:#f2eef7;--dim:#a9a2b8;--faint:#6f6880;
    --panel:rgba(22,18,30,.72);--line:rgba(255,255,255,.1);
    --amber:#ff9f1c;--pink:#ff5fa8;--cyan:#4cc9f0;--rose:#ff4d6d;
    color:var(--ink);font-family:'Outfit',system-ui,sans-serif;padding-block:34px 70px}
  .opt-wrap{max-width:900px;margin:0 auto;padding-inline:18px}
  .opt-h1{font-size:clamp(1.6rem,5vw,2.3rem);font-weight:900;margin:0 0 6px;letter-spacing:-.02em}
  .opt-sub{color:var(--dim);margin:0 0 34px}
  .opt{margin-bottom:40px;padding-bottom:34px;border-bottom:1px dashed rgba(255,255,255,.12)}
  .opt-tag{font-size:.82rem;color:var(--faint);margin-bottom:14px;letter-spacing:.02em}
  .opt-tag b{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:7px;
    background:#fff;color:#0a0810;font-weight:900;margin-right:9px;font-size:.78rem}
  .wf-h{font-size:1.15rem;font-weight:900;margin:0 0 12px}
  .opt-end{color:var(--faint);text-align:center;margin-top:10px}
  .c-amber{--c:var(--amber)}.c-pink{--c:var(--pink)}.c-cyan{--c:var(--cyan)}.c-rose{--c:var(--rose)}

  /* A */
  .a-list{display:flex;flex-direction:column;gap:1px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .a-row{display:flex;align-items:center;gap:11px;padding:11px 14px;background:var(--panel);
    text-decoration:none;color:var(--ink);transition:background .2s}
  .a-row:hover{background:color-mix(in srgb,var(--c) 12%,var(--panel))}
  .a-dot{width:8px;height:8px;border-radius:50%;background:var(--c);flex:0 0 auto;
    box-shadow:0 0 10px var(--c)}
  .a-row b{font-size:.93rem;font-weight:700;white-space:nowrap}
  .a-s{color:var(--dim);font-size:.86rem;flex:1;min-width:0}
  .a-row i{font-style:normal;color:var(--c);font-weight:700;transition:transform .2s}
  .a-row:hover i{transform:translateX(4px)}

  /* B */
  .b-lead{color:var(--dim);font-size:.9rem;margin:0 0 10px}
  .b-pills{display:flex;flex-wrap:wrap;gap:8px}
  .b-pill{display:inline-flex;align-items:center;gap:7px;min-height:40px;padding:0 15px;
    border-radius:999px;text-decoration:none;font-weight:700;font-size:.88rem;
    color:var(--c);border:1px solid color-mix(in srgb,var(--c) 42%,transparent);
    background:color-mix(in srgb,var(--c) 11%,transparent);transition:background .2s,transform .2s}
  .b-pill:hover{transform:translateY(-2px);background:color-mix(in srgb,var(--c) 20%,transparent)}
  .b-pill em{font-style:normal;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;
    background:var(--c);color:#0a0810;padding:3px 7px;border-radius:999px;font-weight:900}

  /* C */
  .c-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
  .c-card{display:flex;flex-direction:column;gap:4px;padding:12px 13px;border-radius:12px;
    text-decoration:none;background:var(--panel);border:1px solid var(--line);
    border-top:2px solid var(--c);transition:transform .2s,border-color .2s}
  .c-card:hover{transform:translateY(-3px);border-color:var(--c)}
  .c-card b{color:var(--ink);font-size:.86rem;font-weight:800}
  .c-card span{color:var(--dim);font-size:.78rem;line-height:1.5}

  /* D */
  .d-wrap{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel)}
  .d-table{width:100%;border-collapse:collapse;font-size:.88rem}
  .d-table th{text-align:left;padding:9px 13px;font-size:.66rem;letter-spacing:.13em;
    text-transform:uppercase;color:var(--faint);border-bottom:1px solid var(--line)}
  .d-table td{padding:10px 13px;border-top:1px solid var(--line);color:var(--dim);vertical-align:middle}
  .d-table tr b{color:var(--c);white-space:nowrap}
  .d-table a{color:var(--c);text-decoration:none;font-weight:700;white-space:nowrap}

  /* E */
  .e-strip{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);
    border-radius:12px;overflow:hidden}
  .e-seg{padding:12px 14px;text-decoration:none;background:var(--panel);
    border-left:3px solid var(--c);display:flex;flex-direction:column;gap:3px;transition:background .2s}
  .e-seg:first-child{border-left-width:3px}
  .e-seg:hover{background:color-mix(in srgb,var(--c) 14%,var(--panel))}
  .e-seg b{color:var(--ink);font-size:.86rem;font-weight:800}
  .e-seg span{color:var(--dim);font-size:.77rem;line-height:1.45}

  /* F */
  .f-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
  .f-list li{color:var(--dim);font-size:.92rem;line-height:1.6;padding-left:14px;
    border-left:2px solid var(--c)}
  .f-list a{color:var(--c);text-decoration:none}
  .f-list a:hover{text-decoration:underline}

  @media (max-width:700px){
    .c-grid,.e-strip{grid-template-columns:repeat(2,1fr)}
    .a-row{flex-wrap:wrap;gap:6px 10px}
    .a-s{flex-basis:100%;padding-left:19px}
  }
  @media (max-width:430px){
    .c-grid,.e-strip{grid-template-columns:1fr}
  }
</style>
