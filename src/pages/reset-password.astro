---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="Choose a new password | TrendiMovies" description="Choose a new password for your TrendiMovies account" noIndex={true}>
  <main class="min-h-screen flex items-center justify-center px-4 py-12" style="background: var(--bg-primary);">
    <div class="w-full max-w-md">
      <div class="rounded-2xl p-8" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <h1 class="text-2xl font-bold mb-2" style="color: var(--text-primary);">Choose a new password</h1>

        <p id="checking" class="text-sm" style="color: var(--text-secondary);">Checking your link...</p>

        <div id="bad" class="hidden">
          <p class="mb-5" style="color: var(--text-secondary);">This link has expired or was already used. Links work once and only for 1 hour.</p>
          <a href="/login?forgot=1" class="block w-full py-3 rounded-lg font-semibold text-white text-center" style="background: linear-gradient(135deg, #dc2626, #991b1b);">Get a new link</a>
        </div>

        <form id="resetForm" class="space-y-5 hidden">
          <p class="text-sm" style="color: var(--text-secondary);">Pick a password you will remember. At least 6 characters.</p>
          <div>
            <label class="block text-sm font-medium mb-2" style="color: var(--text-secondary);" for="pw1">New password</label>
            <input id="pw1" type="password" name="password" required minlength="6" autocomplete="new-password"
              class="w-full px-4 py-3 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-red-500"
              style="background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-color);"
              placeholder="New password" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2" style="color: var(--text-secondary);" for="pw2">Type it again</label>
            <input id="pw2" type="password" name="confirm" required minlength="6" autocomplete="new-password"
              class="w-full px-4 py-3 rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-red-500"
              style="background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-color);"
              placeholder="New password again" />
          </div>
          <div id="resetError" class="hidden text-red-500 text-sm" role="alert"></div>
          <button type="submit" class="w-full py-3 rounded-lg font-semibold text-white transition-all hover:opacity-90 disabled:opacity-50"
            style="background: linear-gradient(135deg, #dc2626, #991b1b);">Save new password</button>
        </form>

        <div id="done" class="hidden">
          <p class="mb-5" style="color: var(--text-primary);">Done. Your password is changed. You were signed out on every device, so please sign in again.</p>
          <a href="/login" class="block w-full py-3 rounded-lg font-semibold text-white text-center" style="background: linear-gradient(135deg, #dc2626, #991b1b);">Go to login</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // The secret sits after the # in the link, so it is never sent to any server or written to a log.
  const token = new URLSearchParams(location.hash.replace(/^#/, '')).get('token') || '';
  const checking = document.getElementById('checking');
  const bad = document.getElementById('bad');
  const form = document.getElementById('resetForm') as HTMLFormElement | null;
  const done = document.getElementById('done');
  const err = document.getElementById('resetError');

  // Take the secret out of the address bar and the history.
  try { history.replaceState(null, '', location.pathname); } catch (e) {}

  async function check() {
    try {
      const res = await fetch('/api/auth/reset-password?token=' + encodeURIComponent(token));
      const d = await res.json();
      checking?.classList.add('hidden');
      (d.valid ? form : bad)?.classList.remove('hidden');
    } catch (e) {
      checking?.classList.add('hidden');
      bad?.classList.remove('hidden');
    }
  }
  check();

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    err?.classList.add('hidden');
    const fd = new FormData(form);
    const pw = String(fd.get('password') || '');
    if (pw !== String(fd.get('confirm') || '')) {
      if (err) { err.textContent = 'The two passwords do not match.'; err.classList.remove('hidden'); }
      return;
    }
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password: pw }),
      });
      const d = await res.json();
      if (d.success) {
        form.classList.add('hidden');
        done?.classList.remove('hidden');
      } else if (err) {
        err.textContent = d.error || 'Something went wrong. Please try again.';
        err.classList.remove('hidden');
        btn.disabled = false;
      }
    } catch (x) {
      if (err) { err.textContent = 'No connection. Please try again.'; err.classList.remove('hidden'); }
      btn.disabled = false;
    }
  });
</script>
