---
import { filesEnabled } from '../../lib/site-mode';
const FILES_ON = filesEnabled();
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../../components/MovieCard.svelte';

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';
const { slug } = Astro.params;

// Topic + its items
async function getTopic() {
  try {
    const tRes = await fetch(`${POSTGREST_URL}/movie_topics?slug=eq.${slug}&is_published=eq.true&select=*`);
    if (!tRes.ok) return null;
    const topics = await tRes.json();
    if (!topics.length) return null;
    const topic = topics[0];
    const iRes = await fetch(`${POSTGREST_URL}/movie_topic_items?topic_id=eq.${topic.id}&order=position.asc&select=tmdb_id,title,year,blurb,poster_path`);
    topic.items = iRes.ok ? await iRes.json() : [];
    return topic;
  } catch (e) { return null; }
}

const topic = await getTopic();
if (!topic) return Astro.redirect('/guides');

// Resolve each item against our library: owned films get slug + has_downloads +
// our poster/backdrop (image overrides); un-owned still show (marked) via TMDB.
const tmdbIds = topic.items.map((i: any) => i.tmdb_id).filter(Boolean);
let owned: Record<number, any> = {};
if (tmdbIds.length) {
  try {
    const r = await fetch(`${POSTGREST_URL}/movies?tmdb_id=in.(${tmdbIds.join(',')})&select=tmdb_id,slug,poster_path,backdrop_path,vote_average,year,has_downloads`);
    if (r.ok) owned = Object.fromEntries((await r.json()).map((m: any) => [m.tmdb_id, m]));
  } catch (e) {}
}

function posterFor(tmdbId: number, fallbackTitle: string) {
  const o = owned[tmdbId];
  // owned movie with a local /images poster → use it; else TMDB poster handled by card
  return o?.poster_path && o.poster_path.startsWith('/images/') ? o.poster_path : null;
}

const items = topic.items.map((i: any) => {
  const o = owned[i.tmdb_id] || {};
  return {
    id: i.tmdb_id,
    tmdb_id: i.tmdb_id,
    title: i.title,
    slug: o.slug || undefined,
    poster_path: posterFor(i.tmdb_id, i.title),
    year: i.year || o.year || null,
    vote_average: o.vote_average || 0,
    type: 'movie' as const,
    has_downloads: !!o.has_downloads,
    blurb: i.blurb || '',
    overview: i.blurb || '',
    saved_poster: i.poster_path || null,
  };
});
// Need TMDB posters for items where we have no local override — fetch w342 path from owned, else build from TMDB tmdb path stored? We only have tmdb_id, so let the card use TMDB via tmdb poster path. Pull poster_path from TMDB for un-owned:
// (owned rows already carried poster_path; for un-owned we fetch TMDB image base path on the fly)
const ownedCount = FILES_ON ? items.filter((i: any) => i.has_downloads).length : 0;

// Branded OG banner (reuses /api/og.png list template)
const _ogTitles = items.slice(0, 4).map((i: any) => i.title).join('|');
const _ogBackdrop = (Object.values(owned).find((m: any) => m.backdrop_path && !m.backdrop_path.startsWith('/images/')) as any)?.backdrop_path || '';
const _ogPosters = items.map((i: any) => i.saved_poster).filter((x: any) => x && !String(x).startsWith('/images/')).slice(0, 3).join('|');
const ogImage = `/api/og.png?type=guide&label=${encodeURIComponent(topic.title)}&emoji=${encodeURIComponent(topic.emoji || '🎬')}&color=${encodeURIComponent(topic.color || '#e50914')}&count=${items.length}&posters=${encodeURIComponent(_ogPosters)}`;

const firstAvail = FILES_ON ? items.findIndex((i: any) => i.has_downloads) : -1;
const startItem = firstAvail >= 0 ? items[firstAvail] : null;
const pageUrl = `https://trendimovies.com/guides/${topic.slug}`;
const shareText = `${topic.title} - the full list on TrendiMovies`;
const waLink = `https://wa.me/?text=${encodeURIComponent(shareText + '\n' + pageUrl)}`;
const missingCount = items.length - ownedCount;
function listPoster(it: any) {
  const p = it.poster_path || it.saved_poster;
  if (!p) return '/images/no-poster.svg';
  return p.startsWith('/images/') ? p : `https://image.tmdb.org/t/p/w185${p}`;
}

function tmdbPoster(p: string | null) {
  if (!p) return null;
  if (p.startsWith('/images/')) return p;
  return `https://image.tmdb.org/t/p/w342${p}`;
}
// Attach TMDB poster_path for un-owned items (owned ones carried local poster)
for (const it of items) {
  if (!it.poster_path) it.poster_path = owned[it.tmdb_id]?.poster_path || null;
}
---

<BaseLayout title={`${topic.title} | TrendiMovies`} description={topic.intro || `${topic.title} — curated on TrendiMovies.`} image={ogImage}>
  <!-- Header -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0" style={`background: linear-gradient(135deg, #0a0a0f 0%, ${topic.color}22 50%, #0a0a0f 100%);`}></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-6">
      <a href="/guides" class="inline-flex items-center gap-1.5 text-sm font-medium mb-4" style="color: var(--text-muted);">← All Movie Guides</a>
      <div class="flex items-start gap-4">
        <span class="text-5xl sm:text-6xl flex-shrink-0">{topic.emoji}</span>
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black leading-tight" style="color: var(--text-primary);">{topic.title}</h1>
          {topic.intro && <p class="mt-3 text-base sm:text-lg max-w-3xl leading-relaxed" style="color: var(--text-secondary);">{topic.intro}</p>}
          <p class="mt-3 text-xs" style="color: var(--text-muted);">{items.length} films{FILES_ON ? ` · ${ownedCount} available to watch now on TrendiMovies` : ''}</p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {startItem && (
              <a href={`/movie/${startItem.tmdb_id}`} class="px-4 py-2.5 rounded-xl text-sm font-bold text-black inline-flex items-center gap-2" style={`background: linear-gradient(135deg, ${topic.color}, ${topic.color}bb);`}>▶ Start watching{firstAvail > 0 ? ` (from #${firstAvail + 1})` : ''}</a>
            )}
            <a href={waLink} target="_blank" rel="noopener" class="px-4 py-2.5 rounded-xl text-sm font-bold inline-flex items-center gap-2" style="background:#25D366;color:#06210f;">Share on WhatsApp</a>
            <button type="button" id="guide-copy" class="px-4 py-2.5 rounded-xl text-sm font-semibold" style="background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);" data-url={pageUrl}>Copy link</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Controls + films -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="guide-body" data-view="grid" data-filter="all">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Show">
        <button type="button" class="gd-chip" data-filter-btn="all" aria-pressed="true">All ({items.length})</button>
        {ownedCount > 0 && <button type="button" class="gd-chip" data-filter-btn="have" aria-pressed="false">On TrendiMovies ({ownedCount})</button>}
        {missingCount > 0 && ownedCount > 0 && <button type="button" class="gd-chip" data-filter-btn="miss" aria-pressed="false">Request ({missingCount})</button>}
      </div>
      <div class="flex items-center gap-2" role="group" aria-label="View">
        <button type="button" class="gd-chip" data-view-btn="grid" aria-pressed="true">Grid</button>
        <button type="button" class="gd-chip" data-view-btn="list" aria-pressed="false">List</button>
      </div>
    </div>
    <div class="gd-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-5">
      {items.map((item: any, idx: number) => (
        <div class="relative" data-avail={item.has_downloads ? '1' : '0'}>
          <span class="absolute -top-2 -left-2 z-20 w-7 h-7 rounded-full flex items-center justify-center text-xs font-black shadow-lg" style={`background: ${topic.color}; color: #fff;`}>{idx + 1}</span>
          <MovieCard client:visible item={item} />
          {FILES_ON && !item.has_downloads && (
            <span class="absolute top-2 right-2 z-20 px-2 py-0.5 rounded text-[10px] font-bold" style="background: rgba(0,0,0,0.75); color: #fbbf24; border: 1px solid rgba(251,191,36,0.4);">Request</span>
          )}
          {item.blurb && <p class="mt-2 text-xs leading-snug" style="color: var(--text-muted);">{item.blurb}</p>}
        </div>
      ))}
    </div>
    <div class="gd-list flex flex-col gap-3">
      {items.map((item: any, idx: number) => (
        <a href={`/movie/${item.tmdb_id}`} data-avail={item.has_downloads ? '1' : '0'} class="flex gap-3 rounded-xl p-3" style="background-color: var(--bg-card); border: 1px solid var(--border);">
          <div class="relative flex-shrink-0">
            <img src={listPoster(item)} alt={item.title} width="64" height="96" loading="lazy" class="rounded-lg object-cover" style="width:64px;height:96px;" />
            <span class="absolute -top-2 -left-2 w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-black" style={`background: ${topic.color}; color: #fff;`}>{idx + 1}</span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-bold text-sm sm:text-base" style="color: var(--text-primary);">{item.title}</h3>
              {item.year && <span class="text-xs" style="color: var(--text-muted);">{item.year}</span>}
              {FILES_ON && (item.has_downloads
                ? <span class="px-2 py-0.5 rounded text-[10px] font-bold" style="background: rgba(34,197,94,0.15); color: #22c55e;">On TrendiMovies</span>
                : <span class="px-2 py-0.5 rounded text-[10px] font-bold" style="background: rgba(251,191,36,0.12); color: #fbbf24;">Request</span>)}
            </div>
            {item.blurb && <p class="mt-1 text-sm leading-snug" style="color: var(--text-secondary);">{item.blurb}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl p-8 text-center relative overflow-hidden" style="background-color: var(--bg-card); border: 1px solid var(--border);">
      <div class="absolute inset-0 opacity-25 pointer-events-none" style={`background: radial-gradient(ellipse at 30% 50%, ${topic.color}, transparent 60%);`}></div>
      <div class="relative">
        <h2 class="text-xl sm:text-2xl font-black text-white mb-2">More Movie Guides</h2>
        <p class="text-sm mb-5" style="color: var(--text-secondary);">Fresh lists every day: movies to cry to, laugh at, binge and never forget.</p>
        <a href="/guides" class="px-6 py-3 rounded-xl font-bold text-black inline-block" style={`background: linear-gradient(135deg, ${topic.color}, ${topic.color}aa);`}>Browse All Guides →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .gd-chip { padding: 0.45rem 0.9rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border); cursor: pointer; }
  .gd-chip[aria-pressed="true"] { background: #e50914; color: #fff; border-color: #e50914; }
  #guide-body[data-view="grid"] .gd-list { display: none; }
  #guide-body[data-view="list"] .gd-grid { display: none; }
  #guide-body[data-filter="have"] [data-avail="0"] { display: none; }
  #guide-body[data-filter="miss"] [data-avail="1"] { display: none; }
</style>

<script>
  const KEY = 'tm-listing-view';
  const body = document.getElementById('guide-body');
  function sync() {
    if (!body) return;
    document.querySelectorAll<HTMLElement>('[data-filter-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterBtn === body.dataset.filter)));
    document.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === body.dataset.view)));
  }
  if (body) {
    try { if (localStorage.getItem(KEY) === 'list') body.dataset.view = 'list'; } catch (e) {}
    sync();
    document.querySelectorAll<HTMLElement>('[data-filter-btn]').forEach((b) => b.addEventListener('click', () => { body.dataset.filter = b.dataset.filterBtn || 'all'; sync(); }));
    document.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.viewBtn === 'list' ? 'list' : 'grid';
      body.dataset.view = m; sync();
      try { localStorage.setItem(KEY, m); window.dispatchEvent(new CustomEvent('tm-listing-view', { detail: m })); } catch (e) {}
    }));
  }
  const copyBtn = document.getElementById('guide-copy');
  if (copyBtn) copyBtn.addEventListener('click', async () => {
    const url = copyBtn.dataset.url || location.href;
    try { await navigator.clipboard.writeText(url); copyBtn.textContent = 'Copied!'; } catch (e) { window.prompt('Copy this link:', url); }
    setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2000);
  });
</script>
