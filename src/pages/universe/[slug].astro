---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchFromTMDB } from '../../lib/tmdb';

// ============================================================================
// UNIVERSE PAGES — curated "watch the whole saga in order" showcases.
// Expandable: add a new universe to the UNIVERSES map and a /universe/<slug>
// page exists automatically. Each entry is a movie or series; posters come from
// TMDB; availability is checked against our catalogue (movie has_downloads /
// episodes with files). Missing titles show a REQUEST badge.
// ============================================================================

