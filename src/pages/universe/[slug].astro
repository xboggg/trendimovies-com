const { slug } = Astro.params;
const universe = slug ? UNIVERSES[slug] : undefined;
if (!universe) return Astro.redirect('/franchises');

// Gather all tmdb_ids by type for batched availability checks.
const movieIds = universe.groups.flatMap(g => g.items.filter(i => i.type === 'movie').map(i => i.tmdb_id));
const seriesIds = universe.groups.flatMap(g => g.items.filter(i => i.type === 'series').map(i => i.tmdb_id));

// Which movies have files? (has_downloads + slug→tmdb_id for the /movie/{tmdb_id} link)
const availMovies = new Set<number>();
const posterByTmdb = new Map<number, string | null>();
try {
  if (movieIds.length) {
    const res = await fetch(`${POSTGREST_URL}/movies?tmdb_id=in.(${movieIds.join(',')})&select=tmdb_id,has_downloads,poster_path`);
    if (res.ok) for (const r of await res.json()) {
      if (r.has_downloads) availMovies.add(r.tmdb_id);
      if (r.poster_path) posterByTmdb.set(r.tmdb_id, r.poster_path);
    }
  }
  // Which series have at least one episode with a file?
  if (seriesIds.length) {
    const res = await fetch(`${POSTGREST_URL}/series?tmdb_id=in.(${seriesIds.join(',')})&select=tmdb_id,poster_path`);
    if (res.ok) for (const r of await res.json()) { if (r.poster_path) posterByTmdb.set(r.tmdb_id, r.poster_path); }
  }
} catch (e) {}

// Series availability: any episode with has_downloads. Query episodes grouped.
const availSeries = new Set<number>();
try {
  if (seriesIds.length) {
    // PostgREST: episodes joined to series via series_id; we need tmdb_id → has any file.
    // Simpler: ask for episodes with has_downloads for these series' internal ids.
    const sres = await fetch(`${POSTGREST_URL}/series?tmdb_id=in.(${seriesIds.join(',')})&select=id,tmdb_id`);
    if (sres.ok) {
      const rows = await sres.json();
      const idToTmdb = new Map<number, number>(rows.map((r: any) => [r.id, r.tmdb_id]));
      const internalIds = rows.map((r: any) => r.id);
      if (internalIds.length) {
        const eres = await fetch(`${POSTGREST_URL}/episodes?series_id=in.(${internalIds.join(',')})&has_downloads=eq.true&select=series_id`);
        if (eres.ok) for (const e of await eres.json()) {
          const t = idToTmdb.get(e.series_id); if (t) availSeries.add(t);
        }
      }
    }
  }
} catch (e) {}

// Poster fetch from TMDB for any item we don't already have a poster for (cached by tmdb.ts).
async function tmdbPoster(item: Item): Promise<string | null> {
  const have = posterByTmdb.get(item.tmdb_id);
  if (have) return `https://image.tmdb.org/t/p/w342${have}`;
  try {
    const d: any = await fetchFromTMDB(`/${item.type === 'movie' ? 'movie' : 'tv'}/${item.tmdb_id}`, {});
    return d.poster_path ? `https://image.tmdb.org/t/p/w342${d.poster_path}` : null;
  } catch { return null; }
}

// Shape groups with poster + availability + watch url.
const groups = await Promise.all(universe.groups.map(async (g) => ({
  heading: g.heading,
  items: await Promise.all(g.items.map(async (it) => {
    const available = it.type === 'movie' ? availMovies.has(it.tmdb_id) : availSeries.has(it.tmdb_id);
    const watch_url = it.type === 'movie' ? `/movie/${it.tmdb_id}` : `/tv/${it.tmdb_id}`;
    const request_url = `/request?title=${encodeURIComponent(it.title)}&year=${it.year.slice(0, 4)}`;
    return { ...it, poster: await tmdbPoster(it), available, watch_url, request_url };
  })),
})));

const totalItems = groups.reduce((a, g) => a + g.items.length, 0);
const availCount = groups.reduce((a, g) => a + g.items.filter(i => i.available).length, 0);

// Backdrop for hero + OG.
let heroBackdrop = '';
try {
  const d: any = await fetchFromTMDB(`/${universe.backdropType}/${universe.backdropId}`, {});
  if (d.backdrop_path) heroBackdrop = `https://image.tmdb.org/t/p/w1280${d.backdrop_path}`;
} catch {}

// OG collage = first 5 available posters (or just first 5).
const ogPosters = groups.flatMap(g => g.items).filter(i => i.poster).slice(0, 5)
  .map(i => (i.poster as string).replace('https://image.tmdb.org/t/p/w342', '')).join('|');
const pageTitle = `${universe.name} — Watch the Full Saga in Order | TrendiMovies`;
const pageDesc = `${universe.tagline} Stream every film and series of the ${universe.name} universe in HD on TrendiMovies.`;
const ogImage = ogPosters
  ? `/api/og.png?type=digital&posters=${encodeURIComponent(ogPosters)}&accent=${encodeURIComponent(universe.accent)}&eyebrow=${encodeURIComponent('WATCH IN ORDER')}&eyebrowEmoji=${encodeURIComponent(universe.emoji)}&headline=${encodeURIComponent(universe.name)}&subtitle=${encodeURIComponent('Every film & series of the saga — in order')}&ogurl=${encodeURIComponent('trendimovies.com/universe/' + slug)}`
  : '/images/og-default.jpg';
const isLight = universe.accent === '#FFE81F';
---

<BaseLayout title={pageTitle} description={pageDesc} image={ogImage}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b" style="border-color: var(--border);">
    {heroBackdrop && (
      <img src={heroBackdrop} alt={universe.name} class="absolute inset-0 w-full h-full object-cover" style="opacity:0.25;" loading="eager" />
    )}
    <div class="absolute inset-0" style={`background: linear-gradient(0deg, var(--bg-primary) 12%, rgba(10,10,15,0.6) 60%, ${universe.accent}1a 100%);`}></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-4 text-xs font-bold uppercase tracking-widest"
           style={`background:${universe.accent}22; color:${universe.accent}; border:1px solid ${universe.accent}66;`}>
        {universe.emoji} Watch in Order
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight">{universe.name}</h1>
      <p class="mt-3 max-w-2xl text-sm sm:text-base" style="color: var(--text-secondary);">{universe.tagline}</p>
      <div class="mt-4 inline-flex items-center gap-2 text-sm" style="color: var(--text-secondary);">
        <span class="font-bold" style={`color:${universe.accent};`}>{availCount}</span> of {totalItems} available now
      </div>
    </div>
  </section>

  <!-- Era groups -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="space-y-12">
      {groups.map((g) => (
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="w-1.5 h-7 rounded-full" style={`background:${universe.accent};`}></span>
            <h2 class="text-xl sm:text-2xl font-black text-white">{g.heading}</h2>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {g.items.map((it) => (
              <a href={it.available ? it.watch_url : it.request_url} class="group block">
                <div class="relative aspect-[2/3] rounded-xl overflow-hidden ring-1 ring-white/10 group-hover:ring-amber-400/50 transition-all bg-black/40">
                  <img src={it.poster || '/images/no-poster.svg'} alt={it.title} loading="lazy"
                       onerror="this.src='/images/no-poster.svg'"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  <!-- badge -->
                  <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-[10px] font-bold"
                       style={it.available
                         ? 'background:rgba(22,163,74,0.92); color:#fff;'
                         : `background:rgba(0,0,0,0.72); color:${universe.accent}; border:1px solid ${universe.accent}66;`}>
                    {it.available ? '▶ WATCH' : 'REQUEST'}
                  </div>
                  <!-- type chip -->
                  <div class="absolute top-2 right-2 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase"
                       style="background:rgba(0,0,0,0.6); color:#d1d5db;">
                    {it.type === 'series' ? 'Series' : 'Film'}
                  </div>
                </div>
                <p class="mt-2 text-sm font-medium line-clamp-1" style="color: var(--text-primary);">{it.title}</p>
                <p class="text-xs" style="color: var(--text-muted);">{it.year}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-xs" style="color: var(--text-muted);">
      Missing a title? Tap any <span style={`color:${universe.accent};`}>REQUEST</span> to ask for it — we add new files daily.
    </p>
  </section>
</BaseLayout>
