---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingView from '../../components/ListingView.svelte';
import { discoverMovies, discoverTV, getMovieGenres, getTVGenres } from '../../lib/tmdb';

const { slug } = Astro.params;
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const sort = Astro.url.searchParams.get('sort') || 'popular';
const year = Astro.url.searchParams.get('year') || '';
const genreParam = Astro.url.searchParams.get('genre') || '';
const langParam = Astro.url.searchParams.get('lang') || '';

// Map sort options
const sortMap: Record<string, string> = {
  'latest': 'primary_release_date.desc',
  'popular': 'popularity.desc',
  'rating': 'vote_average.desc'
};
const tvSortMap: Record<string, string> = {
  'latest': 'first_air_date.desc',
  'popular': 'popularity.desc',
  'rating': 'vote_average.desc'
};

const sortBy = sortMap[sort] || 'popularity.desc';
const tvSortBy = tvSortMap[sort] || 'popularity.desc';

// Years for filter
const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1940 + 1 }, (_, i) => currentYear - i);

// Category configurations using TMDB discover API parameters
const categoryConfig: Record<string, {
  title: string;
  description: string;
  type: 'movie' | 'tv' | 'both';
  params: Record<string, string>;
}> = {
  'anime': {
    title: 'Anime',
    description: 'Browse Japanese animated movies and series',
    type: 'both',
    params: {
      with_genres: '16', // Animation
      with_original_language: 'ja'
    }
  },
  'korean-movies': {
    title: 'Korean Movies',
    description: 'Browse popular Korean movies',
    type: 'movie',
    params: {
      with_original_language: 'ko'
    }
  },
  'korean-series': {
    title: 'Korean Series',
    description: 'Browse popular Korean TV series (K-Drama)',
    type: 'tv',
    params: {
      with_original_language: 'ko'
    }
  },
  'bollywood': {
    title: 'Bollywood',
    description: 'Browse Indian Hindi movies',
    type: 'movie',
    params: {
      with_original_language: 'hi'
    }
  },
  'marvel': {
    title: 'Marvel',
    description: 'Browse Marvel Cinematic Universe movies and shows',
    type: 'both',
    params: {
      with_companies: '420' // Marvel Studios
    }
  },
  'dc': {
    title: 'DC',
    description: 'Browse DC Comics movies and shows',
    type: 'both',
    params: {
      with_companies: '429' // DC Entertainment
    }
  }
};

const config = categoryConfig[slug || ''];

if (!config) {
  return Astro.redirect('/movies');
}

// ---- Genre and language filters ----
const [movieGenres, tvGenres] = await Promise.all([
  config.type !== 'tv' ? getMovieGenres().catch(() => []) : Promise.resolve([] as { id: number; name: string }[]),
  config.type !== 'movie' ? getTVGenres().catch(() => []) : Promise.resolve([] as { id: number; name: string }[]),
]);
const genreOptions = config.type === 'tv' ? tvGenres : movieGenres;
// Only accept a genre that is really in the list
const genre = genreOptions.some((g) => String(g.id) === genreParam) ? genreParam : '';

// Movie and TV genre numbers differ a little at TMDB, so a chosen movie genre is translated for the series side.
// A genre that has no TV version (Horror, Romance, Thriller...) simply shows no series.
const TV_FROM_MOVIE: Record<string, string> = { '28': '10759', '12': '10759', '14': '10765', '878': '10765', '10752': '10768' };
const tvIds = new Set(tvGenres.map((g) => String(g.id)));
let tvGenre: string | null = '';
if (genre) {
  if (config.type === 'tv') {
    tvGenre = genre;
  } else {
    const m = TV_FROM_MOVIE[genre] || genre;
    tvGenre = tvIds.has(m) ? m : null;
  }
}
const tvSkip = tvGenre === null;

const LANGUAGES: [string, string][] = [
  ['en', 'English'], ['fr', 'French'], ['es', 'Spanish'], ['de', 'German'], ['it', 'Italian'],
  ['pt', 'Portuguese'], ['ru', 'Russian'], ['tr', 'Turkish'], ['ar', 'Arabic'],
  ['hi', 'Hindi'], ['ta', 'Tamil'], ['te', 'Telugu'], ['ml', 'Malayalam'], ['kn', 'Kannada'], ['bn', 'Bengali'],
  ['ja', 'Japanese'], ['ko', 'Korean'], ['zh', 'Chinese'], ['th', 'Thai'], ['id', 'Indonesian'],
];
// Only Anime and Bollywood get a Language box. Marvel, DC and Korean pages have none.
const INDIAN_LANGUAGES: [string, string][] = [
  ['hi', 'Hindi'], ['ta', 'Tamil'], ['te', 'Telugu'], ['ml', 'Malayalam'], ['kn', 'Kannada'],
  ['bn', 'Bengali'], ['mr', 'Marathi'], ['pa', 'Punjabi'], ['gu', 'Gujarati'],
];
const langChoices: [string, string][] | null =
  slug === 'anime' ? LANGUAGES : slug === 'bollywood' ? INDIAN_LANGUAGES : null;
const showLang = langChoices !== null;
// The first choice in the Language list is the page's own language (Anime = Japanese, Bollywood = Hindi);
// picking another language replaces it.
const defaultLang = config.params.with_original_language || '';
const defaultLangName = (langChoices || LANGUAGES).find(([c]) => c === defaultLang)?.[1] || '';
const lang = langChoices && langChoices.some(([c]) => c === langParam && c !== defaultLang) ? langParam : '';

// Build params with sorting
const movieParams: Record<string, string> = { ...config.params, sort_by: sortBy };
const tvParams: Record<string, string> = { ...config.params, sort_by: tvSortBy };

if (year) {
  movieParams.primary_release_year = year;
  tvParams.first_air_date_year = year;
}

if (lang) {
  movieParams.with_original_language = lang;
  tvParams.with_original_language = lang;
}

// "," means AND in TMDB, so Anime (Animation) + Action = animated action
function addGenre(base: string | undefined, extra: string): string {
  return [...new Set([...(base ? base.split(',') : []), extra])].join(',');
}
if (genre) movieParams.with_genres = addGenre(config.params.with_genres, genre);
if (tvGenre) tvParams.with_genres = addGenre(config.params.with_genres, tvGenre);

// Fetch content based on category type
let movies: any[] = [];
let series: any[] = [];
let totalPages = 1;

const tmdbPage1 = (page - 1) * 2 + 1;
const tmdbPage2 = tmdbPage1 + 1;

if (config.type === 'movie' || config.type === 'both') {
  const [resp1, resp2] = await Promise.all([
    discoverMovies({ ...movieParams, page: tmdbPage1.toString() }),
    discoverMovies({ ...movieParams, page: tmdbPage2.toString() })
  ]);
  movies = [...(resp1.results || []), ...(resp2.results || [])].slice(0, 30);
  totalPages = Math.max(totalPages, Math.ceil((resp1.total_pages || 1) / 2));
}

if ((config.type === 'tv' || config.type === 'both') && !tvSkip) {
  const [resp1, resp2] = await Promise.all([
    discoverTV({ ...tvParams, page: tmdbPage1.toString() }),
    discoverTV({ ...tvParams, page: tmdbPage2.toString() })
  ]);
  series = [...(resp1.results || []), ...(resp2.results || [])].slice(0, 30);
  totalPages = Math.max(totalPages, Math.ceil((resp1.total_pages || 1) / 2));
}

totalPages = Math.min(totalPages, 250);

function transformMovie(movie: any) {
  return {
    id: movie.id,
    tmdb_id: movie.id,
    title: movie.title,
    poster_path: movie.poster_path,
    overview: movie.overview,
    vote_average: movie.vote_average,
    year: movie.release_date ? new Date(movie.release_date).getFullYear() : null,
    type: 'movie' as const
  };
}

function transformSeries(show: any) {
  return {
    id: show.id,
    tmdb_id: show.id,
    title: show.name,
    poster_path: show.poster_path,
    overview: show.overview,
    vote_average: show.vote_average,
    year: show.first_air_date ? new Date(show.first_air_date).getFullYear() : null,
    type: 'series' as const
  };
}
---

<BaseLayout
  title={config.title}
  description={config.description}
  image={movies[0]?.poster_path ? `https://image.tmdb.org/t/p/w780${movies[0].poster_path}` : '/images/og-default.jpg'}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
      <div class="mb-4 md:mb-0">
        <h1 class="text-3xl font-bold" style="color: var(--text-primary);">{config.title}</h1>
        <p style="color: var(--text-secondary);">{config.description}</p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap gap-3">
        <select
          id="sort-select"
          class="px-3 py-2 rounded-lg text-sm"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          <option value="popular" selected={sort === 'popular'}>Popular</option>
          <option value="latest" selected={sort === 'latest'}>Latest</option>
          <option value="rating" selected={sort === 'rating'}>Top Rated</option>
        </select>

        <select
          id="genre-select"
          aria-label="Genre"
          class="px-3 py-2 rounded-lg text-sm"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          <option value="">All Genres</option>
          {genreOptions.map(g => (
            <option value={g.id} selected={genre === g.id.toString()}>{g.name}</option>
          ))}
        </select>

        {showLang && (
          <select
            id="lang-select"
            aria-label="Language"
            class="px-3 py-2 rounded-lg text-sm"
            style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
          >
            <option value="">{defaultLang ? `${defaultLangName} (default)` : 'All Languages'}</option>
            {(langChoices || []).filter(([c]) => c !== defaultLang).map(([c, n]) => (
              <option value={c} selected={lang === c}>{n}</option>
            ))}
          </select>
        )}

        <select
          id="year-select"
          class="px-3 py-2 rounded-lg text-sm"
          style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
        >
          <option value="">All Years</option>
          {years.map(y => (
            <option value={y} selected={year === y.toString()}>{y}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Movies Section -->
    {movies.length > 0 && (
      <section class="mb-12">
        {config.type === 'both' && (
          <h2 class="text-2xl font-semibold mb-6" style="color: var(--text-primary);">Movies</h2>
        )}
        <ListingView client:load items={movies.map((movie: any) => transformMovie(movie))} gridClass="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-4" />
      </section>
    )}

    <!-- Series Section -->
    {series.length > 0 && (
      <section class="mb-12">
        {config.type === 'both' && (
          <h2 class="text-2xl font-semibold mb-6" style="color: var(--text-primary);">Series</h2>
        )}
        <ListingView client:load showToggle={movies.length === 0} items={series.map((show: any) => transformSeries(show))} gridClass="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-4" />
      </section>
    )}

    <!-- No Results -->
    {movies.length === 0 && series.length === 0 && (
      <div class="text-center py-16">
        <p style="color: var(--text-secondary);">No content found in this category</p>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex justify-center mt-8 gap-2">
        {page > 1 && (
          <a
            href={`/category/${slug}?page=${page - 1}&sort=${sort}&genre=${genre}&lang=${lang}&year=${year}`}
            class="px-4 py-2 rounded-lg"
            style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
          >
            Previous
          </a>
        )}

        <span class="px-4 py-2" style="color: var(--text-secondary);">
          Page {page} of {totalPages}
        </span>

        {page < totalPages && (
          <a
            href={`/category/${slug}?page=${page + 1}&sort=${sort}&genre=${genre}&lang=${lang}&year=${year}`}
            class="px-4 py-2 rounded-lg"
            style="background-color: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border);"
          >
            Next
          </a>
        )}
      </div>
    )}
  </div>

  <script define:vars={{ slug }}>
    function updateUrl() {
      const sort = document.getElementById('sort-select').value;
      const year = document.getElementById('year-select').value;
      const genre = document.getElementById('genre-select').value;
      const lang = document.getElementById('lang-select')?.value || '';

      const params = new URLSearchParams();
      if (sort && sort !== 'popular') params.set('sort', sort);
      if (genre) params.set('genre', genre);
      if (lang) params.set('lang', lang);
      if (year) params.set('year', year);

      window.location.href = '/category/' + slug + (params.toString() ? '?' + params.toString() : '');
    }

    document.getElementById('sort-select')?.addEventListener('change', updateUrl);
    document.getElementById('year-select')?.addEventListener('change', updateUrl);
    document.getElementById('genre-select')?.addEventListener('change', updateUrl);
    document.getElementById('lang-select')?.addEventListener('change', updateUrl);
  </script>
</BaseLayout>
