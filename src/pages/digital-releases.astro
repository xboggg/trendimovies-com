import BaseLayout from '../layouts/BaseLayout.astro';
import { getCache, setCache } from '../lib/cache';
import { fetchFromTMDB } from '../lib/tmdb';

// ============================================================================
// Digital & HD Release Dates — date-grouped list scraped from
// dvdsreleasedates.com (all 12 months of 2026). POSTERS come from TMDB (the
// site's CSP only allows image.tmdb.org, and TMDB posters are higher quality).
// Cross-referenced with our catalogue so released titles get a Watch button.
// Everything cached so the page stays fast.
// ============================================================================

const POSTGREST_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'http://localhost:3001';
const SRC = 'https://www.dvdsreleasedates.com';
const YEAR = 2026;
const MONTHS = [
  ['1','january'],['2','february'],['3','march'],['4','april'],['5','may'],['6','june'],
  ['7','july'],['8','august'],['9','september'],['10','october'],['11','november'],['12','december'],
];
const MONTH_LABELS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

const DATE_RE = /class=["']reldate[^>]*>(?:<a[^>]*><\/a>)?([A-Za-z]+day\s+[A-Za-z]+\s+\d{1,2},\s*\d{4})/g;
// slug group is [^'"]+ (not [a-z0-9-]+) so slugs containing commas/punctuation
// like "13-days,-13-nights" still match — otherwise those movies are silently
// dropped and their date header renders empty.
const MOVIE_RE = /href=['"]\/movies\/(\d+)\/([^'"]+)['"]><img[^>]*alt=['"]([^'"]+?)\s+DVD Release Date['"][^>]*src=['"]([^'"]+)['"]/g;

// Read the raw on-disk cache file even if its TTL has EXPIRED — used as a
// stale-while-revalidate fallback so a slow/failed dvdsreleasedates scrape never
// blocks the page with a 504. (getCache() returns null once TTL passes.)
function readStaleCache(cacheKey: string): any[] | null {
  try {
    const { join } = require('node:path');
    const { readFileSync, existsSync } = require('node:fs');
    // Match lib/cache.ts exactly: CACHE_DIR = .../.cache/tmdb, key = endpoint
    // with non-alphanumerics -> '_' (no params here), file = <key>.json.
    const dir = '/var/www/trendimovies/.cache/tmdb';
    const key = cacheKey.replace(/[^a-zA-Z0-9]/g, '_').substring(0, 200);
    const fp = join(dir, `${key}.json`);
    if (!existsSync(fp)) return null;
    const c = JSON.parse(readFileSync(fp, 'utf-8'));
    return Array.isArray(c?.data) ? c.data : null;
  } catch { return null; }
}

async function scrapeMonth(monthNum: string, monthName: string) {
  const cacheKey = `dvdsrd-${YEAR}-${monthNum}`;
  const cached = getCache<any[]>(cacheKey, {});
  if (cached) return cached;
  const url = `${SRC}/digital-releases/${YEAR}/${monthNum}/digital-hd-releases-${monthName}-${YEAR}`;
  let html = '';
  try {
    // 8s hard timeout — one slow month can't hang the whole page into a 504.
    const r = await fetch(url, {
      headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120' },
      signal: AbortSignal.timeout(8000),
    });
    if (r.ok) html = await r.text();
  } catch (e) { html = ''; }

  const marks: { date: string; idx: number }[] = [];
  let m: RegExpExecArray | null;
  DATE_RE.lastIndex = 0;
  while ((m = DATE_RE.exec(html))) marks.push({ date: m[1], idx: m.index });

  const groups: any[] = [];
  for (let i = 0; i < marks.length; i++) {
    const start = marks[i].idx;
    const end = i + 1 < marks.length ? marks[i + 1].idx : html.length;
    const chunk = html.slice(start, end);
    const movies: any[] = [];
    let mm: RegExpExecArray | null;
    MOVIE_RE.lastIndex = 0;
    while ((mm = MOVIE_RE.exec(chunk))) {
      movies.push({
        id: mm[1], slug: mm[2], title: mm[3].replace(/&amp;/g, '&').replace(/&#039;/g, "'").trim(),
        poster: mm[4].startsWith('http') ? mm[4] : SRC + mm[4],
      });
    }
    // Skip date headers that parsed no movies — never render an empty date group.
    if (!movies.length) continue;
    const d = new Date(marks[i].date);
    groups.push({ date: marks[i].date, iso: isNaN(+d) ? null : d.toISOString().slice(0, 10), movies });
  }
  // If the fresh scrape yielded nothing (external site slow/timed-out/blocked),
  // DON'T overwrite the cache with empty and DON'T return empty — serve the last
  // good cache (even if TTL-expired). This is what stops the 504/blank-month.
  if (groups.length === 0) {
    const stale = readStaleCache(cacheKey);
    if (stale && stale.length) return stale;
  }
  setCache(cacheKey, {}, groups);
  return groups;
}

// Scrape all 12 months (cached). Wrapped so one failing month can never reject
// the whole Promise.all and 500/504 the page — a failed month returns [].
const monthData = await Promise.all(
  MONTHS.map(([n, name]) => scrapeMonth(n, name).catch(() => readStaleCache(`dvdsrd-${YEAR}-${n}`) || []))
);

