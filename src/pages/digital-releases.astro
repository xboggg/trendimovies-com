// Merge MANUAL_RELEASES into the scraped monthData. dvdsreleasedates entries win;
// a manual title already present ANYWHERE in that month (normalised) is skipped,
// so the same movie can't appear twice even on a slightly different date.
function _mnorm(s: string) { return (s || '').toLowerCase().replace(/[^a-z0-9]+/g, '').trim(); }
const _MONTH_IDX: Record<string, number> = {
  january:0, february:1, march:2, april:3, may:4, june:5,
  july:6, august:7, september:8, october:9, november:10, december:11,
};
for (const rel of MANUAL_RELEASES) {
  const mm = rel.date.match(/([A-Za-z]+)\s+\d{1,2},\s*\d{4}/);
  if (!mm) continue;
  const monIdx = _MONTH_IDX[mm[1].toLowerCase()];
  if (monIdx === undefined) continue;
  const monthArr = monthData[monIdx];
  if (!monthArr) continue;
  // Skip if this title already exists ANYWHERE in the month (from dvdsreleasedates).
  const wantN = _mnorm(rel.title);
  let dupInMonth = false;
  for (const g of monthArr) { if (g.movies.some((mv: any) => _mnorm(mv.title) === wantN)) { dupInMonth = true; break; } }
  if (dupInMonth) continue;
  // Match the date GROUP by its calendar iso, NOT the raw date string — the
  // dvdsreleasedates scrape stores \"Tuesday July 14, 2026\" (no comma) while
  // MANUAL_RELEASES uses \"Tuesday, July 14, 2026\" (with comma); matching on the
  // string created a DUPLICATE header for the same day. iso is comma-immune.
  const dManual = new Date(rel.date);
  const relIso = isNaN(+dManual) ? null : dManual.toISOString().slice(0, 10);
  let grp = (relIso && monthArr.find((g: any) => g.iso === relIso)) || monthArr.find((g: any) => g.date === rel.date);
  if (!grp) {
    grp = { date: rel.date, iso: relIso, movies: [] };
    monthArr.push(grp);
  }
  grp.movies.push({ id: null, slug: null, title: rel.title, poster: null, _manual: true });
}
// Re-sort each month's groups chronologically (merged dates may be out of order).
for (const monthArr of monthData) {
  if (monthArr) monthArr.sort((a: any, b: any) => {
    const ai = a.iso || '9999-99-99', bi = b.iso || '9999-99-99';
    return ai < bi ? -1 : ai > bi ? 1 : 0;
  });
}

// Apply DATE OVERRIDES *after* merge so stale MANUAL_RELEASES dates (e.g.
// The Furious listed on May 29 by bingebase) are also corrected, then place
// the title on its corrected date.
// ── DATE OVERRIDES — force a title onto a corrected date, removing it from
// any stale dvdsreleasedates group. Use when our PRIMARY source has an
// outdated date: e.g. The Furious + Passenger — dvdsreleasedates/TMDB still
// show the old dates, but both were confirmed for Jul 7 2026 (bingebase +
// whentostream/ResetEra/FILMYNEWS). Keyed by title -> corrected date string.
const MANUAL_OVERRIDE_DATES: { title: string; date: string }[] = [
  { title: 'The Furious', date: 'Tuesday, July 7, 2026' },
  { title: 'Passenger', date: 'Tuesday, July 7, 2026' },
  { title: 'Blue Heron', date: 'Tuesday, July 21, 2026' },
  { title: 'Disclosure Day', date: 'Tuesday, July 21, 2026' },
  { title: 'Leviticus', date: 'Tuesday, July 28, 2026' },
];
for (const ov of MANUAL_OVERRIDE_DATES) {
  const ovN = _mnorm(ov.title);
  for (const monthArr of monthData) {
    if (!monthArr) continue;
    for (const g of monthArr) {
      // strip the title from any group whose date isn't the corrected one
      if (g.date !== ov.date) g.movies = g.movies.filter((mv: any) => _mnorm(mv.title) !== ovN);
    }
  }
}
// After stripping stale copies, ensure each override title sits on its date.
for (const ov of MANUAL_OVERRIDE_DATES) {
  const ovN = _mnorm(ov.title);
  const mm = ov.date.match(/([A-Za-z]+)\s+\d{1,2},\s*\d{4}/);
  if (!mm) continue;
  const monIdx = _MONTH_IDX[mm[1].toLowerCase()];
  const monthArr = monthData[monIdx];
  if (!monthArr) continue;
  const already = monthArr.some((g: any) => g.movies.some((mv: any) => _mnorm(mv.title) === ovN));
  if (already) continue;
  const d = new Date(ov.date);
  const iso = isNaN(+d) ? null : d.toISOString().slice(0, 10);
  let grp = (iso && monthArr.find((g: any) => g.iso === iso)) || monthArr.find((g: any) => g.date === ov.date);
  if (!grp) { grp = { date: ov.date, iso, movies: [] }; monthArr.push(grp); }
  grp.movies.push({ id: null, slug: null, title: ov.title, poster: null, _manual: true });
}

// MANUAL EXCLUDE — remove a title from a specific date group regardless of source
// (manual OR scraped). Use when a title is wrongly listed on a date.
const MANUAL_EXCLUDE: { title: string; date: string }[] = [
  { title: 'The Death of Robin Hood', date: 'Tuesday, July 21, 2026' },
];
for (const ex of MANUAL_EXCLUDE) {
  const exN = _mnorm(ex.title);
  const d = new Date(ex.date);
  const iso = isNaN(+d) ? null : d.toISOString().slice(0, 10);
  for (const monthArr of monthData) {
    if (!monthArr) continue;
    for (const g of monthArr) {
      if (g.date === ex.date || (iso && g.iso === iso)) {
        g.movies = g.movies.filter((mv: any) => _mnorm(mv.title) !== exN);
      }
    }
  }
}
// Re-sort again after relocation.
for (const monthArr of monthData) {
  if (monthArr) monthArr.sort((a: any, b: any) => {
    const ai = a.iso || '9999-99-99', bi = b.iso || '9999-99-99';
    return ai < bi ? -1 : ai > bi ? 1 : 0;
  });
}

// ── TMDB lookup (poster + real TMDB id) ─────────────────────────────────────
// NOTE: the id in dvdsreleasedates' /movies/<id>/ URL is THEIR internal id, NOT
// a TMDB id — so it can't be matched against our catalogue. Instead we resolve
// each title to its real TMDB movie here (also gives us the CSP-allowed poster),
// and match THAT tmdb id against our catalogue. Cached per title+year.
function normTitle(s: string) { return (s || '').toLowerCase().replace(/[^a-z0-9]+/g, '').trim(); }

// Score a TMDB candidate against the wanted title+year. Higher = better.
// Heavily reward an EXACT title match + having a poster; penalise wrong year and
// missing poster so generic one-word titles (e.g. "Heel") don't grab the wrong
// posterless result like "Heel Turn".
function scoreCandidate(c: any, wantTitle: string, wantYear: number): number {
  if (!c) return -Infinity;
  let s = 0;
  const ct = normTitle(c.title);
  const wt = normTitle(wantTitle);
  if (ct === wt) s += 100;                 // exact title match
  else if (ct.startsWith(wt) || wt.startsWith(ct)) s += 35; // prefix-ish
  else if (ct.includes(wt) || wt.includes(ct)) s += 10;     // substring
  else s -= 40;                            // title doesn't really match
  if (c.poster_path) s += 50; else s -= 60; // a posterless hit is almost useless here
  const cy = c.release_date ? Number(String(c.release_date).slice(0, 4)) : null;
  if (cy && wantYear) {
    const d = Math.abs(cy - wantYear);
    if (d === 0) s += 25; else if (d === 1) s += 8; else s -= d * 3;
  }
  s += Math.min((c.popularity || 0) / 20, 10); // mild popularity tiebreak
  return s;
}

async function tmdbLookup(title: string, year: number): Promise<{ poster: string | null; tmdbId: number | null }> {
  const key = `dvdsrd-lk2-${title}-${year}`.toLowerCase();
  const cached = getCache<{ poster: string | null; tmdbId: number | null }>(key, {});
  if (cached) return cached;
  let poster: string | null = null;
  let tmdbId: number | null = null;
  try {
    // Gather candidates from year-scoped AND unscoped searches, then pick the best.
    const candidates: any[] = [];
    const r: any = await fetchFromTMDB('/search/movie', { query: title, year: String(year), include_adult: 'false' });
    candidates.push(...(r.results || []).slice(0, 10));
    const r2: any = await fetchFromTMDB('/search/movie', { query: title, include_adult: 'false' });
    candidates.push(...(r2.results || []).slice(0, 10));

    let best: any = null;
    let bestScore = -Infinity;
    for (const c of candidates) {
      const sc = scoreCandidate(c, title, year);
      if (sc > bestScore) { bestScore = sc; best = c; }
    }
    // Require a minimally plausible match (real title overlap). If the best is junk
    // (e.g. only posterless wrong-title hits), leave nulls → placeholder shows.
    if (best && bestScore > 0) {
      tmdbId = best.id ?? null;
      if (best.poster_path) poster = `https://image.tmdb.org/t/p/w342${best.poster_path}`;
    }
  } catch (e) { /* leave nulls */ }
  const out = { poster, tmdbId };
  setCache(key, {}, out);
  return out;
}

// Enrich every scraped movie with TMDB poster + tmdb id (deduped by title).
const titleYear = new Map<string, number>();
for (const month of monthData) for (const g of month) {
  const yr = g.iso ? Number(g.iso.slice(0, 4)) : YEAR;
  for (const mv of g.movies) if (!titleYear.has(mv.title)) titleYear.set(mv.title, yr);
}
const posterByTitle = new Map<string, string | null>();
const tmdbIdByTitle = new Map<string, number | null>();
const tEntries = [...titleYear.entries()];
const BATCH = 12;
for (let i = 0; i < tEntries.length; i += BATCH) {
  const slice = tEntries.slice(i, i + BATCH);
  const res = await Promise.all(slice.map(([t, y]) => tmdbLookup(t, y)));
  slice.forEach(([t], j) => { posterByTitle.set(t, res[j].poster); tmdbIdByTitle.set(t, res[j].tmdbId); });
}

// Which titles are on TrendiMovies (has downloads)?
// PRIMARY match = TMDB id (exact, immune to casing/punctuation differences like
// "Hungry" vs "HUNGRY"). FALLBACK = normalized title for the rare case where
// dvdsreleasedates' TMDB id differs from ours.
const todayISO = new Date().toISOString().slice(0, 10);
function norm(s: string) { return (s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); }

let siteByTmdb = new Map<string, string>(); // tmdb_id (string) -> slug
let siteByTitle = new Map<string, string>(); // norm(title) -> slug
try {
  // gather all REAL TMDB ids (resolved above) + titles shown across months
  const allIds = new Set<string>();
  const allTitles = new Set<string>();
  for (const month of monthData) for (const g of month) for (const mv of g.movies) {
    const tid = tmdbIdByTitle.get(mv.title);
    if (tid) allIds.add(String(tid));
    if (mv.title) allTitles.add(mv.title);
  }
  // 1) Match by TMDB id (chunked 'in')
  const idsArr = [...allIds];
  for (let i = 0; i < idsArr.length; i += 60) {
    const chunk = idsArr.slice(i, i + 60);
    const inList = chunk.join(',');
    const res = await fetch(`${POSTGREST_URL}/movies?tmdb_id=in.(${encodeURIComponent(inList)})&has_downloads=eq.true&select=tmdb_id,title,slug`);
    if (res.ok) {
      const rows: any[] = await res.json();
      for (const row of rows) if (row.slug) {
        if (row.tmdb_id != null) siteByTmdb.set(String(row.tmdb_id), row.slug);
        if (row.title) siteByTitle.set(norm(row.title), row.slug);
      }
    }
  }
  // 2) Fallback: match by normalized title (case-insensitive via ilike per title
  //    would be many calls; instead pull exact 'in' set and normalize on our side).
  const titlesArr = [...allTitles];
  for (let i = 0; i < titlesArr.length; i += 40) {
    const chunk = titlesArr.slice(i, i + 40);
    const inList = chunk.map((t) => '"' + t.replace(/"/g, '') + '"').join(',');
    const res = await fetch(`${POSTGREST_URL}/movies?title=in.(${encodeURIComponent(inList)})&has_downloads=eq.true&select=title,slug`);
    if (res.ok) {
      const rows: any[] = await res.json();
      for (const row of rows) if (row.slug && row.title) siteByTitle.set(norm(row.title), row.slug);
    }
  }
} catch (e) {}

// Shape per-month: each month = { key, label, hasData, groups:[{date,iso,past,items:[...] }] }
const months = MONTHS.map(([n], idx) => {
  const groups = (monthData[idx] || []).map((g: any) => ({
    date: g.date,
    iso: g.iso,
    past: g.iso ? g.iso < todayISO : false,
    items: g.movies.map((mv: any) => {
      // Use the REAL TMDB id (resolved via TMDB search), not dvdsreleasedates' id.
      const tid = tmdbIdByTitle.get(mv.title) || null;
      // Match against the catalogue. If we resolved a real TMDB id, ONLY trust
      // the exact TMDB-id match — do NOT fall back to title, because two films
      // can share a title (e.g. "Passenger" 2026 tmdb 1368314 is NOT ours, but
      // an old "Passenger" 1963 IS — a title fallback wrongly showed WATCH).
      // The title fallback is allowed ONLY when we have no tid at all.
      const slug = tid ? siteByTmdb.get(String(tid)) : siteByTitle.get(norm(mv.title));
      const on_site = !!slug;
      // The /movie route is keyed by TMDB id (the slug form redirects to /404).
      // Need the real TMDB id to build a working Watch link; without it, don't link.
      const watch_url = on_site && tid ? `/movie/${tid}` : null;
      // TMDB poster (CSP-allowed). Fall back to local placeholder if none.
      const poster = posterByTitle.get(mv.title) || '/images/no-poster.svg';
      return { ...mv, tmdb_id: tid, poster, on_site: !!watch_url, watch_url };
    }),
  }));
  return { key: n, label: MONTH_LABELS[idx], num: idx, count: groups.reduce((a: number, g: any) => a + g.items.length, 0), groups };
});

// Default selected month = current month (if 2026) else the first month with data.
const now = new Date();
let defaultIdx = now.getFullYear() === YEAR ? now.getMonth() : 0;
if (!months[defaultIdx] || months[defaultIdx].count === 0) {
  const firstWith = months.find((mo) => mo.count > 0);
  if (firstWith) defaultIdx = firstWith.num;
}

const totalCount = months.reduce((a, mo) => a + mo.count, 0);
const pageTitle = 'Digital & HD Release Dates 2026 — TrendiMovies';
const pageDesc = 'Ever wonder when your favourite movies finally drop in HD? Pick any month and see the exact digital/HD release dates for every upcoming movie — so you know precisely when the download will be available on TrendiMovies.';

// Dynamic OG image: a poster collage of the SOONEST upcoming releases, generated
// by /api/og.png (satori). Auto-stays-current since it's built from live data.
// Gather 5 distinct TMDB poster PATHS (strip the image.tmdb.org/.../w342 prefix).
const _ogPosters: string[] = [];
const _ogSeen = new Set<string>();
outer:
for (const mo of months) {
  for (const g of mo.groups) {
    if (g.past) continue;                       // upcoming only
    for (const it of g.items) {
      const pp = (it as any).poster as string;
      if (!pp || !pp.includes('image.tmdb.org')) continue; // need a real TMDB poster
      const path = pp.replace(/^https?:\/\/image\.tmdb\.org\/t\/p\/[^/]+/, '');
      if (_ogSeen.has(path)) continue;
      _ogSeen.add(path); _ogPosters.push(path);
      if (_ogPosters.length >= 5) break outer;
    }
  }
}
const ogImage = _ogPosters.length
  ? `/api/og.png?type=digital&posters=${encodeURIComponent(_ogPosters.join('|'))}`
  : '/api/og.png?type=digital';
---

<BaseLayout title={pageTitle} description={pageDesc} image={ogImage}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b" style="border-color: var(--border);">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 25% 0%, rgba(247,208,0,0.10), transparent 55%), radial-gradient(ellipse at 85% 100%, rgba(220,38,38,0.10), transparent 55%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-4 text-xs font-bold uppercase tracking-widest"
           style="background: rgba(247,208,0,0.12); color:#f7d000; border:1px solid rgba(247,208,0,0.3);">📀 Home Release Calendar</div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight">Digital &amp; HD Release Dates <span style="color:#f7d000;">2026</span></h1>
      <p class="mt-3 max-w-2xl text-sm sm:text-base" style="color: var(--text-secondary);">
        Exactly when every movie hits Digital &amp; HD — month by month. Pick a month below. Titles already on TrendiMovies show a ▶ Watch button.
      </p>
    </div>
  </section>

  <!-- Month selector -->
  <section class="sticky top-16 z-30 border-b backdrop-blur" style="border-color: var(--border); background: rgba(10,10,12,0.85);">
    <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 py-3">
      <div class="flex gap-1.5 overflow-x-auto hide-scrollbar" id="monthTabs">
        {months.map((mo) => (
          <button class="month-tab flex-shrink-0 px-3.5 py-1.5 rounded-lg text-sm font-bold transition-all"
                  data-month={mo.num} data-count={mo.count}
                  style="background: rgba(255,255,255,0.05); color: var(--text-secondary);">
            {mo.label} {mo.count > 0 && (<span class="opacity-60 text-xs">· {mo.count}</span>)}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Month panels (all rendered; JS shows the selected one) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {totalCount === 0 && (
      <p style="color:var(--text-secondary);">Couldn't load the release calendar right now — please try again shortly.</p>
    )}
    {months.map((mo) => (
      <div class="month-panel" data-month={mo.num} style="display:none;">
        {mo.groups.length === 0 ? (
          <p class="py-8" style="color:var(--text-secondary);">No digital releases listed for {mo.label} {YEAR} yet.</p>
        ) : (
          <div class="space-y-10">
            {mo.groups.map((g) => (
              <div>
                <div class="flex items-center gap-3 mb-4 flex-wrap">
                  <span class="w-1.5 h-6 rounded-full" style={g.past ? 'background:#3fb950;' : 'background:#f7d000;'}></span>
                  <h2 class="text-lg sm:text-xl font-black text-white">{g.date}</h2>
                  {g.past
                    ? <span class="text-[11px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(63,185,80,0.15);color:#3fb950;">released</span>
                    : <span class="countdown text-[11px] font-bold px-2 py-0.5 rounded-full" data-date={g.iso} style="background:rgba(247,208,0,0.12);color:#f7d000;border:1px solid rgba(247,208,0,0.3);">…</span>}
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                  {g.items.map((mv) => (
                    <a href={mv.on_site ? mv.watch_url : `/request?title=${encodeURIComponent(mv.title)}`} class="group block">
                      <div class="relative rounded-xl overflow-hidden aspect-[2/3] ring-1 ring-white/10 group-hover:ring-amber-400/50 transition-all bg-black/40">
                        <img src={mv.poster} alt={mv.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='/images/no-poster.svg'" />
                        <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-[10px] font-bold"
                             style={mv.on_site ? 'background:#16a34a;color:#fff;' : 'background:rgba(0,0,0,0.72);color:#f7d000;border:1px solid rgba(247,208,0,0.4);'}>
                          {mv.on_site ? '▶ WATCH' : (g.past ? 'REQUEST' : '🔔 NOTIFY')}
                        </div>
                      </div>
                      <p class="mt-2 text-sm font-medium text-white line-clamp-1 group-hover:text-amber-300 transition-colors">{mv.title}</p>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <script is:inline define:vars={{ defaultIdx }}>
    (function () {
      function showMonth(idx) {
        document.querySelectorAll('.month-panel').forEach(function (p) {
          p.style.display = (p.getAttribute('data-month') === String(idx)) ? 'block' : 'none';
        });
        document.querySelectorAll('.month-tab').forEach(function (t) {
          var on = t.getAttribute('data-month') === String(idx);
          t.style.background = on ? 'linear-gradient(135deg,#f7d000,#f59e0b)' : 'rgba(255,255,255,0.05)';
          t.style.color = on ? '#000' : 'var(--text-secondary)';
        });
      }
      document.querySelectorAll('.month-tab').forEach(function (t) {
        t.addEventListener('click', function () { showMonth(t.getAttribute('data-month')); });
      });
      showMonth(defaultIdx);

      function ticks() {
        var now = new Date();
        document.querySelectorAll('.countdown').forEach(function (el) {
          var iso = el.getAttribute('data-date'); if (!iso) { el.textContent = 'soon'; return; }
          var diff = new Date(iso + 'T00:00:00') - now;
          if (diff <= 0) { el.textContent = 'today'; return; }
          var d = Math.floor(diff / 86400000), h = Math.floor((diff % 86400000) / 3600000);
          el.textContent = d > 0 ? ('⏳ ' + d + 'd') : ('⏳ ' + h + 'h');
        });
      }
      ticks(); setInterval(ticks, 60000);
    })();
  </script>
</BaseLayout>
